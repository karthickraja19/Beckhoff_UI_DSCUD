<Window x:Class="Nova.Hive.HiveStateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dialog"
        Width="300"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        FontSize="14"
        Background="Transparent">

    <!-- Audio SW DFM v5.4, slide 49 "Manually Changing HIVE State": the four state
         options the HIVE chip offers a level 2/3 operator. -->
    <Window.Resources>
        <Style x:Key="StateButton" TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#20201F" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="#2B2B2B"
                                BorderThickness="1" CornerRadius="5" Padding="10,9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#B0B0B0" BorderThickness="1" CornerRadius="6">
        <StackPanel>
            <Border Background="#ECECEC" CornerRadius="6,6,0,0" Padding="10,8">
                <TextBlock Text="Dialog" FontWeight="Bold" Foreground="#3C3C3C" HorizontalAlignment="Center" />
            </Border>

            <Border Background="#E4E4E4" CornerRadius="0,0,6,6" Padding="26,20,26,8">
                <StackPanel>
                    <Button Content="Running" Style="{StaticResource StateButton}" Click="Running_Click" />
                    <Button Content="Idle" Style="{StaticResource StateButton}" Click="Idle_Click" />
                    <Button Content="Planned downtime" Style="{StaticResource StateButton}" Click="PlannedDowntime_Click" />
                    <Button Content="Manual downtime" Style="{StaticResource StateButton}" Click="ManualDowntime_Click" />

                    <Button Content="Cancel" HorizontalAlignment="Center" Margin="0,4,0,8"
                            Padding="18,5" Click="Cancel_Click" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
