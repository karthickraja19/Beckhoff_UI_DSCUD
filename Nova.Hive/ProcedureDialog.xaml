<Window x:Class="Nova.Hive.ProcedureDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dialog"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        FontSize="14"
        Background="Transparent">

    <!-- The pop-up of a planned-downtime procedure that records a physical SN (Audio SW
         DFM v5.4 slides 37, 66 and 71; S3.1 PD-04, S3.3 PD-12): the operator swipes a
         badge, old SNs show as recorded, new SNs come from the scanner only. -->
    <Border BorderBrush="#B0B0B0" BorderThickness="1" CornerRadius="6">
        <StackPanel>
            <Border Background="#ECECEC" CornerRadius="6,6,0,0" Padding="10,8">
                <TextBlock x:Name="TitleText" Text="Dialog" FontWeight="Bold" Foreground="#3C3C3C" HorizontalAlignment="Center" />
            </Border>

            <Border Background="#F4F4F4" CornerRadius="0,0,6,6" Padding="20,14">
                <StackPanel>
                    <TextBlock x:Name="HeaderText" Foreground="#E0342B" FontWeight="Bold" Margin="0,0,0,12" TextWrapping="Wrap" />

                    <!-- Gantry, operator and the SN rows are added by the code-behind. -->
                    <Grid x:Name="Body" />

                    <TextBlock x:Name="InfoText" Margin="0,8,0,0" Foreground="#3C3C3C" TextWrapping="Wrap" Visibility="Collapsed" />
                    <TextBlock x:Name="MessageText" Margin="0,10,0,0" Foreground="#8A8A8A" TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button x:Name="CancelButton" Content="Cancel" MinWidth="92" Padding="14,6"
                                Margin="0,0,10,0" Click="CancelButton_Click" />
                        <Button x:Name="CheckButton" MinWidth="120" Padding="14,6" Margin="0,0,10,0"
                                Visibility="Collapsed" Click="CheckButton_Click" />
                        <Button x:Name="OkButton" Content="OK" MinWidth="92" Padding="14,6"
                                IsEnabled="False" Click="OkButton_Click"
                                Background="#1E7BF0" Foreground="White" BorderBrush="#1968CC" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
