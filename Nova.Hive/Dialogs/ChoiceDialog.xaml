<Window x:Class="Nova.Hive.ChoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:loc="clr-namespace:Nova.Wpf.UI.Localization;assembly=Nova.Wpf.UI"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{loc:Tr Txt_Dialog}"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        FontSize="14"
        Background="Transparent">

    <!-- A choice from a closed list (slides 68-74: CPK / GRR / SCS, the repeatability
         types of PD-13). Nothing is typed. -->
    <Border BorderBrush="#B0B0B0" BorderThickness="1" CornerRadius="6">
        <StackPanel>
            <Border Background="#ECECEC" CornerRadius="6,6,0,0" Padding="10,8">
                <TextBlock Text="{loc:Tr Txt_Dialog}" FontWeight="Bold" Foreground="#3C3C3C" HorizontalAlignment="Center" />
            </Border>

            <Border Background="#F4F4F4" CornerRadius="0,0,6,6" Padding="20,14">
                <StackPanel>
                    <TextBlock x:Name="HeaderText" Foreground="#E0342B" FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap" />
                    <TextBlock x:Name="MessageText" Margin="0,0,0,10" TextWrapping="Wrap" />
                    <StackPanel x:Name="Options" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button Content="{loc:Tr Txt_Cancel}" MinWidth="92" Padding="14,6" Margin="0,0,10,0" Click="CancelButton_Click" />
                        <Button x:Name="OkButton" Content="{loc:Tr Txt_OK}" MinWidth="92" Padding="14,6" IsEnabled="False"
                                Click="OkButton_Click" Background="#1E7BF0" Foreground="White" BorderBrush="#1968CC" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
