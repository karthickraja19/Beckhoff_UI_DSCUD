<Window x:Class="Nova.Hive.PlannedDowntimeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:loc="clr-namespace:Nova.Wpf.UI.Localization;assembly=Nova.Wpf.UI"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{loc:Tr Txt_Dialog}"
        Width="380"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        FontSize="14"
        Background="Transparent">

    <!-- Audio SW DFM v5.4, slide 49: "Clicking planned downtime opens pop up with
         planned downtime code options". The codes are chosen from this list only -
         "Manually typing in state or error code prohibited". -->
    <Border BorderBrush="#B0B0B0" BorderThickness="1" CornerRadius="6">
        <StackPanel>
            <Border Background="#ECECEC" CornerRadius="6,6,0,0" Padding="10,8">
                <TextBlock Text="{loc:Tr Txt_Dialog}" FontWeight="Bold" Foreground="#3C3C3C" HorizontalAlignment="Center" />
            </Border>

            <Border Background="#F4F4F4" CornerRadius="0,0,6,6" Padding="20,16">
                <StackPanel>
                    <ItemsControl x:Name="ReasonList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,9">
                                    <RadioButton x:Name="ReasonButton" GroupName="PlannedDowntime"
                                                 Content="{loc:TrBinding Label}"
                                                 Tag="{Binding}"
                                                 IsEnabled="{Binding IsEnabled}"
                                                 FontWeight="Bold"
                                                 Checked="Reason_Checked" />
                                    <!-- Why a greyed-out reason cannot be chosen now. A tooltip
                                         would not show on the touch screen. -->
                                    <TextBlock x:Name="BlockedNote" Text="{loc:TrBinding BlockedBecause}"
                                               FontSize="11" Foreground="#8A8A8A" TextWrapping="Wrap"
                                               Margin="20,1,0,0" Visibility="Collapsed" />
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                        <Setter TargetName="BlockedNote" Property="Visibility" Value="Visible" />
                                        <!-- Greyed out as slide 49 draws PD-14 and PD-15. -->
                                        <Setter TargetName="ReasonButton" Property="Foreground" Value="#A0A0A0" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Slide 31: Offline Processing "Must enter DOE details" and Other
                         "Specify action details". Details only; the code itself is never typed. -->
                    <StackPanel x:Name="DetailsPanel" Visibility="Collapsed" Margin="0,4,0,0">
                        <TextBlock x:Name="DetailsLabel" FontWeight="Bold" Margin="0,0,0,4" TextWrapping="Wrap" />
                        <TextBox x:Name="DetailsBox" MinHeight="54" Padding="6,4" MaxLength="200"
                                 TextWrapping="Wrap" AcceptsReturn="False"
                                 TextChanged="DetailsBox_TextChanged" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="{loc:Tr Txt_Cancel}" MinWidth="92" Padding="14,6" Margin="0,0,10,0"
                                Click="CancelButton_Click" />
                        <Button x:Name="OkButton" Content="{loc:Tr Txt_OK}" MinWidth="92" Padding="14,6"
                                IsEnabled="False" Click="OkButton_Click"
                                Background="#1E7BF0" Foreground="White" BorderBrush="#1968CC" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
