<Project Sdk="Microsoft.NET.Sdk">
  <!-- SQL Server / CSV data access for TEAL_Master (IDataAccess), and the Nova.Abstractions
       repository contracts implemented over it. .NET Standard 2.0: it is used from the
       .NET Framework app and from Nova.Alarm. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>Master.Repository</AssemblyName>
    <RootNamespace>Master.Repository</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Data.SqlClient" Version="4.8.6" />
    <PackageReference Include="System.Runtime.Caching" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Nova.Abstractions\Nova.Abstractions.csproj" />
  </ItemGroup>
</Project>
