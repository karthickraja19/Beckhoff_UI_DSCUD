<Window x:Class="Nova.Wpf.App.Views.Dialogs.GlueAlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:loc="clr-namespace:Nova.Wpf.UI.Localization;assembly=Nova.Wpf.UI"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{loc:Tr Txt_GlueAlert}"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        FontSize="14"
        Background="Transparent">

    <!-- S2.4.4.4 Glue Control & Early Warning: the low-glue, empty-glue, pot-life and
         nozzle-health pop-ups. "Mute Option: Enabled"; "Closing alert pop-up requires login
         by Level 2 or Level 3 authorized users". -->
    <Border BorderBrush="#B0B0B0" BorderThickness="1" CornerRadius="6">
        <StackPanel>
            <Border x:Name="HeaderBand" Background="#F3C969" CornerRadius="6,6,0,0" Padding="12,10">
                <TextBlock x:Name="TitleText" FontWeight="Bold" FontSize="16" Foreground="#3C3C3C" HorizontalAlignment="Center" />
            </Border>

            <Border Background="#F4F4F4" CornerRadius="0,0,6,6" Padding="20,16">
                <StackPanel>
                    <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,0,0,10" />
                    <TextBlock x:Name="DetailText" TextWrapping="Wrap" Foreground="#6A6A6A" FontSize="12" />
                    <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="#8A8A8A" FontSize="12" Margin="0,10,0,0" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button x:Name="MuteButton" Content="{loc:Tr Txt_Mute}" MinWidth="92" Padding="14,6" Margin="0,0,10,0" Click="MuteButton_Click" />
                        <Button Content="{loc:Tr Txt_Close}" MinWidth="92" Padding="14,6" Click="CloseButton_Click"
                                Background="#1E7BF0" Foreground="White" BorderBrush="#1968CC"
                                ToolTip="{loc:Tr Txt_NeedsALevel2OrLevel3}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
