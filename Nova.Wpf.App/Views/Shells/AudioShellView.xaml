<UserControl x:Class="Nova.Wpf.App.Views.Shells.AudioShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:Nova.Wpf.UI.Components;assembly=Nova.Wpf.UI"
             xmlns:converters="clr-namespace:Nova.Wpf.App.Converters"
             Background="{DynamicResource Audio.Surface.GroupedBrush}"
             FontFamily="{DynamicResource Audio.FontFamily}">

    <!-- ================================================================== -->
    <!-- INDICATOR BAR + PAGE HOST -->
    <!-- Audio SW DFM v5.4 slide 42, "Indicator Bar Formatting and Alignment": -->
    <!--   . Fixed gap between each button, each button is the same size -->
    <!--   . Menu buttons aligned left, status buttons aligned right -->
    <!--   . Station ID centered -->
    <!--   . Downtime state turns indicator bar background red -->
    <!-- Sizes and the gap come from Audio.IndicatorButton.* in AudioTokens -->
    <!-- the slide dimensions the gap as 20% of the button width, so the two -->
    <!-- are declared together there and never spelled out here. -->
    <!-- ================================================================== -->

    <UserControl.Resources>
        <converters:SkuToBrushConverter x:Key="SkuToBrush"/>
        <converters:SkuToLabelConverter x:Key="SkuToLabel"/>
        <converters:AudioBoolToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 0  indicator bar -->
            <RowDefinition Height="*"/>      <!-- 1  page -->
        </Grid.RowDefinitions>

        <!-- ============================================================== -->
        <!-- INDICATOR BAR -->
        <!-- ============================================================== -->
        <Border Grid.Row="0"
                MinHeight="{DynamicResource Audio.IndicatorBar.Height}"
                Padding="{DynamicResource Audio.IndicatorBar.Padding}"
                BorderBrush="{DynamicResource Audio.SeparatorBrush}"
                BorderThickness="0,0,0,1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource Audio.Surface.ChromeBrush}"/>
                    <Style.Triggers>
                        <!-- Slide 42: the whole bar goes red in downtime. Held at the
                             full normative #EB7373 - this is the one signal on screen
                             that has to carry across the line, so it is not softened. -->
                        <DataTrigger Binding="{Binding IsDowntime}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Audio.IndicatorBar.DowntimeBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>  <!-- 0  menu buttons, aligned left -->
                    <ColumnDefinition Width="*"/>     <!-- 1  station ID, centred -->
                    <ColumnDefinition Width="Auto"/>  <!-- 2  status, aligned right -->
                </Grid.ColumnDefinitions>

                <!-- Menu buttons -->
                <ItemsControl Grid.Column="0"
                              ItemsSource="{Binding NavItems}"
                              VerticalAlignment="Center"
                              KeyboardNavigation.TabNavigation="Continue">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource Audio.IndicatorButton}"
                                    Command="{Binding DataContext.NavigateCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding Key}"
                                    IsEnabled="{Binding IsPermitted}"
                                    ToolTip="{Binding Label}"
                                    AutomationProperties.Name="{Binding Label}">
                                <components:AudioIcon Glyph="{Binding Glyph}" State="{Binding IconState}"/>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Station ID -->
                <!-- Two presentations, one visible at a time. A product with a
                     SKU gets the coloured plate carrying the SKU name; a common
                     product gets the #CCCCCC watermark of the station ID
                     (slides 40 and 42). -->
                <Grid Grid.Column="1" Margin="16,0">
                    <Border Style="{StaticResource Audio.StationIdPlate}"
                            Background="{Binding Sku, Converter={StaticResource SkuToBrush}}"
                            Visibility="{Binding HasSku, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="{Binding StationId}">
                        <TextBlock Style="{StaticResource Audio.Title1}"
                                   Text="{Binding Sku, Converter={StaticResource SkuToLabel}}"
                                   Foreground="{DynamicResource Audio.Sku.ForegroundBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Style="{StaticResource Audio.StationIdPlaceholder}"
                               Text="{Binding StationId}"
                               Visibility="{Binding HasSku, Converter={StaticResource BoolToVisibility},
                                                    ConverterParameter=invert}"/>
                </Grid>

                <!-- Machine controls, chips, wordmark -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                    <Rectangle Style="{StaticResource Audio.Separator.Vertical}" Margin="4,6"/>

                    <!-- Slide 39 puts all three at "No login: Enabled / L1, 2, 3:
                         Enabled", so access level does not gate them - only the
                         machine's own state does, through CanExecute. -->
                    <Button Style="{StaticResource Audio.IndicatorButton}"
                            Command="{Binding StartMachineCommand}"
                            ToolTip="Start / resume the machine"
                            AutomationProperties.Name="Start machine">
                        <components:AudioIcon Glyph="Running" State="{Binding RunningIconState}"/>
                    </Button>

                    <Button Style="{StaticResource Audio.IndicatorButton}"
                            Command="{Binding PauseMachineCommand}"
                            ToolTip="Pause the machine"
                            AutomationProperties.Name="Pause machine">
                        <components:AudioIcon Glyph="Paused" State="{Binding PausedIconState}"/>
                    </Button>

                    <Button Style="{StaticResource Audio.IndicatorButton}"
                            Command="{Binding StopMachineCommand}"
                            ToolTip="Stop the machine"
                            AutomationProperties.Name="Stop machine">
                        <components:AudioIcon Glyph="Stopped" State="{Binding StoppedIconState}"/>
                    </Button>

                    <Rectangle Style="{StaticResource Audio.Separator.Vertical}" Margin="4,6"/>

                    <!-- Level chip over HIVE chip, as one 56px column matching the
                         button height beside it (slide 42). -->
                    <StackPanel VerticalAlignment="Center" Margin="4,0">
                        <!-- Click: sign in / switch user (slide 44). Right-click: log
                             out after a confirmation (slide 85). -->
                        <Button Style="{StaticResource Audio.StatusChipButton}"
                                Command="{Binding ChangeUserCommand}"
                                ToolTip="{Binding AccessLevelTooltip}"
                                AutomationProperties.Name="Access level">
                            <Button.InputBindings>
                                <MouseBinding MouseAction="RightClick" Command="{Binding LogOutCommand}"/>
                            </Button.InputBindings>
                            <components:AudioIcon Style="{StaticResource Audio.StatusChip}"
                                                  Asset="{Binding AccessLevelAsset}"/>
                        </Button>

                        <!-- Read-only at no-login and Level 1, pressable at Level 2/3
                             (slides 42 and 49). IsHitTestVisible, not IsEnabled: a
                             disabled button would fade the chip, and the chip has to
                             stay fully legible because it is also the state readout. -->
                        <Button Style="{StaticResource Audio.StatusChipButton}"
                                Command="{Binding ChangeHiveStateCommand}"
                                IsHitTestVisible="{Binding CanChangeHiveState}"
                                Focusable="{Binding CanChangeHiveState}"
                                ToolTip="HIVE machine state"
                                AutomationProperties.Name="HIVE state">
                            <components:AudioIcon Style="{StaticResource Audio.StatusChip}"
                                                  Asset="{Binding HiveStateAsset}"/>
                        </Button>
                    </StackPanel>

                    <components:AudioIcon Asset="Audio_Logo"
                                          Height="{DynamicResource Audio.Logo.Height}"
                                          Width="32"
                                          Margin="8,0,4,0"
                                          VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================== -->
        <!-- PAGE HOST -->
        <!-- ============================================================== -->
        <ContentControl Grid.Row="1"
                        Content="{Binding CurrentPage}"
                        Focusable="False"
                        Margin="{DynamicResource Audio.Margin.Content}"/>
    </Grid>
</UserControl>
