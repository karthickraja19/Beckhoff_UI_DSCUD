<UserControl x:Class="Nova.Wpf.App.Views.Shells.AppTitleBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:uiRes="clr-namespace:Nova.Wpf.UI.Resources;assembly=Nova.Wpf.UI">
    <!-- Removed bottom border here; we will put it in MainWindow so it spans the entire width -->
    <Border Padding="14,0" Height="30">
        <Grid>
            <!-- Brand: TEAL vector wordmark -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <uiRes:Logo Height="16" VerticalAlignment="Center"/>
                <!-- From Data\config.txt (SWVersion / MCVersion) via IMachineIdentityService.
                     This was a hardcoded "Version 5.4" that no build ever updated. -->
                <TextBlock Text="{Binding Version, TargetNullValue='Version —'}" Margin="12,0,0,0" VerticalAlignment="Center"
                           FontSize="{DynamicResource Nova.FontSize.Body}" Foreground="{DynamicResource PrimaryTextBrush}"/>
            </StackPanel>

            <!-- Machine name — centered in the middle of the bar -->
            <TextBlock Text="{Binding MachineName, TargetNullValue='M-Name -1.0'}" FontWeight="Bold" FontSize="{DynamicResource Nova.FontSize.Heading}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}"/>

            <!-- Right section (Time + Help) -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <!-- Date/Time placed just before the Help icon -->
                <TextBlock Text="{Binding SystemTime, TargetNullValue='18 Jun 2026 / 13:35:58'}" FontSize="{DynamicResource Nova.FontSize.Body}"
                           VerticalAlignment="Center" Margin="0,0,16,0" Foreground="{DynamicResource SecondaryTextBrush}"/>

                <!-- Using a clean circular icon button for Help -->
                <Button Content="?"
                        Style="{StaticResource ButtonIcon}"
                        Command="{Binding ShowHelpCommand}"
                        Foreground="{DynamicResource PrimaryBrush}"
                        FontSize="{DynamicResource Nova.FontSize.Body}" FontWeight="Bold"
                        Width="22" Height="22"
                        Margin="0"
                        Cursor="Hand"
                        ToolTip="Help"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
