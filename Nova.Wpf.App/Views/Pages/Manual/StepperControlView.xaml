<UserControl x:Class="Nova.Wpf.App.Views.Pages.Manual.StepperControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:loc="clr-namespace:Nova.Wpf.UI.Localization;assembly=Nova.Wpf.UI"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:ui="clr-namespace:Nova.Wpf.UI.Components;assembly=Nova.Wpf.UI"
             xmlns:behaviors="clr-namespace:Nova.Wpf.UI.Behaviors;assembly=Nova.Wpf.UI"
             Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="ManualCard" TargetType="Border" BasedOn="{StaticResource Nova.Card}">
            <Setter Property="Margin" Value="{DynamicResource Nova.Card.Gap}"/>
        </Style>

        <Style x:Key="CardHeaderText" TargetType="TextBlock" BasedOn="{StaticResource Nova.SectionTitle}"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Nova.FieldLabel}">
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>

        <Style x:Key="UnitText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource Nova.FontSize.Body}"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <!-- Conveyor speed is a number the view model parses; letters here used to fall
             through TryParse as 0 and silently become "use the default speed". -->
        <Style x:Key="InputField" TargetType="TextBox">
            <Setter Property="Height" Value="{DynamicResource Nova.Field.Height}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0,42,0"/>
            <Setter Property="behaviors:NumericInput.Mode" Value="Decimal"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource Nova.ButtonPrimary}"/>

        <Style x:Key="InfoButton" TargetType="Button" BasedOn="{StaticResource Nova.ButtonInfo}"/>

        <Style x:Key="StopButton" TargetType="Button" BasedOn="{StaticResource Nova.ButtonDanger}"/>
    </UserControl.Resources>

    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Stepper selector -->
            <RowDefinition Height="*"/>
            <!-- Cards -->
        </Grid.RowDefinitions>

        <!-- ============ Stepper Selector ============ -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="6,4,0,6">
            <TextBlock Text="{loc:Tr Txt_Stepper}" VerticalAlignment="Center" FontWeight="SemiBold"
                       FontSize="{DynamicResource Nova.FontSize.Body}" Margin="0,0,10,0" Foreground="{DynamicResource PrimaryTextBrush}"/>
            <ComboBox Width="240" Height="{DynamicResource Nova.Field.Height}" VerticalContentAlignment="Center"
                      ItemsSource="{Binding Motors}"
                      SelectedItem="{Binding SelectedMotor, Mode=TwoWay}"/>
        </StackPanel>

        <!-- ============ Cards Row ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Two cards since Live Values was removed; the freed column would
                     otherwise leave a gap on the right of the screen. -->
                <ColumnDefinition Width="1.6*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Conveyor Motion -->
            <Border Grid.Column="0" Style="{StaticResource ManualCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <iconPacks:PackIconLucide Kind="ArrowLeftRight" Width="16" Height="16" VerticalAlignment="Center"
                                                  Margin="0,0,8,0" Foreground="{DynamicResource PrimaryBrush}"/>
                        <TextBlock Text="{loc:Tr Txt_MotionControl}" Style="{StaticResource CardHeaderText}"/>
                    </StackPanel>

                    <!-- Manual jog velocity, % of the EL7047's speed range: the PLC's
                         stepperdata[n].par.fMvelocity. Filled from the PLC when the motor is
                         shown and written to it on Forward / Reverse (a running stepper takes a
                         new value on the next press). Blank keeps the PLC's velocity. -->
                    <TextBlock Text="{loc:Tr Txt_Velocity}" Style="{StaticResource FieldLabel}"/>
                    <Grid Width="240" HorizontalAlignment="Left">
                        <TextBox Style="{StaticResource InputField}"
                                 Text="{Binding Speed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{Binding MaxSpeed, StringFormat='0 - {0} % of the drive speed range'}"/>
                        <TextBlock Text="%" Style="{StaticResource UnitText}"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                        <Button Style="{StaticResource InfoButton}" Command="{Binding ReverseCommand}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="ChevronLeft" Width="16" Height="16" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Tr Txt_Reverse}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource StopButton}" Command="{Binding StopCommand}" Margin="12,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="Square" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Tr Txt_Stop}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ActionButton}" Command="{Binding ForwardCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{loc:Tr Txt_Forward}" VerticalAlignment="Center"/>
                                <iconPacks:PackIconLucide Kind="ChevronRight" Width="16" Height="16" Margin="4,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Device Status -->
            <Border Grid.Column="1" Style="{StaticResource ManualCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <iconPacks:PackIconLucide Kind="Activity" Width="16" Height="16" VerticalAlignment="Center"
                                                  Margin="0,0,8,0" Foreground="{DynamicResource PrimaryBrush}"/>
                        <TextBlock Text="{loc:Tr Txt_DeviceStatus}" Style="{StaticResource CardHeaderText}"/>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding DeviceStatus}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{loc:TrBinding Label}" FontSize="{DynamicResource Nova.FontSize.Body}" VerticalAlignment="Center"
                                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    <ui:StatusIndicator Grid.Column="1" IsActive="{Binding IsActive}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Live Values -->
            <Border Grid.Column="2" Style="{StaticResource ManualCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <iconPacks:PackIconLucide Kind="CircleDot" Width="16" Height="16" VerticalAlignment="Center"
                                                  Margin="0,0,8,0" Foreground="{DynamicResource PrimaryBrush}"/>
                        <TextBlock Text="{loc:Tr Txt_LiveValues}" Style="{StaticResource CardHeaderText}"/>
                    </StackPanel>

                    <TextBlock Text="{loc:Tr Txt_ConveyorStatus}" Style="{StaticResource FieldLabel}" Margin="0,16,0,4"/>
                    <TextBlock Text="{loc:TrBinding StatusText}" FontSize="{DynamicResource Nova.FontSize.Body}" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryBrush}"/>

                    <!-- Actual Speed readout removed by request: an IO stepper has no
                         velocity feedback, so the figure was only ever the commanded
                         value echoed back. -->

                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>