<UserControl x:Class="Nova.Wpf.App.Views.Pages.Manual.PlcDevicePanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="Transparent">

    <!-- One layout for every third-party device the PLC drives (dispenser, weighing scale,
         vibration sensor). The view model says which lamps, values, settings and buttons the
         device has; a part with nothing in it is not shown. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource RegionBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="{DynamicResource Nova.Card.Padding}"/>
            <Setter Property="Effect" Value="{StaticResource EffectShadow1}"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource Nova.SectionTitle}">
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource Nova.FieldLabel}">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource Nova.FontSize.Body}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- A card shown only when its collection has something in it. -->
        <Style x:Key="CardIfAny" TargetType="Border" BasedOn="{StaticResource Card}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag.Count, RelativeSource={RelativeSource Self}}" Value="0">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16,12">

            <!-- ============ Device selector and link ============ -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding SelectorCaption}" Style="{StaticResource Caption}" Margin="2,0,0,6"/>
                    <Border CornerRadius="8" Height="{DynamicResource Nova.Field.Height}" Width="360"
                            Background="{DynamicResource RegionBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <ComboBox VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent" Margin="8,0"
                                  ItemsSource="{Binding Devices}" SelectedIndex="{Binding SelectedDeviceIndex, Mode=TwoWay}"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource DangerBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding LinkText}" Style="{StaticResource ValueText}"/>
                </StackPanel>
            </Grid>

            <!-- ============ Notices ============ -->
            <Border Style="{StaticResource Card}" Background="{DynamicResource WarningBrush}"
                    Visibility="{Binding IsAutoMode, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconLucide Kind="Lock" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding AutoModeText}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="2"
                    Visibility="{Binding HasAlarm, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconLucide Kind="TriangleAlert" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,10,0"
                                              Foreground="{DynamicResource DangerBrush}"/>
                    <TextBlock Text="{Binding AlarmText}" TextWrapping="Wrap" VerticalAlignment="Center"
                               FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}"/>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding UnavailableText}" TextWrapping="Wrap" Margin="2,0,0,16">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource ValueText}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- ============ Two columns: operate on the left, values on the right ============ -->
            <Grid Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">

                    <!-- Status lamps -->
                    <Border Style="{StaticResource CardIfAny}" Tag="{Binding Indicators}">
                        <StackPanel>
                            <TextBlock Text="Status" Style="{StaticResource CardTitle}"/>
                            <ItemsControl ItemsSource="{Binding Indicators}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Chip" CornerRadius="12" Padding="10,4" Margin="0,0,8,8"
                                                BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse x:Name="Lamp" Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,6,0"
                                                         Fill="{DynamicResource BorderBrush}"/>
                                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsKnown}" Value="False">
                                                <Setter TargetName="Chip" Property="Opacity" Value="0.5"/>
                                                <Setter TargetName="Chip" Property="ToolTip" Value="No value from the PLC"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsGood}" Value="True">
                                                <Setter TargetName="Lamp" Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsBad}" Value="True">
                                                <Setter TargetName="Lamp" Property="Fill" Value="{DynamicResource DangerBrush}"/>
                                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Switches and buttons -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Control" Style="{StaticResource CardTitle}"/>

                            <ItemsControl ItemsSource="{Binding Switches}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource ValueText}"/>
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,12,0"/>
                                            </StackPanel>
                                            <!-- The switch shows what the PLC reports; a click asks for the other state. -->
                                            <ToggleButton Grid.Column="1" Style="{StaticResource ToggleButtonSwitch}" VerticalAlignment="Center"
                                                          IsChecked="{Binding IsOn, Mode=OneWay}"
                                                          Command="{Binding ToggleCommand}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding Commands}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button x:Name="Btn" Command="{Binding Command}" MinWidth="130" Margin="0,0,10,10"
                                                Style="{StaticResource Nova.ButtonOutline}">
                                            <StackPanel Orientation="Horizontal">
                                                <iconPacks:PackIconLucide Kind="{Binding Icon}" Width="15" Height="15" Margin="0,0,8,0"
                                                                          VerticalAlignment="Center"
                                                                          Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                                                <Setter TargetName="Btn" Property="Style" Value="{StaticResource Nova.ButtonPrimary}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{Binding ActionText}" TextWrapping="Wrap" Margin="0,4,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActionFailed}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Settings -->
                    <ItemsControl ItemsSource="{Binding SettingGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}"/>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="1.4*"/>
                                                <ColumnDefinition Width="1.2*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="1" Text="New value" Style="{StaticResource Caption}" Margin="4,0,0,0"/>
                                            <TextBlock Grid.Column="2" Text="In use" Style="{StaticResource Caption}" Margin="12,0,0,0"/>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,0,0,8"
                                                                Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="2*"/>
                                                                <ColumnDefinition Width="1.4*"/>
                                                                <ColumnDefinition Width="1.2*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Label}" Style="{StaticResource ValueText}"/>
                                                                <TextBlock Text="{Binding Range}" Style="{StaticResource Caption}"/>
                                                            </StackPanel>
                                                            <TextBox Grid.Column="1" Style="{StaticResource TextBoxExtend}" Margin="4,0,0,0"
                                                                     Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                                                     IsEnabled="{Binding DataContext.CanOperate, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding Current}" Style="{StaticResource ValueText}" Margin="12,0,0,0"/>
                                                        </Grid>
                                                        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" Margin="0,2,0,0"
                                                                   TextWrapping="Wrap">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Error}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Style="{StaticResource Nova.ButtonPrimary}" HorizontalAlignment="Right" Margin="0,6,0,0"
                                                Command="{Binding ApplyCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <iconPacks:PackIconLucide Kind="Send" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="{Binding ApplyLabel}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ApplyLabel}" Value="{x:Null}">
                                                                    <Setter Property="Text" Value="Write to PLC"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Values -->
                <ItemsControl Grid.Column="2" ItemsSource="{Binding ReadingGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}"/>
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Label}" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource ValueText}"
                                                               Margin="12,0,0,0" MaxWidth="320" TextAlignment="Right"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
