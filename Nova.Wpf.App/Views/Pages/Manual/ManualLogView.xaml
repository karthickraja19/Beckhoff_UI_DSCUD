<UserControl x:Class="Nova.Wpf.App.Views.Pages.Manual.ManualLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Nova.Wpf.UI.Localization;assembly=Nova.Wpf.UI"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:converters="clr-namespace:Nova.Wpf.App.Converters"
             Background="Transparent">

    <UserControl.Resources>
        <converters:AudioBoolToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style x:Key="Card" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource RegionBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect" Value="{StaticResource EffectShadow1}"/>
        </Style>

        <Style x:Key="CardHeaderText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Nova.SectionTitle}"/>

        <Style x:Key="EmptyHint" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="{DynamicResource Nova.FontSize.Body}"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="Margin" Value="4,8,0,0"/>
        </Style>
    </UserControl.Resources>

    <!-- Homing and reset on top; running log | alarms standing now below -->
    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ Homing + reset: the Setting page's Manual tab's commands ============ -->
        <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,12"
                    DataContext="{Binding MachineControls}">
            <!-- Homing: sets the PLC's home command bit; the PLC homes every
                 component and raises "homing done", which pops up a message. -->
            <Button Style="{StaticResource Audio.Button}"
                    MinWidth="180"
                    Content="{loc:TrBinding HomingCaption}"
                    Command="{Binding HomeMachineCommand}"
                    IsEnabled="{Binding CanHome, FallbackValue=False}"
                    ToolTip="{loc:TrBinding HomingTooltip}"
                    Visibility="{Binding HasHoming, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}"/>

            <!-- The PLC's RESET (MAIN.bResetPb, MAIN.modecall.bResetPb): clears
                 its alarm list and takes it out of ALARM / STOP. Deliberately an
                 icon only, with no caption or tooltip. -->
            <Button Style="{StaticResource Audio.Button}"
                    Width="{Binding ActualHeight, RelativeSource={RelativeSource Self}}"
                    MinWidth="0"
                    Padding="0"
                    Margin="8,0,0,0"
                    Command="{Binding ResetMachineCommand}"
                    Visibility="{Binding HasReset, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                <Path Width="16" Height="16"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.8"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Data="M 13.5,8 A 5.5,5.5 0 1 1 11.9,4.1 M 12.2,1.4 L 12.2,4.4 L 9.2,4.4"/>
            </Button>
        </StackPanel>

        <!-- ============ Running log: newest first ============ -->
        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}" Padding="14,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <iconPacks:PackIconLucide Kind="FileText" Width="16" Height="16" VerticalAlignment="Center"
                                              Margin="0,0,8,0" Foreground="{DynamicResource PrimaryBrush}"/>
                    <TextBlock Text="{loc:Tr Txt_RunningLog}" Style="{StaticResource CardHeaderText}"/>
                </StackPanel>

                <Grid>
                    <TextBlock Style="{StaticResource EmptyHint}" VerticalAlignment="Top"
                               Text="{loc:Tr Txt_NothingLoggedYet}"
                               Visibility="{Binding RunningLog.IsEmpty, Converter={StaticResource BoolToVisibility}}"/>

                    <!-- Auto-height rows: a log line wraps to two or three lines. -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding RunningLog.Logs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                                            Padding="4,7" SnapsToDevicePixels="True">
                                        <TextBlock Text="{loc:TrBinding}" TextWrapping="Wrap"
                                                   FontFamily="Consolas, Cascadia Mono, monospace"
                                                   FontSize="{DynamicResource Nova.FontSize.Caption}"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Border>

        <!-- ============ Alarms: the PLC's list, until its RESET clears them ============ -->
        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}" Padding="14,12">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="CircleAlert" Width="16" Height="16" VerticalAlignment="Center"
                                                  Margin="0,0,8,0">
                            <iconPacks:PackIconLucide.Style>
                                <Style TargetType="{x:Type iconPacks:PackIconLucide}">
                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasAlarms}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </iconPacks:PackIconLucide.Style>
                        </iconPacks:PackIconLucide>
                        <TextBlock Text="{loc:Tr Txt_ActiveAlarms}" Style="{StaticResource CardHeaderText}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding ActiveAlarms.Count}" HorizontalAlignment="Right" VerticalAlignment="Center"
                               FontSize="{DynamicResource Nova.FontSize.Body}" FontWeight="SemiBold"
                               Foreground="{DynamicResource DangerBrush}"
                               Visibility="{Binding HasAlarms, Converter={StaticResource BoolToVisibility}}"/>
                </Grid>

                <Grid>
                    <TextBlock Style="{StaticResource EmptyHint}" VerticalAlignment="Top"
                               Text="{loc:Tr Txt_NoActiveAlarms}"
                               Visibility="{Binding HasAlarms, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"/>

                    <DockPanel Grid.IsSharedSizeScope="True"
                               Visibility="{Binding HasAlarms, Converter={StaticResource BoolToVisibility}}">
                    <!-- FAM 2 HS_05: the alarm log's headings. -->
                    <Grid DockPanel.Dock="Top" Margin="4,0,4,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="AlarmTime"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Date and time" Margin="0,0,12,0" FontWeight="SemiBold"
                                   FontSize="{DynamicResource Nova.FontSize.Caption}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock Grid.Column="1" Text="Code and Description" FontWeight="SemiBold"
                                   FontSize="{DynamicResource Nova.FontSize.Caption}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding ActiveAlarms}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                                            Padding="4,8" SnapsToDevicePixels="True">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="AlarmTime"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Time}" Margin="0,0,12,0"
                                                       FontFamily="Consolas, Cascadia Mono, monospace"
                                                       FontSize="{DynamicResource Nova.FontSize.Caption}"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                                            <TextBlock Grid.Column="1" Text="{loc:TrBinding Description}" TextWrapping="Wrap"
                                                       FontSize="{DynamicResource Nova.FontSize.Body}"
                                                       Foreground="{DynamicResource DangerBrush}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    </DockPanel>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
