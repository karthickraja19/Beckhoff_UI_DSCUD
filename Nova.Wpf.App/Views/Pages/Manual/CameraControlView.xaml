 <UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:ui="clr-namespace:Nova.Wpf.UI.Components;assembly=Nova.Wpf.UI"
    xmlns:av="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="av"
    x:Class="Nova.Wpf.App.Views.Pages.Manual.CameraControlView"
    Background="Transparent"
    av:DesignHeight="630.69"
    av:DesignWidth="1104.8">

    <UserControl.Resources>

        <!-- ============================================================
             FIELD CAPTION
             ============================================================ -->
        <Style x:Key="Caption"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource Nova.FieldLabel}">
            <Setter Property="Margin" Value="0"/>
        </Style>


        <!-- ============================================================
             CARD
             ============================================================ -->
        <Style x:Key="Card"
               TargetType="{x:Type Border}">
            <Setter Property="Background"
                    Value="{DynamicResource RegionBrush}"/>
            <Setter Property="CornerRadius"
                    Value="8"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="Effect"
                    Value="{StaticResource EffectShadow1}"/>
        </Style>


        <!-- ============================================================
             PANEL BUTTON
             ============================================================ -->
        <Style x:Key="PanelButton"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource Nova.ButtonSecondary}">

            <Setter Property="Height" Value="44"/>
            <Setter Property="MinWidth" Value="0"/>

        </Style>


        <!-- ============================================================
             CONNECT BUTTON
             ============================================================ -->
        <Style x:Key="ConnectButton"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource PanelButton}">

            <Setter Property="Background"
                    Value="{DynamicResource DarkPrimaryBrush}"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource ReverseTextBrush}"/>

        </Style>


        <!-- ============================================================
             TRIGGER BUTTON
             ============================================================ -->
        <Style x:Key="TriggerButton"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource PanelButton}">

            <Setter Property="Background"
                    Value="{DynamicResource PrimaryBrush}"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource ReverseTextBrush}"/>

        </Style>


        <!-- ============================================================
             DISCONNECT BUTTON
             ============================================================ -->
        <Style x:Key="DisconnectButton"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource PanelButton}">

            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryTextBrush}"/>

        </Style>


        <!-- ============================================================
             CONSOLE LINE
             ============================================================ -->
        <DataTemplate x:Key="ConsoleLineTemplate">

            <Grid Margin="0,1">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <!-- RESPONSE PREFIX -->
                <TextBlock
                    Grid.Column="0"
                    Text="&gt;&gt;"
                    FontFamily="Consolas"
                    FontSize="{DynamicResource Nova.FontSize.Body}"
                    Foreground="{DynamicResource PrimaryBrush}"
                    Margin="0,0,8,0"
                    VerticalAlignment="Top"/>


                <!-- RESPONSE TEXT -->
                <TextBlock
                    x:Name="LineText"
                    Grid.Column="1"
                    Text="{Binding Text}"
                    FontFamily="Consolas"
                    FontSize="{DynamicResource Nova.FontSize.Body}"
                    Foreground="{DynamicResource ReverseTextBrush}"
                    TextWrapping="Wrap"
                    TextTrimming="None"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"/>

            </Grid>


            <DataTemplate.Triggers>

                <DataTrigger
                    Binding="{Binding IsAck}"
                    Value="True">

                    <Setter
                        TargetName="LineText"
                        Property="Foreground"
                        Value="{DynamicResource SuccessBrush}"/>

                </DataTrigger>

            </DataTemplate.Triggers>

        </DataTemplate>


        <!-- ============================================================
             IMPORTANT:
             DEDICATED WHITE SCROLLBAR FOR CCD CONSOLE
             
             This does NOT depend on:
                 Foreground
                 Background
                 HandyControl ScrollBar template
                 Application ScrollBar style
             
             The thumb is explicitly WHITE in the template.
             ============================================================ -->

        <Style x:Key="WhiteConsoleScrollBar"
               TargetType="{x:Type ScrollBar}">

            <!-- Width of scrollbar -->
            <Setter Property="Width"
                    Value="14"/>

            <!-- Transparent scrollbar track -->
            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate
                        TargetType="{x:Type ScrollBar}">

                        <Grid
                            Width="14"
                            Background="Transparent">


                            <!-- =================================================
                                 TRACK
                                 ================================================= -->

                            <Track
                                x:Name="PART_Track"
                                Orientation="Vertical"
                                Focusable="False"
                                IsDirectionReversed="True">


                                <!-- =================================================
                                     AREA ABOVE THUMB
                                     ================================================= -->

                                <Track.DecreaseRepeatButton>

                                    <RepeatButton
                                        Command="{x:Static ScrollBar.PageUpCommand}"
                                        CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Focusable="False">

                                        <RepeatButton.Template>

                                            <ControlTemplate
                                                TargetType="{x:Type RepeatButton}">

                                                <Border
                                                    Background="Transparent"/>

                                            </ControlTemplate>

                                        </RepeatButton.Template>

                                    </RepeatButton>

                                </Track.DecreaseRepeatButton>


                                <!-- =================================================
                                     WHITE THUMB
                                     ================================================= -->

                                <Track.Thumb>

                                    <Thumb
                                        MinHeight="30"
                                        Background="White"
                                        BorderThickness="0"
                                        Cursor="Hand">

                                        <Thumb.Template>

                                            <ControlTemplate
                                                TargetType="{x:Type Thumb}">

                                                <Border
                                                    Width="8"
                                                    MinHeight="30"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Stretch"
                                                    Background="White"
                                                    BorderBrush="White"
                                                    BorderThickness="0"
                                                    CornerRadius="4"/>

                                            </ControlTemplate>

                                        </Thumb.Template>

                                    </Thumb>

                                </Track.Thumb>


                                <!-- =================================================
                                     AREA BELOW THUMB
                                     ================================================= -->

                                <Track.IncreaseRepeatButton>

                                    <RepeatButton
                                        Command="{x:Static ScrollBar.PageDownCommand}"
                                        CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Focusable="False">

                                        <RepeatButton.Template>

                                            <ControlTemplate
                                                TargetType="{x:Type RepeatButton}">

                                                <Border
                                                    Background="Transparent"/>

                                            </ControlTemplate>

                                        </RepeatButton.Template>

                                    </RepeatButton>

                                </Track.IncreaseRepeatButton>

                            </Track>

                        </Grid>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ============================================================
             CCD CONSOLE SCROLLVIEWER
             
             This style applies the white scrollbar ONLY to this console.
             ============================================================ -->

        <Style x:Key="CcdConsoleScrollViewer"
               TargetType="{x:Type ScrollViewer}">

            <Setter Property="VerticalScrollBarVisibility"
                    Value="Auto"/>

            <Setter Property="HorizontalScrollBarVisibility"
                    Value="Disabled"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate
                        TargetType="{x:Type ScrollViewer}">

                        <Grid Background="{TemplateBinding Background}">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>


                            <!-- =================================================
                                 CONTENT
                                 ================================================= -->

                            <ScrollContentPresenter
                                Grid.Column="0"
                                x:Name="PART_ScrollContentPresenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Margin="{TemplateBinding Padding}"
                                CanContentScroll="{TemplateBinding CanContentScroll}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>


                            <!-- =================================================
                                 VERTICAL SCROLLBAR
                                 ================================================= -->

                            <ScrollBar
                                Grid.Column="1"
                                x:Name="PART_VerticalScrollBar"
                                Orientation="Vertical"
                                Width="14"
                                Style="{StaticResource WhiteConsoleScrollBar}"
                                Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                Maximum="{TemplateBinding ScrollableHeight}"
                                ViewportSize="{TemplateBinding ViewportHeight}"
                                Value="{Binding VerticalOffset,
                                                RelativeSource={RelativeSource TemplatedParent},
                                                Mode=OneWay}"/>

                        </Grid>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </UserControl.Resources>


    <!-- ================================================================
         MAIN GRID
         ================================================================ -->

    <Grid Margin="16,12">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>


        <!-- ============================================================
             HEADER
             ============================================================ -->

        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="Auto"/>

            </Grid.ColumnDefinitions>


            <!-- SELECT CCD -->

            <StackPanel
                Grid.Column="0"
                HorizontalAlignment="Left">

                <TextBlock
                    Text="Select CCD"
                    Style="{StaticResource Caption}"
                    Margin="2,0,0,6"/>


                <Border
                    CornerRadius="8"
                    Height="40"
                    Width="320"
                    Background="{DynamicResource RegionBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1">

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="Auto"/>

                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>


                        <iconPacks:PackIconLucide
                            Grid.Column="0"
                            Kind="Search"
                            Width="16"
                            Height="16"
                            Margin="14,0,8,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource SecondaryTextBrush}"/>


                        <ComboBox
                            Grid.Column="1"
                            VerticalContentAlignment="Center"
                            BorderThickness="0"
                            Background="Transparent"
                            ItemsSource="{Binding Devices}"
                            SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                            DisplayMemberPath="Name"/>

                    </Grid>

                </Border>

            </StackPanel>


            <!-- STATUS -->

            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Top"
                HorizontalAlignment="Right">

                <TextBlock
                    Text="STATUS"
                    Style="{StaticResource Caption}"
                    HorizontalAlignment="Right"
                    Margin="0,0,0,6"/>


                <StackPanel
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

                    <TextBlock
                        Text="{Binding StatusText}"
                        FontSize="{DynamicResource Nova.FontSize.Body}"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center">

                        <TextBlock.Style>

                            <Style
                                TargetType="{x:Type TextBlock}">

                                <Setter
                                    Property="Foreground"
                                    Value="{DynamicResource SecondaryTextBrush}"/>

                                <Style.Triggers>

                                    <DataTrigger
                                        Binding="{Binding IsConnected}"
                                        Value="True">

                                        <Setter
                                            Property="Foreground"
                                            Value="{DynamicResource SuccessBrush}"/>

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </TextBlock.Style>

                    </TextBlock>


                    <Ellipse
                        Width="9"
                        Height="9"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center">

                        <Ellipse.Style>

                            <Style
                                TargetType="{x:Type Ellipse}">

                                <Setter
                                    Property="Fill"
                                    Value="{DynamicResource SecondaryTextBrush}"/>

                                <Style.Triggers>

                                    <DataTrigger
                                        Binding="{Binding IsConnected}"
                                        Value="True">

                                        <Setter
                                            Property="Fill"
                                            Value="{DynamicResource SuccessBrush}"/>

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </Ellipse.Style>

                    </Ellipse>

                </StackPanel>

            </StackPanel>

        </Grid>


        <!-- ============================================================
             CONTENT
             ============================================================ -->

        <Grid
            Grid.Row="1"
            Margin="0,16,0,0">

            <Grid
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="520"/>

                    <ColumnDefinition Width="24"/>

                    <ColumnDefinition Width="320"/>

                </Grid.ColumnDefinitions>


                <!-- ====================================================
                     LEFT SIDE
                     ==================================================== -->

                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Top">


                    <!-- =================================================
                         SEND COMMAND
                         ================================================= -->

                    <TextBlock
                        Text="SEND COMMAND"
                        Style="{StaticResource Caption}"
                        Margin="0,0,0,6"/>


                    <Border
                        Style="{StaticResource Card}"
                        Height="140">

                        <TextBox
                            Text="{Binding SendCommand,
                                           UpdateSourceTrigger=PropertyChanged}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="12,10"
                            FontFamily="Consolas"
                            FontSize="{DynamicResource Nova.FontSize.Body}"
                            Foreground="{DynamicResource PrimaryTextBrush}"
                            TextWrapping="Wrap"
                            AcceptsReturn="True"
                            VerticalScrollBarVisibility="Auto"/>

                    </Border>


                    <!-- =================================================
                         RECEIVED RESPONSE TITLE
                         ================================================= -->
                    <Grid>
                        <TextBlock
    Text="RECEIVED RESPONSE"
    Style="{StaticResource Caption}"
    Margin="0,16,0,6"/>

                        
                        <Button FontSize="12"
        VerticalAlignment="Bottom"
        HorizontalAlignment="Right"
        Margin="0,0,0,3"
        MinWidth="0"
        Height="20"
        Padding="6,0"
        Command="{Binding RefreshResponseCommand}"
        Style="{StaticResource Nova.ButtonOutline}">

                            <StackPanel Orientation="Horizontal"
                VerticalAlignment="Center">

                                <iconPacks:PackIconLucide Kind="RefreshCw"
                                  Width="13"
                                  Height="13"
                                  Margin="0,0,5,0"
                                  VerticalAlignment="Center"
                                  Foreground="{DynamicResource PrimaryBrush}"/>

                                <TextBlock Text="Refresh"
                   VerticalAlignment="Center"/>
                            </StackPanel>

                        </Button>
                        


                    </Grid>
                    


                    <!-- =================================================
                         RECEIVED RESPONSE CONSOLE
                         ================================================= -->

                    <Border
                        CornerRadius="8"
                        Background="#050505"
                        Height="160"
                        ClipToBounds="True"
                        Effect="{StaticResource EffectShadow1}">


                        <!-- =================================================
                             SCROLL VIEWER
                             ================================================= -->

                        <ScrollViewer
                            Style="{StaticResource CcdConsoleScrollViewer}"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled">


                            <!-- =================================================
                                 CCD RESPONSE
                                 ================================================= -->

                            <ItemsControl
                                ItemsSource="{Binding Console}"
                                ItemTemplate="{StaticResource ConsoleLineTemplate}"
                                HorizontalContentAlignment="Stretch"/>

                        </ScrollViewer>

                    </Border>

                </StackPanel>


                <!-- ====================================================
                     RIGHT SIDE - SELECTED DEVICE
                     ==================================================== -->

                <Border
                    Grid.Column="2"
                    Style="{StaticResource Card}"
                    VerticalAlignment="Center"
                    Padding="20">


                    <StackPanel>

                        <TextBlock
                            Text="SELECTED DEVICE"
                            Style="{StaticResource Caption}"/>


                        <TextBlock
                            Text="{Binding SelectedDevice.DisplayName}"
                            FontSize="{DynamicResource Nova.FontSize.Heading}"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource PrimaryTextBrush}"
                            Margin="0,8,0,18"
                            TextWrapping="Wrap"/>


                        <!-- CONNECT -->

                        <Button
                            Style="{StaticResource ConnectButton}"
                            Command="{Binding ConnectDeviceCommand}"
                            IsEnabled="{Binding CanConnect}">

                            <StackPanel
                                Orientation="Horizontal">

                                <iconPacks:PackIconLucide
                                    Kind="Link2"
                                    Width="15"
                                    Height="15"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Foreground="{Binding Foreground,
                                        RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>

                                <TextBlock
                                    Text="CONNECT DEVICE"
                                    VerticalAlignment="Center"/>

                            </StackPanel>

                        </Button>


                        <!-- TRIGGER -->

                        <Button
                            Style="{StaticResource TriggerButton}"
                            Command="{Binding TriggerCaptureCommand}"
                            IsEnabled="{Binding IsConnected}"
                            Margin="0,10,0,0"
                            Click="Button_Click">

                            <StackPanel
                                Orientation="Horizontal">

                                <iconPacks:PackIconLucide
                                    Kind="Camera"
                                    Width="15"
                                    Height="15"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Foreground="{Binding Foreground,
                                        RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>

                                <TextBlock
                                    Text="TRIGGER CAPTURE"
                                    VerticalAlignment="Center"/>

                            </StackPanel>

                        </Button>


                        <!-- DISCONNECT -->

                        <Button
                            Style="{StaticResource DisconnectButton}"
                            Command="{Binding DisconnectCommand}"
                            IsEnabled="{Binding IsConnected}"
                            Margin="0,10,0,0">

                            <StackPanel
                                Orientation="Horizontal">

                                <iconPacks:PackIconLucide
                                    Kind="Unlink"
                                    Width="15"
                                    Height="15"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Foreground="{Binding Foreground,
                                        RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>

                                <TextBlock
                                    Text="DISCONNECT"
                                    VerticalAlignment="Center"/>

                            </StackPanel>

                        </Button>

                    </StackPanel>

                </Border>

            </Grid>

        </Grid>

    </Grid>

</UserControl>
