<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:loc="clr-namespace:Nova.Wpf.UI.Localization;assembly=Nova.Wpf.UI"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:ui="clr-namespace:Nova.Wpf.UI.Components;assembly=Nova.Wpf.UI"
             xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av" x:Class="Nova.Wpf.App.Views.Pages.Manual.RobotControlView"
             Background="Transparent" av:DesignWidth="1211.693" av:DesignHeight="610.69">

    <UserControl.Resources>
        <!-- Field caption: flat, muted, regular weight, no surface - the app-wide
             label treatment, so it can never be confused with a button. -->
        <Style x:Key="Caption" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Nova.FieldLabel}">
            <Setter Property="Margin" Value="0"/>
        </Style>

        <Style x:Key="Card" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource RegionBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect" Value="{StaticResource EffectShadow1}"/>
        </Style>

        <!-- Card title = section heading, so it keeps the heading weight. -->
        <Style x:Key="CardHeaderText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Nova.SectionTitle}"/>

        <!-- Bool input: name + read-only indicator dot -->
        <DataTemplate x:Key="InputRowTemplate">
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="4,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:TrBinding Name}" FontSize="{DynamicResource Nova.FontSize.Body}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" ToolTip="{loc:TrBinding Name}"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <ui:StatusIndicator Grid.Column="1" IsActive="{Binding IsOn}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Bool output: name + toggle switch. The switch shows what the PLC holds; a click
             asks for the other state, and the next read shows what the PLC made of it. -->
        <DataTemplate x:Key="OutputRowTemplate">
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="4,7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:TrBinding Name}" FontSize="{DynamicResource Nova.FontSize.Body}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" ToolTip="{loc:TrBinding Name}"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <ToggleButton Grid.Column="1" Style="{StaticResource ToggleButtonSwitch}" VerticalAlignment="Center" Margin="10,0,0,0"
                                  Command="{Binding DataContext.ToggleOutputCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}"
                                  IsChecked="{Binding IsOn, Mode=OneWay}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Byte / Word: name + its number, read only -->
        <DataTemplate x:Key="ValueRowTemplate">
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="4,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:TrBinding Name}" FontSize="{DynamicResource Nova.FontSize.Body}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" ToolTip="{loc:TrBinding Name}"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Value}" Margin="10,0,0,0" VerticalAlignment="Center"
                               FontFamily="Consolas, Cascadia Mono, monospace" FontSize="{DynamicResource Nova.FontSize.Body}"
                               FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============ Robot selector + connection ============ -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
            <TextBlock Text="{loc:Tr Txt_SelectRobotUnit}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <Border CornerRadius="8" Height="{DynamicResource Nova.Field.Height}" Width="300"
                    Background="{DynamicResource RegionBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <iconPacks:PackIconLucide Grid.Column="0" Kind="Search" Width="16" Height="16"
                                              Margin="14,0,8,0" VerticalAlignment="Center"
                                              Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <ComboBox Grid.Column="1" VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent"
                              ItemsSource="{Binding RobotUnits}" SelectedItem="{Binding SelectedRobot, Mode=TwoWay}"/>
                </Grid>
            </Border>

            <TextBlock Text="{loc:Tr Txt_STATUS}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="24,0,10,0"/>
            <TextBlock Text="{loc:TrBinding StatusText}" FontSize="{DynamicResource Nova.FontSize.Body}" FontWeight="SemiBold" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Ellipse Width="9" Height="9" Margin="8,0,0,0" VerticalAlignment="Center">
                <Ellipse.Style>
                    <Style TargetType="{x:Type Ellipse}">
                        <Setter Property="Fill" Value="{DynamicResource SecondaryTextBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
            </Ellipse>
        </StackPanel>

        <!-- ============ Inputs | Outputs ============
             Each card lists the BOOLs first, then the BYTEs and WORDs as numbers. -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Inputs: all read only -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14,12">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="ArrowDownToLine" Width="16" Height="16" VerticalAlignment="Center"
                                                      Margin="0,0,8,0" Foreground="{DynamicResource PrimaryBrush}"/>
                            <TextBlock Text="{loc:Tr Txt_Inputs}" Style="{StaticResource CardHeaderText}"/>
                        </StackPanel>
                        <TextBlock Text="{loc:Tr Txt_STATUS}" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding DigitalInputs}" ItemTemplate="{StaticResource InputRowTemplate}"/>
                            <Grid Margin="0,16,0,4">
                                <TextBlock Text="{loc:Tr Txt_VALUES}" Style="{StaticResource Caption}"/>
                                <TextBlock Text="{loc:Tr Txt_VALUE}" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding InputValues}" ItemTemplate="{StaticResource ValueRowTemplate}"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Outputs: BOOLs switch, BYTEs and WORDs read only -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14,12">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="ArrowUpFromLine" Width="16" Height="16" VerticalAlignment="Center"
                                                      Margin="0,0,8,0" Foreground="{DynamicResource PrimaryBrush}"/>
                            <TextBlock Text="{loc:Tr Txt_Outputs}" Style="{StaticResource CardHeaderText}"/>
                        </StackPanel>
                        <TextBlock Text="{loc:Tr Txt_ONOFF}" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding DigitalOutputs}" ItemTemplate="{StaticResource OutputRowTemplate}"/>
                            <Grid Margin="0,16,0,4">
                                <TextBlock Text="{loc:Tr Txt_VALUES}" Style="{StaticResource Caption}"/>
                                <TextBlock Text="{loc:Tr Txt_VALUE}" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding OutputValues}" ItemTemplate="{StaticResource ValueRowTemplate}"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
