<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:ui="clr-namespace:Nova.Wpf.UI.Components;assembly=Nova.Wpf.UI"
             xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av" x:Class="Nova.Wpf.App.Views.Pages.Manual.RobotControlView"
             Background="Transparent" av:DesignWidth="1211.693" av:DesignHeight="610.69">

    <UserControl.Resources>
        <!-- Field caption: flat, muted, regular weight, no surface — the app-wide
             label treatment, so it can never be confused with a button. -->
        <Style x:Key="Caption" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Nova.FieldLabel}">
            <Setter Property="Margin" Value="0"/>
        </Style>

        <Style x:Key="Card" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource RegionBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect" Value="{StaticResource EffectShadow1}"/>
        </Style>

        <!-- Card title = section heading, so it keeps the heading weight. -->
        <Style x:Key="CardHeaderText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Nova.SectionTitle}"/>

        <!-- Derives from the shared Nova affordance instead of re-templating:
             black outline, common radius/padding and all four states arrive for
             free. Only the 44px panel height is local. -->
        <Style x:Key="PanelButton" TargetType="{x:Type Button}" BasedOn="{StaticResource Nova.ButtonSecondary}">
            <Setter Property="Height" Value="44"/>
            <Setter Property="MinWidth" Value="0"/>
        </Style>
        <Style x:Key="ConnectButton" TargetType="{x:Type Button}" BasedOn="{StaticResource PanelButton}">
            <Setter Property="Background" Value="{DynamicResource DarkPrimaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ReverseTextBrush}"/>
        </Style>
        <Style x:Key="TriggerButton" TargetType="{x:Type Button}" BasedOn="{StaticResource PanelButton}">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ReverseTextBrush}"/>
        </Style>
        <!-- Lowest-emphasis of the three: neutral fill, same outline. -->
        <Style x:Key="DisconnectButton" TargetType="{x:Type Button}" BasedOn="{StaticResource PanelButton}">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>

        <DataTemplate x:Key="ConsoleLineTemplate">
            <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- Response prefix -->
                <TextBlock Grid.Column="0" Text="&gt;&gt;" FontFamily="Consolas, Cascadia Mono, monospace" FontSize="{DynamicResource Nova.FontSize.Body}" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,8,0" VerticalAlignment="Top"/>
                <!-- Response text -->
                <TextBlock x:Name="LineText" Grid.Column="1" Text="{Binding Text}" FontFamily="Consolas, Cascadia Mono, monospace" FontSize="{DynamicResource Nova.FontSize.Body}" Foreground="{DynamicResource ReverseTextBrush}" TextWrapping="Wrap" TextTrimming="None" HorizontalAlignment="Stretch" VerticalAlignment="Top"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsAck}" Value="True">
                    <Setter TargetName="LineText" Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Digital input: name + read-only indicator dot -->
        <DataTemplate x:Key="InputRowTemplate">
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="4,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}" FontSize="{DynamicResource Nova.FontSize.Body}" VerticalAlignment="Center"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <ui:StatusIndicator Grid.Column="1" IsActive="{Binding IsOn}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Digital output: name + toggle switch -->
        <DataTemplate x:Key="OutputRowTemplate">
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="4,7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}" FontSize="{DynamicResource Nova.FontSize.Body}" VerticalAlignment="Center"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <ToggleButton Grid.Column="1" Style="{StaticResource ToggleButtonSwitch}"
                                  IsChecked="{Binding IsOn, Mode=TwoWay}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============ Robot selector ============ -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
            <TextBlock Text="Select Robot Unit" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <Border CornerRadius="8" Height="38" Width="300"
                    Background="{DynamicResource RegionBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <iconPacks:PackIconLucide Grid.Column="0" Kind="Search" Width="16" Height="16"
                                              Margin="14,0,8,0" VerticalAlignment="Center"
                                              Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <ComboBox Grid.Column="1" VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent"
                              ItemsSource="{Binding RobotUnits}" SelectedItem="{Binding SelectedRobot, Mode=TwoWay}"/>
                </Grid>
            </Border>
        </StackPanel>

        <!-- ============ Content: Inputs | Outputs | Console ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="1.15*"/>
            </Grid.ColumnDefinitions>

            <!-- Digital Inputs -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14,12">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="ArrowDownToLine" Width="16" Height="16" VerticalAlignment="Center"
                                                      Margin="0,0,8,0" Foreground="{DynamicResource PrimaryBrush}"/>
                            <TextBlock Text="Digital Inputs" Style="{StaticResource CardHeaderText}"/>
                        </StackPanel>
                        <TextBlock Text="STATUS" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
              HorizontalScrollBarVisibility="Disabled"
              Padding="14,10">
                        <ItemsControl ItemsSource="{Binding Console}"
                  ItemTemplate="{StaticResource ConsoleLineTemplate}"
                  HorizontalContentAlignment="Stretch"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Digital Outputs -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14,12">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="ArrowUpFromLine" Width="16" Height="16" VerticalAlignment="Center"
                                                      Margin="0,0,8,0" Foreground="{DynamicResource PrimaryBrush}"/>
                            <TextBlock Text="Digital Outputs" Style="{StaticResource CardHeaderText}"/>
                        </StackPanel>
                        <TextBlock Text="ON/OFF" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding DigitalOutputs}" ItemTemplate="{StaticResource OutputRowTemplate}"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Console panel -->
            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- CMD selector + status -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding SelectorCaption}" Style="{StaticResource Caption}" Margin="2,0,0,6"/>
                        <Border CornerRadius="8" Height="38"
                                Background="{DynamicResource RegionBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <iconPacks:PackIconLucide Grid.Column="0" Kind="Search" Width="15" Height="15"
                                                          Margin="12,0,8,0" VerticalAlignment="Center"
                                                          Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <ComboBox Grid.Column="1" VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent"
                                          ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                                          DisplayMemberPath="Name"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="14,0,0,0">
                        <TextBlock Text="STATUS" Style="{StaticResource Caption}" HorizontalAlignment="Right" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding StatusText}" FontSize="{DynamicResource Nova.FontSize.Body}" FontWeight="SemiBold" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Ellipse Width="9" Height="9" Margin="8,0,0,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="{x:Type Ellipse}">
                                        <Setter Property="Fill" Value="{DynamicResource SecondaryTextBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Send command -->
                <StackPanel Grid.Row="1" Margin="0,14,0,0">
                    <TextBlock Text="SEND COMMAND" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                    <Border Style="{StaticResource Card}" Height="110">
                        <TextBox Text="{Binding SendCommand, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0" Padding="12,10"
                                 FontFamily="Consolas, Cascadia Mono, monospace" FontSize="{DynamicResource Nova.FontSize.Body}"
                                 Foreground="{DynamicResource PrimaryTextBrush}"
                                 TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                    </Border>
                </StackPanel>

                <!-- Received response -->
                <StackPanel Grid.Row="2" Margin="0,14,0,0">
                    <TextBlock Text="RECEIVED RESPONSE" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                    <Border CornerRadius="8" Background="{DynamicResource PrimaryTextBrush}"
                            Effect="{StaticResource EffectShadow1}" MinHeight="120">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,10">
                            <ItemsControl ItemsSource="{Binding Console}" ItemTemplate="{StaticResource ConsoleLineTemplate}"/>
                        </ScrollViewer>
                    </Border>
                </StackPanel>

                <!-- Actions -->
                <StackPanel  Grid.Row="3" Margin="0,14,0,0">
                    <Button Style="{StaticResource ConnectButton}" Command="{Binding ConnectDeviceCommand}" IsEnabled="{Binding CanConnect}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="Link2" Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center"
                                                      Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                            <TextBlock Text="CONNECT DEVICE" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource TriggerButton}" Command="{Binding TriggerCommand}" IsEnabled="{Binding IsConnected}" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="Camera" Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center"
                                                      Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                            <TextBlock Text="TRIGGER CAPTURE" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource DisconnectButton}" Command="{Binding DisconnectCommand}" IsEnabled="{Binding IsConnected}" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="Unlink" Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center"
                                                      Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                            <TextBlock Text="DISCONNECT" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>