<UserControl x:Class="Nova.Wpf.App.Views.Pages.Manual.CylinderControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:loc="clr-namespace:Nova.Wpf.UI.Localization;assembly=Nova.Wpf.UI"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="Transparent">

    <UserControl.Resources>
        <!-- Header column label. Size comes from Nova.TableHeaderText — do not
             restate it here, that is how pages drift apart. -->
        <Style x:Key="HeaderCell" TargetType="TextBlock" BasedOn="{StaticResource Nova.TableHeaderText}"/>
        <Style x:Key="HeaderCellCentered" TargetType="TextBlock" BasedOn="{StaticResource HeaderCell}">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <!-- Row text -->
        <Style x:Key="CellText" TargetType="TextBlock" BasedOn="{StaticResource Nova.CellText}"/>

        <!-- Work (move) and Home share the app-wide primary action colour. Raised
             + Hand cursor (Nova.ButtonCompact) so they never read as a chip. -->
        <Style x:Key="GridActionButton" TargetType="Button" BasedOn="{StaticResource Nova.ButtonCompact}"/>

        <!-- Single-value output address chip: read-only, so it uses the flat
             recessed chip treatment — never the raised button one. -->
        <Style x:Key="OutputChip" TargetType="Border" BasedOn="{StaticResource Nova.Chip}"/>
        <Style x:Key="ChipText" TargetType="TextBlock" BasedOn="{StaticResource Nova.ChipText}"/>

        <!-- One input (reed-switch) address chip: green while the input is on. -->
        <DataTemplate x:Key="SensorChipTemplate">
            <!-- Read-only address chip: borderless, because an outline is how a
                 button announces itself. The fill alone carries on/off. -->
            <Border x:Name="Chip" CornerRadius="4" Padding="6,2" Margin="2"
                    VerticalAlignment="Center"
                    Background="{DynamicResource Nova.TableHeaderBrush}"
                    BorderBrush="Transparent" BorderThickness="1">
                <TextBlock x:Name="ChipLabel" Text="{loc:TrBinding Address}" Style="{StaticResource ChipText}"/>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsOn}" Value="True">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource SuccessBrush}"/>
                    <Setter TargetName="ChipLabel" Property="Foreground" Value="{DynamicResource ReverseTextBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Input address cell: chips wrap onto extra lines when a side has more
             sensors than fit the column width (the row grows in height). -->
        <ItemsPanelTemplate x:Key="SensorChipPanel">
            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
        </ItemsPanelTemplate>

        <!-- =============== One data row ===============
             Two lines per cylinder: the Work line carries the extend side
             (safe | output addr | input addr) and the Home line the retract
             side, so each button sits beside the I/O it drives. Stacking the
             sides instead of placing them side by side halves the row width -
             one line with both sides needs ~1800 px and was clipped beside the
             Running Log. S.No and name span both lines; a long name wraps. The
             INPUT ADDR column is the stretch column, giving the chips all
             remaining width. -->
        <DataTemplate x:Key="CylinderRowTemplate">
            <Border x:Name="RowRoot" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                    Background="Transparent">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" MinHeight="{DynamicResource Nova.Row.Height}"/>
                        <RowDefinition Height="Auto" MinHeight="{DynamicResource Nova.Row.Height}"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="cNo"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="cName"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="cAction"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="cSafe"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="cOut"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Hairline between the Work line and the Home line -->
                    <Border Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="4" BorderThickness="0,0,0,1"
                            BorderBrush="{DynamicResource BorderBrush}" Opacity="0.6"/>
                    <!-- Divider between the cylinder and its I/O -->
                    <Border Grid.Column="3" Grid.RowSpan="2" BorderThickness="1,0,0,0"
                            BorderBrush="{DynamicResource BorderBrush}"/>

                    <!-- S.No -->
                    <TextBlock Grid.Column="0" Grid.RowSpan="2" Text="{Binding SerialNo}" Style="{StaticResource CellText}"
                               FontWeight="SemiBold" Foreground="{DynamicResource ThirdlyTextBrush}"
                               HorizontalAlignment="Center" Margin="10,0" MinWidth="24" TextAlignment="Center"/>

                    <!-- State dot + cylinder name (dot goes green while extended) -->
                    <StackPanel Grid.Column="1" Grid.RowSpan="2" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="4,0,10,0" ToolTip="{loc:TrBinding StateText}">
                        <Ellipse x:Name="StateDot" Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,8,0"
                                 Fill="{DynamicResource ThirdlyTextBrush}"/>
                        <TextBlock Text="{loc:TrBinding Name}" FontSize="{DynamicResource Nova.FontSize.Body}" FontWeight="SemiBold"
                                   MinWidth="130" MaxWidth="220" TextWrapping="Wrap"
                                   VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    </StackPanel>

                    <!-- Work line (= extend): button | safe | output addr | input addr -->
                    <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource GridActionButton}"
                            HorizontalAlignment="Stretch" Margin="0,4,10,4" ToolTip="{loc:Tr Txt_Extend}"
                            Command="{Binding ExtendCommand}" IsEnabled="{Binding CanExtendNow}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:Tr Txt_Work}" VerticalAlignment="Center"/>
                            <iconPacks:PackIconLucide Kind="ChevronRight" Width="14" Height="14" Margin="4,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <iconPacks:PackIconLucide x:Name="SafeExtendIcon" Grid.Row="0" Grid.Column="3" Kind="ShieldCheck"
                                              Width="16" Height="16" Margin="10,0"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Foreground="{DynamicResource SuccessBrush}"/>
                    <Border Grid.Row="0" Grid.Column="4" Style="{StaticResource OutputChip}" Margin="8,0" MinWidth="52">
                        <TextBlock Text="{loc:TrBinding ExtendOutput}" Style="{StaticResource ChipText}" HorizontalAlignment="Center"/>
                    </Border>
                    <ItemsControl Grid.Row="0" Grid.Column="5" Margin="8,3" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding WorkSensors}"
                                  ItemTemplate="{StaticResource SensorChipTemplate}"
                                  ItemsPanel="{StaticResource SensorChipPanel}"/>

                    <!-- Home line (= retract): button | safe | output addr | input addr -->
                    <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource GridActionButton}"
                            HorizontalAlignment="Stretch" Margin="0,4,10,4" ToolTip="{loc:Tr Txt_Retract}"
                            Command="{Binding RetractCommand}" IsEnabled="{Binding CanRetractNow}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="ChevronLeft" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Tr Txt_Home}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <iconPacks:PackIconLucide x:Name="SafeRetractIcon" Grid.Row="1" Grid.Column="3" Kind="ShieldCheck"
                                              Width="16" Height="16" Margin="10,0"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Foreground="{DynamicResource SuccessBrush}"/>
                    <Border Grid.Row="1" Grid.Column="4" Style="{StaticResource OutputChip}" Margin="8,0" MinWidth="52">
                        <TextBlock Text="{loc:TrBinding RetractOutput}" Style="{StaticResource ChipText}" HorizontalAlignment="Center"/>
                    </Border>
                    <ItemsControl Grid.Row="1" Grid.Column="5" Margin="8,3" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding HomeSensors}"
                                  ItemTemplate="{StaticResource SensorChipTemplate}"
                                  ItemsPanel="{StaticResource SensorChipPanel}"/>
                </Grid>
            </Border>

            <DataTemplate.Triggers>
                <Trigger SourceName="RowRoot" Property="IsMouseOver" Value="True">
                    <Setter TargetName="RowRoot" Property="Background" Value="{DynamicResource SecondaryRegionBrush}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsExtended}" Value="True">
                    <Setter TargetName="StateDot" Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SafeToExtend}" Value="False">
                    <Setter TargetName="SafeExtendIcon" Property="Kind" Value="ShieldX"/>
                    <Setter TargetName="SafeExtendIcon" Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SafeToRetract}" Value="False">
                    <Setter TargetName="SafeRetractIcon" Property="Kind" Value="ShieldX"/>
                    <Setter TargetName="SafeRetractIcon" Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="8">
        <!-- ============ Compact cylinder grid ============ -->
        <Border Background="{DynamicResource RegionBrush}" CornerRadius="8"
                Effect="{StaticResource EffectShadow1}" ClipToBounds="True">
            <DockPanel Grid.IsSharedSizeScope="True">

                <!-- Card title + inline counts (replaces the old KPI tile strip) -->
                <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1" Padding="12,8">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="CircleDot" Width="15" Height="15" VerticalAlignment="Center"
                                                      Margin="0,0,8,0" Foreground="{DynamicResource PrimaryBrush}"/>
                            <TextBlock Text="{loc:Tr Txt_Cylinders}" Style="{StaticResource Nova.SectionTitle}"/>
                        </StackPanel>
                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="{DynamicResource Nova.FontSize.Body}"
                                   Foreground="{DynamicResource SecondaryTextBrush}">
                            <Run Text="{loc:Tr Txt_Total}"/> <Run FontWeight="Bold" Text="{Binding TotalCount, Mode=OneWay}"/>
                            <Run Text="{loc:Tr Txt_Extended}"/> <Run FontWeight="Bold" Text="{Binding ExtendedCount, Mode=OneWay}"/>
                            <Run Text="{loc:Tr Txt_Retracted}"/> <Run FontWeight="Bold" Text="{Binding RetractedCount, Mode=OneWay}"/>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- Sticky header. No EXTEND / RETRACT group labels: each row's Work
                     line is the extend side and its Home line the retract side. -->
                <Border DockPanel.Dock="Top" Background="{DynamicResource Nova.TableHeaderBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,9">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="cNo"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="cName"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="cAction"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="cSafe"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="cOut"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0"/>

                        <TextBlock Grid.Column="0" Text="{loc:Tr Txt_SNO}" Style="{StaticResource HeaderCellCentered}" Margin="10,0"/>
                        <TextBlock Grid.Column="1" Text="{loc:Tr Txt_CYLINDERNAME}" Style="{StaticResource HeaderCell}" Margin="22,0,10,0"/>
                        <TextBlock Grid.Column="2" Text="{loc:Tr Txt_ACTION}" Style="{StaticResource HeaderCell}" Margin="0,0,10,0"/>
                        <TextBlock Grid.Column="3" Text="{loc:Tr Txt_SAFE}" Style="{StaticResource HeaderCellCentered}" Margin="10,0"/>
                        <TextBlock Grid.Column="4" Text="{loc:Tr Txt_OUTPUTADDR}" Style="{StaticResource HeaderCellCentered}" Margin="8,0"/>
                        <TextBlock Grid.Column="5" Text="{loc:Tr Txt_INPUTADDR}" Style="{StaticResource HeaderCellCentered}" Margin="8,0"/>
                    </Grid>
                </Border>

                <!-- Rows -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Cylinders}" ItemTemplate="{StaticResource CylinderRowTemplate}"/>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
