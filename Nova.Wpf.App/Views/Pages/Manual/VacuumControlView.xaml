<UserControl x:Class="Nova.Wpf.App.Views.Pages.Manual.VacuumControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:ui="clr-namespace:Nova.Wpf.UI.Components;assembly=Nova.Wpf.UI"
             Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource RegionBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="{DynamicResource Nova.Card.Padding}"/>
            <Setter Property="Effect" Value="{StaticResource EffectShadow1}"/>
        </Style>

        <Style x:Key="CardHeaderText" TargetType="TextBlock" BasedOn="{StaticResource Nova.SectionTitle}"/>

        <!-- Field caption: flat, muted, regular weight, no surface — the app-wide
             label treatment, so it can never be confused with a button. -->
        <Style x:Key="SectionCaption" TargetType="TextBlock" BasedOn="{StaticResource Nova.FieldLabel}">
            <Setter Property="Margin" Value="0"/>
        </Style>

        <!-- ===== Mode button (neutral by default, filled accent when active) =====
             Shared Nova affordance at the shared button height. The
             black outline is constant across all three modes and both states —
             the fill is what says which mode the unit is in. -->
        <Style x:Key="ModeButton" TargetType="Button" BasedOn="{StaticResource Nova.ButtonSecondary}">
            <Setter Property="MinWidth" Value="0"/>
        </Style>

        <Style x:Key="VacuumButton"
       TargetType="Button"
       BasedOn="{StaticResource Nova.ButtonOutline}">
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="OffButton"
       TargetType="Button"
       BasedOn="{StaticResource Nova.ButtonOutline}">
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="BlowButton"
       TargetType="Button"
       BasedOn="{StaticResource Nova.ButtonOutline}">
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Unit selector -->
            <RowDefinition Height="*"/>
            <!-- Cards -->
        </Grid.RowDefinitions>

        <!-- ============ Unit selector ============ -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Left">
            <TextBlock Text="Select Vacuum Unit" Style="{StaticResource SectionCaption}" Margin="2,0,0,6"/>
            <Border CornerRadius="8" Height="{DynamicResource Nova.Field.Height}" Width="360"
                    Background="{DynamicResource RegionBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <iconPacks:PackIconLucide Grid.Column="0" Kind="Search" Width="16" Height="16"
                                              Margin="14,0,8,0" VerticalAlignment="Center"
                                              Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <ComboBox Grid.Column="1" VerticalContentAlignment="Center"
                              BorderThickness="0" Background="Transparent"
                              ItemsSource="{Binding Units}"
                              SelectedItem="{Binding SelectedUnit, Mode=TwoWay}"
                              DisplayMemberPath="Name"/>
                </Grid>
            </Border>
        </StackPanel>

        <!-- ============ Selected-unit content ============ -->
        <ContentControl Grid.Row="1" Content="{Binding SelectedUnit}"
                        HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0">
            <ContentControl.ContentTemplate>
                <DataTemplate>
                    <StackPanel Width="600">
                        <!-- Device status -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <iconPacks:PackIconLucide Kind="Info" Width="18" Height="18" VerticalAlignment="Center"
                                                              Margin="0,0,8,0" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    <TextBlock Text="Device status" Style="{StaticResource CardHeaderText}"/>
                                </StackPanel>

                                <Grid Height="52">
                                    <Border x:Name="StatusBg" CornerRadius="8"
                                            Background="{DynamicResource DangerBrush}" Opacity="0.12"/>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse x:Name="StatusDot" Width="9" Height="9" HorizontalAlignment="Center"
                                                 Fill="{DynamicResource DangerBrush}"/>
                                        <TextBlock x:Name="StatusAddr" Text="{Binding FeedbackAddress}"
                                                   HorizontalAlignment="Center" Margin="0,6,0,0"
                                                   FontSize="{DynamicResource Nova.FontSize.Body}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource DangerBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Device control -->
                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="DEVICE CONTROL" Style="{StaticResource SectionCaption}" Margin="0,0,0,12"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0" Style="{StaticResource VacuumButton}" Command="{Binding SetVacuumCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconLucide Kind="Aperture" Width="17" Height="17" Margin="0,0,8,0" VerticalAlignment="Center"
                                                                      Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                            <TextBlock Text="Vacuum" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Off previously carried a hardcoded Background="#FF00B7C3" - the
                                         old industrial teal. That colour is gone from the application, so
                                         the button takes the shared accent from the palette instead of
                                         reintroducing the one literal that survived the theme removal. -->
                                    <Button Grid.Column="2" Style="{StaticResource OffButton}"
                                            Background="{DynamicResource PrimaryBrush}"
                                            Command="{Binding SetOffCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconLucide Kind="Power" Width="17" Height="17" Margin="0,0,8,0" VerticalAlignment="Center"
                                                                      Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                            <TextBlock Text="Off" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Grid.Column="4" Style="{StaticResource BlowButton}" Command="{Binding SetBlowCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconLucide Kind="Wind" Width="17" Height="17" Margin="0,0,8,0" VerticalAlignment="Center"
                                                                      Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                            <TextBlock Text="Blow" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding FeedbackActive}" Value="True">
                            <Setter TargetName="StatusBg" Property="Background" Value="{DynamicResource SuccessBrush}"/>
                            <Setter TargetName="StatusDot" Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                            <Setter TargetName="StatusAddr" Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>
    </Grid>
</UserControl>
