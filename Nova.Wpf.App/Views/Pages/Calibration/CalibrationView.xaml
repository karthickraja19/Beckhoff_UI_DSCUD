<UserControl x:Class="Nova.Wpf.App.Views.Pages.Calibration.CalibrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:calibrationVm="clr-namespace:Nova.ViewModels.Pages.Calibration;assembly=Nova.ViewModels"
             xmlns:local="clr-namespace:Nova.Wpf.App.Views.Pages.Calibration"
             Background="Transparent">

    <!-- The Config page's Calibration section: the manual-mode switch on top, then one
         tab per calibration. Tab look and header come from the shared implicit
         TabControl / TabItem styles, as on the Recipe section. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="6,0,6,8">
            <CheckBox Content="Manual mode" VerticalAlignment="Center"
                      IsChecked="{Binding IsManualHeld, Mode=TwoWay}"
                      IsEnabled="{Binding CanHoldManual}"/>
            <TextBlock Margin="16,0,0,0" VerticalAlignment="Center"
                       FontSize="{DynamicResource Nova.FontSize.Caption}"
                       Foreground="{DynamicResource SecondaryTextBrush}">
                <Run Text="Machine:"/>
                <Run Text="{Binding MachineState, Mode=OneWay}" FontWeight="SemiBold"/>
            </TextBlock>
        </StackPanel>

        <TabControl Grid.Row="1"
                    ItemsSource="{Binding Tabs}"
                    SelectedItem="{Binding SelectedTab}">
            <TabControl.Resources>
                <DataTemplate DataType="{x:Type calibrationVm:CalibrationTableViewModel}">
                    <local:CalibrationTableView/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type calibrationVm:CalibrationDeviceViewModel}">
                    <local:CalibrationDeviceView/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type calibrationVm:StaticDynamicViewModel}">
                    <local:StaticDynamicView/>
                </DataTemplate>
            </TabControl.Resources>
        </TabControl>
    </Grid>
</UserControl>
