<UserControl x:Class="Nova.Wpf.App.Views.Pages.Calibration.StaticDynamicView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="Transparent">

    <!-- Static & Dynamic: the CCD verification the PLC's Static_Seq / Dynamic_Seq run. Design from the
         BAA_SQT reference (card with the table, the Static / Dynamic and camera boxes, Start / End / Stop and
         CURRENT STATUS). Everything shown is the PLC's: the vision X / Y / Z are what it last received. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource Nova.FieldLabel}">
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="ProcButton" TargetType="Button" BasedOn="{StaticResource Nova.ButtonSecondary}">
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="90"/>
        </Style>
        <Style x:Key="StartButton" TargetType="Button" BasedOn="{StaticResource ProcButton}">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ReverseTextBrush}"/>
        </Style>
        <Style x:Key="StopButton" TargetType="Button" BasedOn="{StaticResource ProcButton}">
            <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ReverseTextBrush}"/>
        </Style>

        <!-- Read-only result cell: the vision's answer. -->
        <Style x:Key="ResultCell" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, monospace"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="16">
            <Border Background="{DynamicResource RegionBrush}" CornerRadius="8" Padding="28,24" Width="600"
                    HorizontalAlignment="Center" VerticalAlignment="Top"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Effect="{DynamicResource EffectShadow1}">
                <StackPanel>
                    <!-- Header -->
                    <Grid Margin="0,0,0,20">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="Camera" Width="20" Height="20" VerticalAlignment="Center"
                                                      Margin="0,0,10,0" Foreground="{DynamicResource PrimaryBrush}"/>
                            <TextBlock Text="CCD Calibration" FontSize="{DynamicResource Nova.FontSize.Heading}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Vision result and iteration. The positions the camera goes to are the PLC's own
                         (its recipe), so the table shows what the vision answered, not start / end inputs. -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header Labels -->
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Xpos(mm)" Style="{StaticResource Caption}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="Ypos(mm)" Style="{StaticResource Caption}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Row="0" Grid.Column="5" Text="Zpos(mm)" Style="{StaticResource Caption}" HorizontalAlignment="Center"/>

                        <!-- Vision result Row -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Vision(mm)" VerticalAlignment="Center" FontWeight="Bold"
                                   FontSize="{DynamicResource Nova.FontSize.Body}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource ResultCell}" Text="{Binding VisionX, Mode=OneWay}"/>
                        <TextBox Grid.Row="1" Grid.Column="3" Style="{StaticResource ResultCell}" Text="{Binding VisionY, Mode=OneWay}"/>
                        <TextBox Grid.Row="1" Grid.Column="5" Style="{StaticResource ResultCell}" Text="{Binding VisionZ, Mode=OneWay}"/>

                        <!-- Iteration Row -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Iteration" VerticalAlignment="Center" FontWeight="Bold"
                                   FontSize="{DynamicResource Nova.FontSize.Body}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="5" Height="34" Margin="0,4" MaxLength="3"
                                 VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                 Text="{Binding Iteration, Mode=TwoWay}"
                                 IsEnabled="{Binding CanEdit}"/>
                    </Grid>

                    <!-- Static or Dynamic Group (Off gives the machine back to production) -->
                    <Border Background="{DynamicResource SecondaryRegionBrush}" CornerRadius="8" Padding="16,12" Margin="0,0,0,14"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Static or Dynamic" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" IsEnabled="{Binding CanEdit}">
                                <RadioButton Content="Off" GroupName="StaticDynamicGroup" Margin="0,0,40,0"
                                             IsChecked="{Binding IsOff, Mode=TwoWay}" VerticalContentAlignment="Center"
                                             FontSize="{DynamicResource Nova.FontSize.Body}"/>
                                <RadioButton Content="Static" GroupName="StaticDynamicGroup" Margin="0,0,40,0"
                                             IsChecked="{Binding IsStatic, Mode=TwoWay}" VerticalContentAlignment="Center"
                                             FontSize="{DynamicResource Nova.FontSize.Body}"/>
                                <RadioButton Content="Dynamic" GroupName="StaticDynamicGroup"
                                             IsChecked="{Binding IsDynamic, Mode=TwoWay}" VerticalContentAlignment="Center"
                                             FontSize="{DynamicResource Nova.FontSize.Body}"/>
                            </StackPanel>
                            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" TextAlignment="Center"
                                       FontSize="{DynamicResource Nova.FontSize.Caption}"
                                       Text="{Binding ModeText}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ProductionSuspended}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Choose Camera Group: the cameras the PLC serves -->
                    <Border Background="{DynamicResource SecondaryRegionBrush}" CornerRadius="8" Padding="16,12" Margin="0,0,0,20"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Choose Camera" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding Cameras}" HorizontalAlignment="Center"
                                          IsEnabled="{Binding CanEdit}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton Content="{Binding Name}" GroupName="StaticDynamicCamera" Margin="18,0"
                                                     IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                     VerticalContentAlignment="Center"
                                                     FontSize="{DynamicResource Nova.FontSize.Body}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- The run needs the machine in AUTO -->
                    <TextBlock Margin="0,0,0,12" TextWrapping="Wrap"
                               FontSize="{DynamicResource Nova.FontSize.Caption}"
                               Foreground="{DynamicResource WarningBrush}"
                               Text="{Binding AutoHint}"
                               Visibility="{Binding NeedsAuto, Converter={StaticResource BoolToVisibility}}"/>

                    <!-- Start / End / Stop Actions -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource StartButton}" Command="{Binding StartCommand}"
                                IsEnabled="{Binding CanStart}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="Play" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Start" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource ProcButton}" Command="{Binding EndCommand}"
                                IsEnabled="{Binding CanFinish}" ToolTip="Finish after the vision command now running">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="CircleCheck" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="End" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="4" Style="{StaticResource StopButton}" Command="{Binding StopCommand}"
                                IsEnabled="{Binding CanFinish}" ToolTip="Abort now">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="Square" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Stop" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Status Display: the PLC's CURRENT STATUS -->
                    <Border Background="{DynamicResource SecondaryRegionBrush}" CornerRadius="8" Padding="16,12"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="CURRENT STATUS" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap"
                                       FontSize="{DynamicResource Nova.FontSize.Body}" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusKind}" Value="Idle">
                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusKind}" Value="Running">
                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusKind}" Value="Done">
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusKind}" Value="Error">
                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Margin="0,4,0,0" Text="{Binding ProgressText}"
                                       FontSize="{DynamicResource Nova.FontSize.Caption}"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                                       FontSize="{DynamicResource Nova.FontSize.Caption}"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="After a fault, press RESET (Manual &gt; Log), then START the machine: the PLC sends the vision command again."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
