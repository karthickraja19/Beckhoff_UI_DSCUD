<UserControl x:Class="Nova.Wpf.App.Views.Pages.Audio.AudioDataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:converters="clr-namespace:Nova.Wpf.App.Converters"
             FontFamily="{DynamicResource Audio.FontFamily}"
             Background="Transparent">

    <!-- ================================================================== -->
    <!-- DATA PAGE   Audio SW DFM v5.4 slides 59 (I/O) and 60 (Tossing)     -->
    <!-- Slide requirements: Filter time, IO/Tossing, Data Export.           -->
    <!-- Slide layout: 4/5 width charts + unit table, 1/5 width summary.     -->
    <!-- ================================================================== -->

    <UserControl.Resources>
        <converters:BoolToBrushKeyConverter x:Key="BoolToBrushKey"/>
        <converters:AudioBoolToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- I/O | Tossing + time filter -->
            <RowDefinition Height="*"/>      <!-- charts / table / summary -->
        </Grid.RowDefinitions>

        <!-- Filter row -->
        <Border Grid.Row="0" Style="{StaticResource Audio.Card}" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ListBox Grid.Column="0"
                         Style="{StaticResource Audio.SegmentedControl}"
                         ItemsSource="{Binding Views}"
                         SelectedItem="{Binding SelectedView, Mode=TwoWay}"
                         AutomationProperties.Name="Data view"/>

                <TextBlock Grid.Column="1" Style="{StaticResource Audio.FieldLabel}"
                           Text="From:" Margin="20,0,8,0"/>
                <hc:DateTimePicker Grid.Column="2" Width="175" Height="28"
                                   SelectedDateTime="{Binding StartTime, Mode=TwoWay}"/>

                <TextBlock Grid.Column="3" Style="{StaticResource Audio.FieldLabel}"
                           Text="To:" Margin="14,0,8,0"/>
                <hc:DateTimePicker Grid.Column="4" Width="175" Height="28"
                                   SelectedDateTime="{Binding EndTime, Mode=TwoWay}"/>

                <Button Grid.Column="5" Style="{StaticResource Audio.FilledButton}"
                        Content="Query" Margin="16,0,0,0"
                        Command="{Binding RefreshCommand}"/>

                <TextBlock Grid.Column="6" Style="{StaticResource Audio.Footnote}"
                           Text="{Binding StatusText}" Margin="16,0,0,0"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*"/>   <!-- slide 59: 4/5 width -->
                <ColumnDefinition Width="1*"/>   <!-- slide 59: 1/5 width -->
            </Grid.ColumnDefinitions>

            <!-- Charts over the unit table -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="1.4*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Audio.Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource Audio.Footnote}"
                                   Text="{Binding RateSeriesLabel}" Margin="16,10,16,0"/>
                        <lvc:CartesianChart Grid.Row="1" Margin="12,4,16,10"
                                            Series="{Binding RateSeries}"
                                            XAxes="{Binding SharedXAxes}"
                                            YAxes="{Binding RateYAxes}"
                                            TooltipPosition="Top"
                                            LegendPosition="Hidden"/>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Audio.Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource Audio.Footnote}"
                                   Text="{Binding VolumeSeriesLabel}" Margin="16,10,16,0"/>
                        <lvc:CartesianChart Grid.Row="1" Margin="12,4,16,10"
                                            Series="{Binding VolumeSeries}"
                                            XAxes="{Binding SharedXAxes}"
                                            YAxes="{Binding VolumeYAxes}"
                                            TooltipPosition="Top"
                                            LegendPosition="Hidden"/>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Audio.Card}">
                    <DataGrid Style="{StaticResource Audio.DataGrid}"
                              ItemsSource="{Binding Units}"
                              Margin="8">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource Audio.DataGridRow}">
                                <Style.Triggers>
                                    <!-- Slide 43's rule carried through to the unit table:
                                         a failing unit is red wherever it appears. -->
                                    <DataTrigger Binding="{Binding IsFail}" Value="True">
                                        <Setter Property="Background"
                                                Value="{DynamicResource Audio.UnitSn.FailBrush}"/>
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource Audio.UnitSn.FailForegroundBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="100"/>
                            <DataGridTextColumn Header="Shift" Binding="{Binding Shift}" Width="60"/>
                            <DataGridTextColumn Header="Unit SN" Binding="{Binding UnitSn}" Width="*"/>
                            <DataGridTextColumn Header="Component SN" Binding="{Binding ComponentSn}" Width="120"/>
                            <DataGridTextColumn Header="Start Time" Binding="{Binding StartTime}" Width="110"/>
                            <DataGridTextColumn Header="End Time" Binding="{Binding EndTime}" Width="110"/>
                            <DataGridTextColumn Header="Pass" Binding="{Binding PassText}" Width="70"/>
                            <DataGridTextColumn Header="CT/s" Binding="{Binding CycleTimeText}" Width="70"/>
                            <DataGridTextColumn Header="HIVE State" Binding="{Binding HiveStateText}" Width="90"/>
                            <DataGridTextColumn Header="Tossing" Binding="{Binding TossingText}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

            <!-- Summary column -->
            <Border Grid.Column="1" Style="{StaticResource Audio.Card}">
                <Grid Margin="14,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>   <!-- unit SN banner -->
                        <RowDefinition Height="Auto"/>   <!-- Hourly | Daily -->
                        <RowDefinition Height="*"/>      <!-- summaries -->
                        <RowDefinition Height="Auto"/>   <!-- Export -->
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" MinHeight="44"
                            CornerRadius="{DynamicResource Audio.Radius.Field}"
                            Background="{Binding LastUnitPassed,
                                                 Converter={StaticResource BoolToBrushKey},
                                                 ConverterParameter='Audio.UnitSn.PassBrush|Audio.UnitSn.FailBrush'}">
                        <TextBlock Style="{StaticResource Audio.Title3}"
                                   Text="{Binding LastUnitSn}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{Binding LastUnitPassed,
                                                        Converter={StaticResource BoolToBrushKey},
                                                        ConverterParameter='Audio.UnitSn.PassForegroundBrush|Audio.UnitSn.FailForegroundBrush'}"/>
                    </Border>

                    <ListBox Grid.Row="1" Margin="0,10,0,0"
                             HorizontalAlignment="Stretch"
                             Style="{StaticResource Audio.SegmentedControl}"
                             ItemsSource="{Binding Buckets}"
                             SelectedItem="{Binding SelectedBucket, Mode=TwoWay}"
                             AutomationProperties.Name="Time bucket"/>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Audio.Headline}"
                                       Text="I/O Summary" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding IoSummary}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Style="{StaticResource Audio.Footnote}"
                                                       Text="{Binding Label}"/>
                                            <TextBlock Grid.Column="1" Style="{StaticResource Audio.CalloutMono}"
                                                       Text="{Binding Value}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Style="{StaticResource Audio.Headline}"
                                       Text="Tossing Summary" HorizontalAlignment="Center"
                                       Margin="0,16,0,6"/>
                            <ItemsControl ItemsSource="{Binding TossingSummary}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Style="{StaticResource Audio.Caption1}"
                                                       Text="{Binding Label}" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Column="1" Style="{StaticResource Audio.Caption1Mono}"
                                                       Text="{Binding Value}" Margin="8,0,0,0"
                                                       VerticalAlignment="Top"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <Button Grid.Row="3" Style="{StaticResource Audio.Button}"
                            Content="Export" Margin="0,10,0,0"
                            HorizontalAlignment="Stretch"
                            Command="{Binding ExportCommand}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
