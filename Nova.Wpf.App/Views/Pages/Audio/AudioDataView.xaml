<UserControl x:Class="Nova.Wpf.App.Views.Pages.Audio.AudioDataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:loc="clr-namespace:Nova.Wpf.UI.Localization;assembly=Nova.Wpf.UI"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:behaviors="clr-namespace:Nova.Wpf.UI.Behaviors;assembly=Nova.Wpf.UI"
             xmlns:converters="clr-namespace:Nova.Wpf.App.Converters"
             FontFamily="{DynamicResource Audio.FontFamily}"
             Background="Transparent">

    <!-- ================================================================== -->
    <!-- DATA PAGE   Audio SW DFM v5.4 slides 59 (I/O) and 60 (Tossing),    -->
    <!-- plus Yield, Health (S2.4.4.4) and Glue (S2.4.4.5) for a dispenser. -->
    <!-- Slide requirements: Filter time, IO/Tossing, Data Export.           -->
    <!-- Slide layout: 4/5 width tab content + 1/5 width summary column;     -->
    <!-- Health alone spans the full width, as S2.4.4.4 draws it.           -->
    <!-- ================================================================== -->

    <UserControl.Resources>
        <converters:BoolToBrushKeyConverter x:Key="BoolToBrushKey"/>
        <converters:AudioBoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:HealthLevelToBrushConverter x:Key="HealthLevelToBrush"/>
        <converters:RatioToStarConverter x:Key="RatioToStar"/>

        <!-- A failing unit or weighing is red wherever it appears (slide 43's rule). -->
        <Style x:Key="Data.FailAwareRow" TargetType="DataGridRow" BasedOn="{StaticResource Audio.DataGridRow}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFail}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Audio.UnitSn.FailBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource Audio.UnitSn.FailForegroundBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Label over a value, used by the summary blocks. -->
        <DataTemplate x:Key="Data.SummaryRow">
            <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource Audio.Footnote}" Text="{loc:TrBinding Label}" TextWrapping="Wrap"/>
                <TextBlock Grid.Column="1" Style="{StaticResource Audio.CalloutMono}" Text="{Binding Value}" Margin="8,0,0,0"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="Data.TossingRow">
            <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource Audio.Caption1}" Text="{loc:TrBinding Label}" TextWrapping="Wrap"/>
                <TextBlock Grid.Column="1" Style="{StaticResource Audio.Caption1Mono}" Text="{Binding Value}"
                           Margin="8,0,0,0" VerticalAlignment="Top"/>
            </Grid>
        </DataTemplate>

        <Style x:Key="Data.CardTitle" TargetType="TextBlock" BasedOn="{StaticResource Audio.Headline}">
            <Setter Property="Margin" Value="16,12,16,0"/>
        </Style>

        <Style x:Key="Data.Note" TargetType="TextBlock" BasedOn="{StaticResource Audio.Footnote}">
            <Setter Property="Foreground" Value="{DynamicResource Audio.Text.SecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="Data.Error" TargetType="TextBlock" BasedOn="{StaticResource Audio.Footnote}">
            <Setter Property="Foreground" Value="{DynamicResource Audio.System.RedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- The spec tables (S2.4.4.4, S2.4.4.5 settings): a header band, then rows,
             with every cell centred and wrapping as the spec's tables are. -->
        <Style x:Key="Data.TableHead" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Audio.Surface.RecessedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Audio.SeparatorBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="Data.TableRow" TargetType="Border">
            <Setter Property="MinHeight" Value="{DynamicResource Audio.Row.Height}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Audio.Separator.SubtleBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="Data.HeadCell" TargetType="TextBlock" BasedOn="{StaticResource Audio.TableHeaderText}">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="None"/>
            <Setter Property="Margin" Value="3,5"/>
        </Style>

        <Style x:Key="Data.Cell" TargetType="TextBlock" BasedOn="{StaticResource Audio.CalloutMono}">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="3,6"/>
        </Style>

        <!-- Glue raw data: ten columns in half the page width. -->
        <Style x:Key="Data.CompactCell" TargetType="DataGridCell" BasedOn="{StaticResource Audio.DataGridCell}">
            <Setter Property="FontSize" Value="{DynamicResource Audio.FontSize.Footnote}"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>

        <Style x:Key="Data.CompactHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource Audio.DataGridColumnHeader}">
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Height" Value="30"/>
        </Style>

        <Style x:Key="Data.TextCell" TargetType="TextBlock" BasedOn="{StaticResource Audio.Footnote}">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="10,6"/>
        </Style>

        <!-- S2.4.4.5's regression formulas. -->
        <Style x:Key="Data.Math" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cambria Math"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource Audio.Text.PrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Data.MathLimit" TargetType="TextBlock" BasedOn="{StaticResource Data.Math}">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- One row of a Health colour key: swatch, explanation, minimum, maximum. -->
        <DataTemplate x:Key="Data.LegendRow">
            <Border Style="{StaticResource Data.TableRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="76"/>
                        <ColumnDefinition Width="76"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Margin="6" CornerRadius="3"
                            Background="{Binding Level, Converter={StaticResource HealthLevelToBrush}, ConverterParameter=fill}"/>
                    <TextBlock Grid.Column="1" Style="{StaticResource Data.TextCell}" Text="{loc:TrBinding Detail}"/>
                    <TextBlock Grid.Column="2" Style="{StaticResource Data.Cell}" Text="{loc:TrBinding Minimum}"/>
                    <TextBlock Grid.Column="3" Style="{StaticResource Data.Cell}" Text="{loc:TrBinding Maximum}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Σ with its limits, i = 1 to n. -->
        <DataTemplate x:Key="Data.SumSign">
            <StackPanel Margin="0,0,2,0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Data.MathLimit}" Text="n"/>
                <TextBlock Style="{StaticResource Data.Math}" FontSize="18" HorizontalAlignment="Center" Text="&#x2211;" Margin="0,-4"/>
                <TextBlock Style="{StaticResource Data.MathLimit}" Text="i=1"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- tabs + time filter -->
            <RowDefinition Height="*"/>      <!-- tab content + summary column -->
        </Grid.RowDefinitions>

        <!-- ============================================================== -->
        <!-- FILTER ROW                                                     -->
        <!-- ============================================================== -->
        <Border Grid.Row="0" Style="{StaticResource Audio.Card}" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ListBox Grid.Column="0"
                         Style="{StaticResource Audio.SegmentedControl}"
                         ItemTemplate="{StaticResource Loc.ItemText}"
                         ItemsSource="{Binding Views}"
                         SelectedItem="{Binding SelectedView, Mode=TwoWay}"
                         AutomationProperties.Name="Data view"/>

                <!-- Health is the machine as it is now, so it has no From/To. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding IsTimeFiltered, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource Audio.FieldLabel}" Text="{loc:Tr Txt_From}" Margin="20,0,8,0"/>
                    <hc:DateTimePicker Width="175" Height="28"
                                       SelectedDateTime="{Binding StartTime, Mode=TwoWay}"/>
                    <TextBlock Style="{StaticResource Audio.FieldLabel}" Text="{loc:Tr Txt_To}" Margin="14,0,8,0"/>
                    <hc:DateTimePicker Width="175" Height="28"
                                       SelectedDateTime="{Binding EndTime, Mode=TwoWay}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Audio.FilledButton}"
                            Content="{loc:TrBinding QueryButtonText}" Margin="16,0,0,0"
                            Command="{Binding RefreshCommand}"/>

                    <!-- Health has no summary column, so its Export sits here. -->
                    <Button Style="{StaticResource Audio.Button}"
                            Content="{loc:Tr Txt_Export}" Margin="8,0,0,0"
                            Command="{Binding ExportCommand}"
                            Visibility="{Binding HasSummaryColumn, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"/>

                    <!-- Generated figures are labelled on screen, not just in a comment. -->
                </StackPanel>

                <TextBlock Grid.Column="3" Style="{StaticResource Audio.Footnote}"
                           Text="{loc:TrBinding StatusText}" Margin="16,0,0,0"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           ToolTip="{loc:TrBinding StatusText}"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*"/>   <!-- slide 59: 4/5 width -->
                <ColumnDefinition Width="1*"/>   <!-- slide 59: 1/5 width -->
            </Grid.ColumnDefinitions>

            <!-- ========================================================== -->
            <!-- I/O, TOSSING, YIELD: two charts over the unit table        -->
            <!-- ========================================================== -->
            <Grid Grid.Column="0"
                  Visibility="{Binding IsProductionView, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="1.4*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Audio.Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource Audio.Footnote}"
                                   Text="{loc:TrBinding TopChartTitle}" Margin="16,10,16,0"/>
                        <lvc:CartesianChart Grid.Row="1" Margin="12,4,16,10"
                                            Series="{loc:TrBinding TopSeries, Chart=True}"
                                            XAxes="{loc:TrBinding SharedXAxes, Chart=True}"
                                            YAxes="{loc:TrBinding TopYAxes, Chart=True}"
                                            TooltipPosition="Top"
                                            LegendPosition="Right"/>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Audio.Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource Audio.Footnote}"
                                   Text="{loc:TrBinding BottomChartTitle}" Margin="16,10,16,0"/>
                        <lvc:CartesianChart Grid.Row="1" Margin="12,4,16,10"
                                            Series="{loc:TrBinding BottomSeries, Chart=True}"
                                            XAxes="{loc:TrBinding SharedXAxes, Chart=True}"
                                            YAxes="{loc:TrBinding BottomYAxes, Chart=True}"
                                            TooltipPosition="Top"
                                            LegendPosition="Right"/>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Audio.Card}">
                    <DataGrid Style="{StaticResource Audio.DataGrid}"
                              ItemsSource="{Binding Units}"
                              RowStyle="{StaticResource Data.FailAwareRow}"
                              Margin="8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Tr Txt_Date}" Binding="{Binding Date}" Width="112"/>
                            <DataGridTextColumn Header="{loc:Tr Txt_Shift}" Binding="{Binding Shift}" Width="55"/>
                            <DataGridTextColumn Header="{loc:Tr Txt_Gantry}" Binding="{Binding Gantry}" Width="65"/>
                            <DataGridTextColumn Header="{loc:Tr Txt_UnitSN}" Binding="{Binding UnitSn}" Width="*"/>
                            <DataGridTextColumn Header="{loc:Tr Txt_ComponentSN}" Binding="{Binding ComponentSn}" Width="125"/>
                            <DataGridTextColumn Header="{loc:Tr Txt_StartTime_2}" Binding="{Binding StartTime}" Width="130"/>
                            <DataGridTextColumn Header="{loc:Tr Txt_EndTime_2}" Binding="{Binding EndTime}" Width="130"/>
                            <DataGridTextColumn Header="{loc:Tr Txt_Pass}" Binding="{Binding PassText}" Width="65"/>
                            <DataGridTextColumn Header="{loc:Tr Txt_CTS}" Binding="{Binding CycleTimeText}" Width="65"/>
                            <DataGridTextColumn Header="{loc:Tr Txt_HIVEState}" Binding="{Binding HiveStateText}" Width="85"/>
                            <DataGridTextColumn Header="{loc:Tr Txt_Tossing}" Binding="{Binding TossingText}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

            <!-- ========================================================== -->
            <!-- AXIS (S2.4.4.6 Coordinate Data Analysis)                   -->
            <!--   Point Name / Axis, the statistics and CPK                -->
            <!--   every measurement against LSL / nominal / USL            -->
            <!--   the coordinates, newest first                            -->
            <!-- ========================================================== -->
            <Grid Grid.Column="0" Grid.ColumnSpan="2"
                  Visibility="{Binding IsAxisView, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Audio.Card}" Padding="16,10">
                    <WrapPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Audio.FieldLabel}" Text="{loc:Tr Txt_PointName}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <ComboBox Style="{StaticResource Audio.ComboBox}" Width="120" Margin="0,0,20,0"
                                  ItemsSource="{Binding AxisPoints}" SelectedItem="{Binding SelectedAxisPoint, Mode=TwoWay}"/>
                        <TextBlock Style="{StaticResource Audio.FieldLabel}" Text="{loc:Tr Txt_Axis}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <ComboBox Style="{StaticResource Audio.ComboBox}" Width="90" Margin="0,0,28,0"
                                  ItemsSource="{Binding AxisNames}" SelectedItem="{Binding SelectedAxisName, Mode=TwoWay}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,4,18,0">
                            <TextBlock Style="{StaticResource Audio.Footnote}" Text="{loc:Tr Txt_Count_2}" VerticalAlignment="Center"/>
                            <TextBlock Style="{StaticResource Audio.Headline}" Text="{loc:TrBinding AxisCount}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,18,0">
                            <TextBlock Style="{StaticResource Audio.Footnote}" Text="{loc:Tr Txt_Mean}" VerticalAlignment="Center"/>
                            <TextBlock Style="{StaticResource Audio.Headline}" Text="{loc:TrBinding AxisMean}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,18,0">
                            <TextBlock Style="{StaticResource Audio.Footnote}" Text="&#x3C3; " VerticalAlignment="Center"/>
                            <TextBlock Style="{StaticResource Audio.Headline}" Text="{loc:TrBinding AxisSigma}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,18,0">
                            <TextBlock Style="{StaticResource Audio.Footnote}" Text="{loc:Tr Txt_MinToMax}" VerticalAlignment="Center"/>
                            <TextBlock Style="{StaticResource Audio.Headline}" Text="{loc:TrBinding AxisRange}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,18,0">
                            <TextBlock Style="{StaticResource Audio.Footnote}" Text="{loc:Tr Txt_LSLNominalUSL}" VerticalAlignment="Center"/>
                            <TextBlock Style="{StaticResource Audio.Headline}" Text="{loc:TrBinding AxisLimits}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,18,0">
                            <TextBlock Style="{StaticResource Audio.Footnote}" Text="CPK " VerticalAlignment="Center"/>
                            <TextBlock Style="{StaticResource Audio.Headline}" Text="{loc:TrBinding AxisCpk}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,18,0">
                            <TextBlock Style="{StaticResource Audio.Footnote}" Text="NG " VerticalAlignment="Center"/>
                            <TextBlock Style="{StaticResource Audio.Headline}" Text="{loc:TrBinding AxisNg}"/>
                        </StackPanel>
                    </WrapPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Audio.Card}">
                    <Grid>
                        <lvc:CartesianChart Margin="12,8,16,10"
                                            Series="{loc:TrBinding AxisSeries, Chart=True}"
                                            XAxes="{loc:TrBinding AxisXAxes, Chart=True}"
                                            YAxes="{loc:TrBinding AxisYAxes, Chart=True}"
                                            TooltipPosition="Top"
                                            LegendPosition="Hidden"/>
                        <TextBlock Style="{StaticResource Audio.EmptyState}" Margin="16" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Text="{loc:TrBinding AxisStatus}"
                                   Visibility="{Binding HasAxisData, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"/>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Audio.Card}">
                    <DataGrid behaviors:DataGridStarColumns.RefreshOnShow="True"
                              Style="{StaticResource Audio.DataGrid}"
                              ItemsSource="{Binding AxisRows}" Margin="8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Tr Txt_Time}" Binding="{Binding Time}" Width="170"/>
                            <DataGridTextColumn Header="{loc:Tr Txt_UnitSN}" Binding="{Binding UnitSn}" Width="*"/>
                            <DataGridTextColumn Header="{loc:Tr Txt_Point}" Binding="{Binding Point}" Width="80"/>
                            <DataGridTextColumn Header="{loc:Tr Txt_Axis_2}" Binding="{Binding Axis}" Width="70"/>
                            <DataGridTextColumn Header="{loc:Tr Txt_Value}" Binding="{Binding Value}" Width="110"/>
                            <DataGridTextColumn Header="OK / NG" Binding="{Binding Result}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

            <!-- ========================================================== -->
            <!-- GLUE (S2.4.4.5 slides 2-4)                                 -->
            <!--   SPC trend chart, full width, one per gantry              -->
            <!--   regression diagram       | glue weight raw data          -->
            <!--   regression function      | glue weighing setting         -->
            <!-- ========================================================== -->
            <!-- The Glue and Health tabs start collapsed, and a DataGrid collapsed when
                 first laid out gives its star columns no width. DataGridStarColumns
                 re-applies them when the tab is shown.

                 The grid is the viewport's height, so the six panels fill the screen;
                 MinHeight wins when the viewport is shorter (a small or scaled display),
                 and the tab then scrolls rather than squeezing the charts to nothing. -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsGlueView, Converter={StaticResource BoolToVisibility}}">
            <Grid MinHeight="780"
                  Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>   <!-- S2.4.4.5: 2/5 width -->
                    <ColumnDefinition Width="*"/>   <!-- S2.4.4.5: 2/5 width -->
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.4*"/>   <!-- SPC trend chart -->
                    <RowDefinition Height="*"/>      <!-- regression diagram | raw data -->
                    <RowDefinition Height="Auto"/>   <!-- regression function | weighing setting -->
                </Grid.RowDefinitions>

                <!-- Glue weight SPC trend chart: each gantry with its own path buttons. -->
                <Border Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource Audio.Card}">
                    <Grid Margin="12,6,12,2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*" MinHeight="120"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*" MinHeight="120"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <ListBox Style="{StaticResource Audio.SegmentedControl}" ItemTemplate="{StaticResource Loc.ItemText}"
                                     ItemsSource="{Binding GluePaths}"
                                     SelectedItem="{Binding FrontGluePath, Mode=TwoWay}"
                                     AutomationProperties.Name="Front gantry glue path"/>
                            <TextBlock Style="{StaticResource Audio.Headline}" Text="{loc:Tr Txt_GantryFront}"
                                       Margin="16,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Style="{StaticResource Data.Note}" Text="{loc:TrBinding GlueTrendDateText}"
                                       Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <lvc:CartesianChart Grid.Row="1" Margin="0,2,0,4"
                                            Series="{loc:TrBinding FrontGlueSeries, Chart=True}"
                                            XAxes="{loc:TrBinding FrontGlueXAxes, Chart=True}"
                                            YAxes="{loc:TrBinding FrontGlueYAxes, Chart=True}"
                                            TooltipPosition="Top"
                                            LegendPosition="Hidden"
                                            Visibility="{Binding HasFrontGlue, Converter={StaticResource BoolToVisibility}}"/>
                        <TextBlock Grid.Row="1" Style="{StaticResource Audio.EmptyState}"
                                   Text="{loc:Tr Txt_NoFrontGantryWeighingsForThisPath}"
                                   Visibility="{Binding HasFrontGlue, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"/>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,2,0,0">
                            <ListBox Style="{StaticResource Audio.SegmentedControl}" ItemTemplate="{StaticResource Loc.ItemText}"
                                     ItemsSource="{Binding GluePaths}"
                                     SelectedItem="{Binding RearGluePath, Mode=TwoWay}"
                                     AutomationProperties.Name="Rear gantry glue path"/>
                            <TextBlock Style="{StaticResource Audio.Headline}" Text="{loc:Tr Txt_GantryRear}"
                                       Margin="16,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Style="{StaticResource Data.Note}" Text="{loc:TrBinding GlueTrendDateText}"
                                       Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <lvc:CartesianChart Grid.Row="3" Margin="0,2,0,4"
                                            Series="{loc:TrBinding RearGlueSeries, Chart=True}"
                                            XAxes="{loc:TrBinding RearGlueXAxes, Chart=True}"
                                            YAxes="{loc:TrBinding RearGlueYAxes, Chart=True}"
                                            TooltipPosition="Top"
                                            LegendPosition="Hidden"
                                            Visibility="{Binding HasRearGlue, Converter={StaticResource BoolToVisibility}}"/>
                        <TextBlock Grid.Row="3" Style="{StaticResource Audio.EmptyState}"
                                   Text="{loc:Tr Txt_NoRearGantryWeighingsForThisPath}"
                                   Visibility="{Binding HasRearGlue, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"/>
                    </Grid>
                </Border>

                <!-- Glue weight / speed regression diagram: its own gantry and path buttons. -->
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Audio.Card}">
                    <Grid Margin="12,6,12,2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*" MinHeight="150"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <ListBox Style="{StaticResource Audio.SegmentedControl}" ItemTemplate="{StaticResource Loc.ItemText}"
                                     ItemsSource="{Binding RegressionGantries}"
                                     SelectedItem="{Binding RegressionGantry, Mode=TwoWay}"
                                     AutomationProperties.Name="Regression gantry"/>
                            <ListBox Style="{StaticResource Audio.SegmentedControl}" ItemTemplate="{StaticResource Loc.ItemText}" Margin="12,0,0,0"
                                     ItemsSource="{Binding GluePaths}"
                                     SelectedItem="{Binding RegressionPath, Mode=TwoWay}"
                                     AutomationProperties.Name="Regression glue path"/>
                            <TextBlock Style="{StaticResource Data.Note}" Margin="12,0,0,0" VerticalAlignment="Center"
                                       Text="{loc:TrBinding RegressionCalibratedText}"/>
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <lvc:CartesianChart Margin="0,4,4,0"
                                                Series="{loc:TrBinding RegressionSeries, Chart=True}"
                                                XAxes="{loc:TrBinding RegressionXAxes, Chart=True}"
                                                YAxes="{loc:TrBinding RegressionYAxes, Chart=True}"
                                                TooltipPosition="Top"
                                                LegendPosition="Hidden"
                                                Visibility="{Binding HasRegression, Converter={StaticResource BoolToVisibility}}"/>
                            <!-- The fitted equation and R², printed on the diagram as slide 3
                                 does, in the headroom the weight axis leaves above the points. -->
                            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="64,8,0,0"
                                    Padding="6,2" CornerRadius="{DynamicResource Audio.Radius.Small}"
                                    Background="{DynamicResource Audio.Surface.CardBrush}"
                                    IsHitTestVisible="False"
                                    Visibility="{Binding HasRegression, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Audio.CalloutMono}"
                                               Foreground="{DynamicResource Audio.System.BlueBrush}"
                                               Text="{loc:TrBinding RegressionEquation}"/>
                                    <TextBlock Style="{StaticResource Audio.CalloutMono}"
                                               Foreground="{DynamicResource Audio.System.BlueBrush}"
                                               Text="{loc:TrBinding RegressionR2Text}"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Style="{StaticResource Audio.EmptyState}"
                                       Text="{loc:Tr Txt_NoCalibrationHasBeenRecordedForThis}"
                                       Visibility="{Binding HasRegression, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Glue weight raw data. -->
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Audio.Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="16,8,16,0">
                            <TextBlock Style="{StaticResource Audio.Headline}" Text="{loc:Tr Txt_GlueWeightRawData}"/>
                            <TextBlock Style="{StaticResource Data.Note}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Text="{loc:Tr Txt_GlueWeightSPECInMg}"/>
                        </Grid>
                        <!-- Ten columns in half the width: the footnote size and tight
                             padding keep every value whole. -->
                        <DataGrid behaviors:DataGridStarColumns.RefreshOnShow="True"
                                  Grid.Row="1" Style="{StaticResource Audio.DataGrid}"
                                  ItemsSource="{Binding GlueWeighings}"
                                  RowStyle="{StaticResource Data.FailAwareRow}"
                                  CellStyle="{StaticResource Data.CompactCell}"
                                  ColumnHeaderStyle="{StaticResource Data.CompactHeader}"
                                  RowHeight="28"
                                  Margin="6">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Tr Txt_Date}" Binding="{Binding Date}" Width="1.3*"/>
                                <DataGridTextColumn Header="{loc:Tr Txt_Time}" Binding="{Binding Time}" Width="1.1*"/>
                                <DataGridTextColumn Header="{loc:Tr Txt_Shift}" Binding="{Binding Shift}" Width="0.6*"/>
                                <DataGridTextColumn Header="{loc:Tr Txt_Gantry}" Binding="{Binding Gantry}" Width="0.85*"/>
                                <DataGridTextColumn Header="{loc:Tr Txt_Path}" Binding="{Binding PathNumberText}" Width="0.55*"/>
                                <DataGridTextColumn Header="{loc:Tr Txt_Speed}" Binding="{Binding SpeedText}" Width="1*"/>
                                <DataGridTextColumn Header="{loc:Tr Txt_Value}" Binding="{Binding WeightText}" Width="0.85*"/>
                                <DataGridTextColumn Header="LSL" Binding="{Binding LowerLimitText}" Width="0.6*"/>
                                <DataGridTextColumn Header="USL" Binding="{Binding UpperLimitText}" Width="0.6*"/>
                                <DataGridTextColumn Header="{loc:Tr Txt_Result}" Binding="{Binding ResultText}" Width="0.8*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Regression function: how the line is fitted (S2.4.4.5 slide 3). -->
                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Audio.Card}" Padding="16,10,16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource Audio.Headline}" Text="{loc:Tr Txt_RegressionCalibration}"/>
                            <TextBlock Style="{StaticResource Audio.Footnote}" Margin="0,6,0,0" Text="{loc:Tr Txt_LeastSquareMethod}"/>
                            <TextBlock Style="{StaticResource Audio.Footnote}" Margin="14,2,0,0">
                                <Run Text="{loc:Tr Txt_10xPointsToFormRegressionFormula}"/>
                                <Run Text="y = a x + b" FontFamily="Cambria Math" FontStyle="Italic"/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource Audio.Footnote}" Margin="14,2,0,0" Text="{loc:Tr Txt_YGlueWeight}"/>
                            <TextBlock Style="{StaticResource Audio.Footnote}" Margin="14,2,0,0" Text="{loc:Tr Txt_XDispensingSpeed}"/>
                        </StackPanel>

                        <Border Grid.Column="1" Margin="16,0,0,0" Padding="16,0,4,0"
                                BorderBrush="{DynamicResource Audio.SeparatorBrush}" BorderThickness="1,0,0,0">
                            <StackPanel VerticalAlignment="Center">
                                <!-- a = Σ(xi − x̄)(yi − ȳ) / Σ(xi − x̄)² -->
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Data.Math}" Text="a =" Margin="0,0,8,0"/>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <ContentPresenter Content="" ContentTemplate="{StaticResource Data.SumSign}"/>
                                            <TextBlock Style="{StaticResource Data.Math}"
                                                       Text="(x&#x1D62; &#x2212; x&#x0304;)(y&#x1D62; &#x2212; &#x0233;)"/>
                                        </StackPanel>
                                        <Border Height="1" Margin="0,2" Background="{DynamicResource Audio.Text.PrimaryBrush}"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <ContentPresenter Content="" ContentTemplate="{StaticResource Data.SumSign}"/>
                                            <TextBlock Style="{StaticResource Data.Math}"
                                                       Text="(x&#x1D62; &#x2212; x&#x0304;)&#xB2;"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Data.Math}" Margin="0,8,0,0"
                                           Text="b = &#x0233; &#x2212; a x&#x0304;"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Glue weighing setting: S2.4.4.5's Item | Settings table. Edit turns
                     the Settings column into fields; the SOP's unit-count and shift
                     triggers are rows of their own, shown when on or while editing. -->
                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource Audio.Card}" Padding="12,8,12,10">
                    <StackPanel>
                        <!-- The table's merged title row, as the slide draws it, with Edit on it. -->
                        <Border Style="{StaticResource Data.TableHead}">
                            <Grid Margin="8,3">
                                <TextBlock Style="{StaticResource Audio.Headline}" Text="{loc:Tr Txt_GlueWeighingSetting}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource Audio.Button}" Content="{loc:Tr Txt_Edit}"
                                            Command="{Binding EditWeighingSettingsCommand}"
                                            ToolTip="{loc:Tr Txt_Level2Or3ToChange}"
                                            ToolTipService.ShowOnDisabled="True"
                                            Visibility="{Binding IsEditingWeighing, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"/>
                                    <Button Style="{StaticResource Audio.Button}" Content="{loc:Tr Txt_Cancel}" Margin="0,0,8,0"
                                            Command="{Binding CancelWeighingSettingsCommand}"
                                            Visibility="{Binding IsEditingWeighing, Converter={StaticResource BoolToVisibility}}"/>
                                    <Button Style="{StaticResource Audio.FilledButton}" Content="{loc:Tr Txt_Save}"
                                            Command="{Binding SaveWeighingSettingsCommand}"
                                            Visibility="{Binding IsEditingWeighing, Converter={StaticResource BoolToVisibility}}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <StackPanel Visibility="{Binding HasWeighingSettings, Converter={StaticResource BoolToVisibility}}">
                            <Border Style="{StaticResource Data.TableHead}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="1.4*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource Data.HeadCell}" Text="{loc:Tr Txt_Item}"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource Data.HeadCell}" Text="{loc:Tr Txt_Settings}"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource Data.TableRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="1.4*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Data.TextCell}" Text="{loc:Tr Txt_WeighingFrequency}"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource Data.Cell}" Text="{loc:TrBinding WeighingFrequencyText}"
                                               Visibility="{Binding IsEditingWeighing, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,3"
                                                Visibility="{Binding IsEditingWeighing, Converter={StaticResource BoolToVisibility}}">
                                        <CheckBox IsChecked="{Binding WeighByTime}" VerticalAlignment="Center" Margin="0,0,8,0"
                                                  AutomationProperties.Name="Weigh by time"/>
                                        <TextBox Style="{StaticResource Audio.TextBoxMono}" IsReadOnly="False" Width="70"
                                                 behaviors:NumericInput.Mode="Decimal"
                                                 IsEnabled="{Binding WeighByTime}"
                                                 Text="{Binding WeighIntervalHours, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="Weighing frequency in hours"/>
                                        <TextBlock Style="{StaticResource Audio.Footnote}" Text="{loc:Tr Txt_HoursOneTime}"
                                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource Data.TableRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="1.4*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Data.TextCell}" Text="{loc:Tr Txt_WeighingTimes}"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource Data.Cell}" Text="{loc:TrBinding WeighingTimesText}"
                                               Visibility="{Binding IsEditingWeighing, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource Audio.TextBoxMono}" IsReadOnly="False" Width="70"
                                             Margin="0,3" HorizontalAlignment="Center"
                                             behaviors:NumericInput.Mode="Integer"
                                             Text="{Binding WeighShots, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Weighing times"
                                             Visibility="{Binding IsEditingWeighing, Converter={StaticResource BoolToVisibility}}"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource Data.TableRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="1.4*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Data.TextCell}" Text="{loc:Tr Txt_CalibrationFrequency}"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource Data.Cell}" Text="{loc:TrBinding CalibrationFrequencyText}"
                                               Visibility="{Binding IsEditingWeighing, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,3"
                                                Visibility="{Binding IsEditingWeighing, Converter={StaticResource BoolToVisibility}}">
                                        <TextBox Style="{StaticResource Audio.TextBoxMono}" IsReadOnly="False" Width="70"
                                                 behaviors:NumericInput.Mode="Integer"
                                                 Text="{Binding CalibrationHours, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="Calibration frequency in hours"/>
                                        <TextBlock Style="{StaticResource Audio.Footnote}" Text="{loc:Tr Txt_HoursOneTime}"
                                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource Data.TableRow}"
                                    Visibility="{Binding ShowUnitTriggerRow, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="1.4*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Data.TextCell}" Text="{loc:Tr Txt_WeighingByUnitCount}"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource Data.Cell}" Text="{loc:TrBinding UnitTriggerText}"
                                               Visibility="{Binding IsEditingWeighing, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,3"
                                                Visibility="{Binding IsEditingWeighing, Converter={StaticResource BoolToVisibility}}">
                                        <CheckBox IsChecked="{Binding WeighByUnitCount}" VerticalAlignment="Center" Margin="0,0,8,0"
                                                  AutomationProperties.Name="Weigh by unit count"/>
                                        <TextBox Style="{StaticResource Audio.TextBoxMono}" IsReadOnly="False" Width="70"
                                                 behaviors:NumericInput.Mode="Integer"
                                                 IsEnabled="{Binding WeighByUnitCount}"
                                                 Text="{Binding WeighIntervalUnits, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="Weighing interval in units"/>
                                        <TextBlock Style="{StaticResource Audio.Footnote}" Text="{loc:Tr Txt_UnitsOneTime}"
                                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource Data.TableRow}"
                                    Visibility="{Binding ShowShiftTriggerRow, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="1.4*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Data.TextCell}" Text="{loc:Tr Txt_WeighingAtShiftChange}"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource Data.Cell}" Text="{loc:TrBinding ShiftTriggerText}"
                                               Visibility="{Binding IsEditingWeighing, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6"
                                                Visibility="{Binding IsEditingWeighing, Converter={StaticResource BoolToVisibility}}">
                                        <CheckBox Content="{loc:Tr Txt_ShiftStart}" IsChecked="{Binding WeighAtShiftStart}" Margin="0,0,20,0"/>
                                        <CheckBox Content="{loc:Tr Txt_ShiftEnd}" IsChecked="{Binding WeighAtShiftEnd}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <TextBlock Style="{StaticResource Data.Error}" Margin="0,6,0,0"
                                   Text="{loc:TrBinding WeighingSettingsError}"
                                   Visibility="{Binding WeighingSettingsError, Converter={StaticResource String2VisibilityConverter}}"/>
                        <TextBlock Style="{StaticResource Data.Note}" Margin="0,6,0,0"
                                   Text="{loc:Tr Txt_WeighingSettingsAreNotAvailableTheWeighing}"
                                   Visibility="{Binding HasWeighingSettings, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"/>
                    </StackPanel>
                </Border>
            </Grid>
            </ScrollViewer>

            <!-- ========================================================== -->
            <!-- HEALTH (S2.4.4.4 slide 2), full width                      -->
            <!--   Nozzle Health: bar per gantry; nozzle table | colour key -->
            <!--   Glue Control & Early Warning: bar per gantry | pot life; -->
            <!--     consumption table | colour key                         -->
            <!--   then the dosages and thresholds OSS sets                 -->
            <!-- ========================================================== -->
            <ScrollViewer Grid.Column="0" Grid.ColumnSpan="2" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsHealthView, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>

                    <!-- NOZZLE HEALTH -->
                    <Border Style="{StaticResource Audio.Card}">
                        <StackPanel Margin="16,12,16,14">
                            <TextBlock Style="{StaticResource Audio.Title3}" Text="{loc:Tr Txt_NozzleHealth}"/>

                            <ItemsControl ItemsSource="{Binding Nozzles}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource Audio.Headline}" VerticalAlignment="Center">
                                                <Run Text="{loc:Tr Txt_Gantry_2}"/>
                                                <Run Text="{loc:TrBinding Gantry, Mode=OneWay}"/>
                                            </TextBlock>
                                            <!-- The bar: health as a share of the maintenance period (USL). -->
                                            <Border Grid.Column="1" Height="28" CornerRadius="4"
                                                    Background="{DynamicResource Audio.System.Gray6Brush}"
                                                    BorderBrush="{DynamicResource Audio.SeparatorBrush}" BorderThickness="1">
                                                <Grid>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="{Binding Ratio, Converter={StaticResource RatioToStar}}"/>
                                                            <ColumnDefinition Width="{Binding Ratio, Converter={StaticResource RatioToStar}, ConverterParameter=invert}"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" CornerRadius="3,0,0,3"
                                                                Background="{Binding Level, Converter={StaticResource HealthLevelToBrush}, ConverterParameter=fill}"/>
                                                    </Grid>
                                                    <TextBlock Style="{StaticResource Audio.CalloutMono}" Margin="10,0"
                                                               VerticalAlignment="Center" Text="{loc:TrBinding ValueText}"/>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Gantry | Valve SN | Nozzle ID | Value | LSL | USL -->
                                <StackPanel Grid.Column="0">
                                    <Border Style="{StaticResource Data.TableHead}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="0.8*"/>
                                                <ColumnDefinition Width="2.6*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="0.8*"/>
                                                <ColumnDefinition Width="0.7*"/>
                                                <ColumnDefinition Width="0.7*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Style="{StaticResource Data.HeadCell}" Text="{loc:Tr Txt_Gantry}"/>
                                            <TextBlock Grid.Column="1" Style="{StaticResource Data.HeadCell}" Text="{loc:Tr Txt_ValveSN}"/>
                                            <TextBlock Grid.Column="2" Style="{StaticResource Data.HeadCell}" Text="{loc:Tr Txt_NozzleID}"/>
                                            <TextBlock Grid.Column="3" Style="{StaticResource Data.HeadCell}" Text="{loc:Tr Txt_Value}"/>
                                            <TextBlock Grid.Column="4" Style="{StaticResource Data.HeadCell}" Text="LSL"/>
                                            <TextBlock Grid.Column="5" Style="{StaticResource Data.HeadCell}" Text="USL"/>
                                        </Grid>
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding Nozzles}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource Data.TableRow}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="0.8*"/>
                                                            <ColumnDefinition Width="2.6*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="0.8*"/>
                                                            <ColumnDefinition Width="0.7*"/>
                                                            <ColumnDefinition Width="0.7*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Style="{StaticResource Data.Cell}" Text="{loc:TrBinding Gantry}"/>
                                                        <TextBlock Grid.Column="1" Style="{StaticResource Data.Cell}" Text="{loc:TrBinding ValveSn}"/>
                                                        <TextBlock Grid.Column="2" Style="{StaticResource Data.Cell}" Text="{loc:TrBinding NozzleId}"/>
                                                        <TextBlock Grid.Column="3" Style="{StaticResource Data.Cell}" Text="{loc:TrBinding ValueText}"/>
                                                        <TextBlock Grid.Column="4" Style="{StaticResource Data.Cell}" Text="{loc:TrBinding LowerLimitText}"/>
                                                        <TextBlock Grid.Column="5" Style="{StaticResource Data.Cell}" Text="{loc:TrBinding UpperLimitText}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Style="{StaticResource Audio.EmptyState}" Margin="0,12"
                                               Text="{loc:Tr Txt_NoNozzleHealthFromMES}"
                                               Visibility="{Binding HasNozzles, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"/>
                                </StackPanel>

                                <!-- Colour key, thresholds in hours (PD-12). -->
                                <StackPanel Grid.Column="2">
                                    <Border Style="{StaticResource Data.TableHead}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="56"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="76"/>
                                                <ColumnDefinition Width="76"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.RowSpan="2" Grid.Column="0" Style="{StaticResource Data.HeadCell}" VerticalAlignment="Center" Text="{loc:Tr Txt_Color}"/>
                                            <TextBlock Grid.RowSpan="2" Grid.Column="1" Style="{StaticResource Data.HeadCell}" VerticalAlignment="Center" Text="{loc:Tr Txt_ExplainAndDetail}"/>
                                            <TextBlock Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2" Style="{StaticResource Data.HeadCell}" Text="{loc:Tr Txt_ThresholdHours}"/>
                                            <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Data.HeadCell}" Text="{loc:Tr Txt_Minimum}"/>
                                            <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource Data.HeadCell}" Text="{loc:Tr Txt_Maximum}"/>
                                        </Grid>
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding NozzleLegend}" ItemTemplate="{StaticResource Data.LegendRow}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- GLUE CONTROL & EARLY WARNING -->
                    <Border Style="{StaticResource Audio.Card}">
                        <StackPanel Margin="16,12,16,14">
                            <TextBlock Style="{StaticResource Audio.Title3}" Text="{loc:Tr Txt_GlueControlEarlyWarning}"/>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Remaining glue: a bar per gantry. -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <ItemsControl ItemsSource="{Binding GlueCartridges}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="140"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Style="{StaticResource Audio.Headline}" VerticalAlignment="Center">
                                                        <Run Text="{loc:Tr Txt_Gantry_2}"/>
                                                        <Run Text="{loc:TrBinding Gantry, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <Border Grid.Column="1" Height="28" CornerRadius="4"
                                                            Background="{DynamicResource Audio.System.Gray6Brush}"
                                                            BorderBrush="{DynamicResource Audio.SeparatorBrush}" BorderThickness="1">
                                                        <Border.ToolTip>
                                                            <TextBlock>
                                                                <Run Text="{loc:TrBinding StatusText, Mode=OneWay}"/>
                                                                <LineBreak/>
                                                                <Run Text="{loc:Tr Txt_GlueSN}"/>
                                                                <Run Text="{loc:TrBinding GlueSn, Mode=OneWay}"/>
                                                            </TextBlock>
                                                        </Border.ToolTip>
                                                        <Grid>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="{Binding RemainingRatio, Converter={StaticResource RatioToStar}}"/>
                                                                    <ColumnDefinition Width="{Binding RemainingRatio, Converter={StaticResource RatioToStar}, ConverterParameter=invert}"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Border Grid.Column="0" CornerRadius="3,0,0,3"
                                                                        Background="{Binding Level, Converter={StaticResource HealthLevelToBrush}, ConverterParameter=fill}"/>
                                                            </Grid>
                                                            <TextBlock Style="{StaticResource Audio.CalloutMono}" Margin="10,0"
                                                                       VerticalAlignment="Center" Text="{loc:TrBinding RemainingPercentText}"/>
                                                        </Grid>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Style="{StaticResource Audio.EmptyState}" Margin="0,12"
                                               Text="{loc:Tr Txt_NoGlueCartridgeData}"
                                               Visibility="{Binding HasCartridges, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"/>
                                </StackPanel>

                                <!-- Gantry | Remaining Pot Life of Glue (Hours) | Threshold | Status -->
                                <StackPanel Grid.Column="2">
                                    <Border Style="{StaticResource Data.TableHead}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="0.8*"/>
                                                <ColumnDefinition Width="1.8*"/>
                                                <ColumnDefinition Width="0.9*"/>
                                                <ColumnDefinition Width="1*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Style="{StaticResource Data.HeadCell}" Text="{loc:Tr Txt_Gantry}"/>
                                            <TextBlock Grid.Column="1" Style="{StaticResource Data.HeadCell}" Text="{loc:Tr Txt_RemainingPotLifeOfGlueHours}"/>
                                            <TextBlock Grid.Column="2" Style="{StaticResource Data.HeadCell}" Text="{loc:Tr Txt_Threshold}"/>
                                            <TextBlock Grid.Column="3" Style="{StaticResource Data.HeadCell}" Text="{loc:Tr Txt_Status}"/>
                                        </Grid>
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding PotLife}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource Data.TableRow}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="0.8*"/>
                                                            <ColumnDefinition Width="1.8*"/>
                                                            <ColumnDefinition Width="0.9*"/>
                                                            <ColumnDefinition Width="1*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Style="{StaticResource Data.Cell}" Text="{loc:TrBinding Gantry}"/>
                                                        <TextBlock Grid.Column="1" Style="{StaticResource Data.Cell}" Text="{loc:TrBinding RemainingText}"/>
                                                        <TextBlock Grid.Column="2" Style="{StaticResource Data.Cell}" Text="{loc:TrBinding ThresholdText}"/>
                                                        <Border Grid.Column="3" Margin="4" CornerRadius="3"
                                                                Background="{Binding Level, Converter={StaticResource HealthLevelToBrush}, ConverterParameter=fill}">
                                                            <TextBlock Style="{StaticResource Data.Cell}" FontWeight="SemiBold" Text="{loc:TrBinding StatusText}"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <!-- The consumption table, with the spec's grouped headers. -->
                                <StackPanel Grid.Column="0"
                                            Visibility="{Binding HasCartridges, Converter={StaticResource BoolToVisibility}}">
                                    <Border Style="{StaticResource Data.TableHead}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="0.8*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="0.9*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="0.8*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="0.8*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="0.8*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.RowSpan="2" Grid.Column="0" Style="{StaticResource Data.HeadCell}" VerticalAlignment="Center" Text="{loc:Tr Txt_Gantry}"/>
                                            <TextBlock Grid.RowSpan="2" Grid.Column="1" Style="{StaticResource Data.HeadCell}" VerticalAlignment="Center" Text="{loc:Tr Txt_MaxWeightPerGlueCartridge}"/>
                                            <TextBlock Grid.RowSpan="2" Grid.Column="2" Style="{StaticResource Data.HeadCell}" VerticalAlignment="Center" Text="{loc:Tr Txt_TheoreticalOutputPerCartridge}"/>
                                            <TextBlock Grid.RowSpan="2" Grid.Column="3" Style="{StaticResource Data.HeadCell}" VerticalAlignment="Center" Text="{loc:Tr Txt_GlueWeightPerProduct}"/>

                                            <Border Grid.Row="0" Grid.Column="4" Grid.ColumnSpan="2" BorderBrush="{DynamicResource Audio.Separator.SubtleBrush}" BorderThickness="0,0,0,1">
                                                <TextBlock Style="{StaticResource Data.HeadCell}" Text="{loc:Tr Txt_NormalProduction}"/>
                                            </Border>
                                            <Border Grid.Row="0" Grid.Column="6" Grid.ColumnSpan="3" BorderBrush="{DynamicResource Audio.Separator.SubtleBrush}" BorderThickness="0,0,0,1">
                                                <TextBlock Style="{StaticResource Data.HeadCell}" Text="{loc:Tr Txt_LongPurgeStatistics}"/>
                                            </Border>
                                            <Border Grid.Row="0" Grid.Column="9" Grid.ColumnSpan="3" BorderBrush="{DynamicResource Audio.Separator.SubtleBrush}" BorderThickness="0,0,0,1">
                                                <TextBlock Style="{StaticResource Data.HeadCell}" Text="{loc:Tr Txt_ShortPurgeStatistics}"/>
                                            </Border>
                                            <Border Grid.Row="0" Grid.Column="12" Grid.ColumnSpan="2" BorderBrush="{DynamicResource Audio.Separator.SubtleBrush}" BorderThickness="0,0,0,1">
                                                <TextBlock Style="{StaticResource Data.HeadCell}" Text="{loc:Tr Txt_GlueWeighingStatistics}"/>
                                            </Border>

                                            <TextBlock Grid.Row="1" Grid.Column="4" Style="{StaticResource Data.HeadCell}" Text="{loc:Tr Txt_QtyProduced}"/>
                                            <TextBlock Grid.Row="1" Grid.Column="5" Style="{StaticResource Data.HeadCell}" Text="{loc:Tr Txt_TotalGlueConsumption}"/>
                                            <TextBlock Grid.Row="1" Grid.Column="6" Style="{StaticResource Data.HeadCell}" Text="{loc:Tr Txt_PurgeCycles}"/>
                                            <TextBlock Grid.Row="1" Grid.Column="7" Style="{StaticResource Data.HeadCell}" Text="{loc:Tr Txt_GlueUsagePerPurge}"/>
                                            <TextBlock Grid.Row="1" Grid.Column="8" Style="{StaticResource Data.HeadCell}" Text="{loc:Tr Txt_TotalGlueConsumption}"/>
                                            <TextBlock Grid.Row="1" Grid.Column="9" Style="{StaticResource Data.HeadCell}" Text="{loc:Tr Txt_PurgeCycles}"/>
                                            <TextBlock Grid.Row="1" Grid.Column="10" Style="{StaticResource Data.HeadCell}" Text="{loc:Tr Txt_GlueUsagePerPurge}"/>
                                            <TextBlock Grid.Row="1" Grid.Column="11" Style="{StaticResource Data.HeadCell}" Text="{loc:Tr Txt_TotalGlueConsumption}"/>
                                            <TextBlock Grid.Row="1" Grid.Column="12" Style="{StaticResource Data.HeadCell}" Text="{loc:Tr Txt_WeighingCycles}"/>
                                            <TextBlock Grid.Row="1" Grid.Column="13" Style="{StaticResource Data.HeadCell}" Text="{loc:Tr Txt_TotalGlueConsumption}"/>

                                            <TextBlock Grid.RowSpan="2" Grid.Column="14" Style="{StaticResource Data.HeadCell}" VerticalAlignment="Center" Text="{loc:Tr Txt_RemainingGlueWeight}"/>
                                            <TextBlock Grid.RowSpan="2" Grid.Column="15" Style="{StaticResource Data.HeadCell}" VerticalAlignment="Center" Text="{loc:Tr Txt_EstimatedRemainingOutput}"/>
                                        </Grid>
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding GlueCartridges}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource Data.TableRow}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="0.8*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="0.9*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="0.8*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="0.8*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="0.8*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Style="{StaticResource Data.Cell}" Text="{loc:TrBinding Gantry}"/>
                                                        <TextBlock Grid.Column="1" Style="{StaticResource Data.Cell}" Text="{loc:TrBinding CartridgeText}"/>
                                                        <TextBlock Grid.Column="2" Style="{StaticResource Data.Cell}" Text="{loc:TrBinding TheoreticalOutputText}"/>
                                                        <TextBlock Grid.Column="3" Style="{StaticResource Data.Cell}" Text="{loc:TrBinding GluePerProductText}"/>
                                                        <TextBlock Grid.Column="4" Style="{StaticResource Data.Cell}" Text="{loc:TrBinding ProducedText}"/>
                                                        <TextBlock Grid.Column="5" Style="{StaticResource Data.Cell}" Text="{loc:TrBinding ProductGlueText}"/>
                                                        <TextBlock Grid.Column="6" Style="{StaticResource Data.Cell}" Text="{loc:TrBinding LongPurgeCyclesText}"/>
                                                        <TextBlock Grid.Column="7" Style="{StaticResource Data.Cell}" Text="{loc:TrBinding LongPurgeDoseText}"/>
                                                        <TextBlock Grid.Column="8" Style="{StaticResource Data.Cell}" Text="{loc:TrBinding LongPurgeTotalText}"/>
                                                        <TextBlock Grid.Column="9" Style="{StaticResource Data.Cell}" Text="{loc:TrBinding ShortPurgeCyclesText}"/>
                                                        <TextBlock Grid.Column="10" Style="{StaticResource Data.Cell}" Text="{loc:TrBinding ShortPurgeDoseText}"/>
                                                        <TextBlock Grid.Column="11" Style="{StaticResource Data.Cell}" Text="{loc:TrBinding ShortPurgeTotalText}"/>
                                                        <TextBlock Grid.Column="12" Style="{StaticResource Data.Cell}" Text="{loc:TrBinding WeighingCyclesText}"/>
                                                        <TextBlock Grid.Column="13" Style="{StaticResource Data.Cell}" Text="{loc:TrBinding WeighingTotalText}"/>
                                                        <TextBlock Grid.Column="14" Style="{StaticResource Data.Cell}" Text="{loc:TrBinding RemainingText}"/>
                                                        <TextBlock Grid.Column="15" Style="{StaticResource Data.Cell}" Text="{loc:TrBinding EstimatedOutputText}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- Colour key, thresholds as a share of the cartridge. -->
                                <StackPanel Grid.Column="2">
                                    <Border Style="{StaticResource Data.TableHead}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="56"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="76"/>
                                                <ColumnDefinition Width="76"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.RowSpan="2" Grid.Column="0" Style="{StaticResource Data.HeadCell}" VerticalAlignment="Center" Text="{loc:Tr Txt_Color}"/>
                                            <TextBlock Grid.RowSpan="2" Grid.Column="1" Style="{StaticResource Data.HeadCell}" VerticalAlignment="Center" Text="{loc:Tr Txt_ExplainAndDetail}"/>
                                            <TextBlock Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2" Style="{StaticResource Data.HeadCell}" Text="{loc:Tr Txt_Threshold}"/>
                                            <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Data.HeadCell}" Text="{loc:Tr Txt_Minimum}"/>
                                            <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource Data.HeadCell}" Text="{loc:Tr Txt_Maximum}"/>
                                        </Grid>
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding GlueLegend}" ItemTemplate="{StaticResource Data.LegendRow}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Dosages and thresholds, set by OSS (S2.4.4.4 sections 2.1.3 and 2.1.5). -->
                    <Border Style="{StaticResource Audio.Card}" Padding="16,12">
                        <StackPanel>
                            <Grid>
                                <TextBlock Style="{StaticResource Audio.Headline}" Text="{loc:Tr Txt_GlueControlSettings}"
                                           VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource Audio.Button}" Content="{loc:Tr Txt_Edit}"
                                            Command="{Binding EditGlueControlCommand}"
                                            Visibility="{Binding IsEditingGlueControl, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"/>
                                    <Button Style="{StaticResource Audio.Button}" Content="{loc:Tr Txt_Cancel}" Margin="0,0,8,0"
                                            Command="{Binding CancelGlueControlCommand}"
                                            Visibility="{Binding IsEditingGlueControl, Converter={StaticResource BoolToVisibility}}"/>
                                    <Button Style="{StaticResource Audio.FilledButton}" Content="{loc:Tr Txt_Save}"
                                            Command="{Binding SaveGlueControlCommand}"
                                            Visibility="{Binding IsEditingGlueControl, Converter={StaticResource BoolToVisibility}}"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Style="{StaticResource Data.Note}" Margin="0,4,0,0"
                                       Text="{loc:Tr Txt_Level2Or3ToChangeOSS}"/>

                            <!-- Dosages per gantry -->
                            <Border Style="{StaticResource Audio.ListHeaderRow}" Margin="0,10,0,0">
                                <Grid Margin="8,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource Audio.TableHeaderText}" Text="{loc:Tr Txt_Gantry}"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource Audio.TableHeaderText}" Text="{loc:Tr Txt_MaxWeightPerCartridgeG}" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource Audio.TableHeaderText}" Text="{loc:Tr Txt_GlueWeightPerProductG}" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="3" Style="{StaticResource Audio.TableHeaderText}" Text="{loc:Tr Txt_LongPurgePerPurgeG}" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="4" Style="{StaticResource Audio.TableHeaderText}" Text="{loc:Tr Txt_ShortPurgePerPurgeG}" TextAlignment="Right"/>
                                </Grid>
                            </Border>
                            <ItemsControl ItemsSource="{Binding DosageRows}" IsEnabled="{Binding IsEditingGlueControl}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="8,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Column="0" Style="{StaticResource Audio.Callout}" Text="{loc:TrBinding Gantry}"
                                                       VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="1" Style="{StaticResource Audio.TextBoxMono}" IsReadOnly="False" Margin="4,2,0,2"
                                                     behaviors:NumericInput.Mode="Decimal"
                                                     Text="{Binding CartridgeWeight, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="{Binding Gantry, StringFormat='{}{0} cartridge weight'}"/>
                                            <TextBox Grid.Column="2" Style="{StaticResource Audio.TextBoxMono}" IsReadOnly="False" Margin="4,2,0,2"
                                                     behaviors:NumericInput.Mode="Decimal"
                                                     Text="{Binding GluePerProduct, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="{Binding Gantry, StringFormat='{}{0} glue per product'}"/>
                                            <TextBox Grid.Column="3" Style="{StaticResource Audio.TextBoxMono}" IsReadOnly="False" Margin="4,2,0,2"
                                                     behaviors:NumericInput.Mode="Decimal"
                                                     Text="{Binding LongPurgeDose, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="{Binding Gantry, StringFormat='{}{0} long purge dose'}"/>
                                            <TextBox Grid.Column="4" Style="{StaticResource Audio.TextBoxMono}" IsReadOnly="False" Margin="4,2,0,2"
                                                     behaviors:NumericInput.Mode="Decimal"
                                                     Text="{Binding ShortPurgeDose, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="{Binding Gantry, StringFormat='{}{0} short purge dose'}"/>
                                            <TextBlock Grid.Row="1" Grid.ColumnSpan="5" Style="{StaticResource Data.Error}"
                                                       Text="{loc:TrBinding Error}"
                                                       Visibility="{Binding Error, Converter={StaticResource String2VisibilityConverter}}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Thresholds -->
                            <WrapPanel IsEnabled="{Binding IsEditingGlueControl}" Margin="0,12,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,2,24,2">
                                    <TextBlock Style="{StaticResource Audio.Footnote}" Text="{loc:Tr Txt_LowGlueThreshold}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBox Style="{StaticResource Audio.TextBoxMono}" IsReadOnly="False" Width="70" behaviors:NumericInput.Mode="Decimal"
                                             Text="{Binding LowGluePercent, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Low glue threshold percent"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2,24,2">
                                    <TextBlock Style="{StaticResource Audio.Footnote}" Text="{loc:Tr Txt_ChangeGlueThreshold}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBox Style="{StaticResource Audio.TextBoxMono}" IsReadOnly="False" Width="70" behaviors:NumericInput.Mode="Decimal"
                                             Text="{Binding EmptyGluePercent, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Change glue threshold percent"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2,24,2">
                                    <TextBlock Style="{StaticResource Audio.Footnote}" Text="{loc:Tr Txt_PotLifeThresholdH}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBox Style="{StaticResource Audio.TextBoxMono}" IsReadOnly="False" Width="70" behaviors:NumericInput.Mode="Decimal"
                                             Text="{Binding PotLifeWarningHours, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Pot life warning hours"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2,24,2">
                                    <TextBlock Style="{StaticResource Audio.Footnote}" Text="{loc:Tr Txt_NozzleWarningH}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBox Style="{StaticResource Audio.TextBoxMono}" IsReadOnly="False" Width="70" behaviors:NumericInput.Mode="Decimal"
                                             Text="{Binding NozzleWarningHours, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Nozzle warning hours"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2,24,2">
                                    <TextBlock Style="{StaticResource Audio.Footnote}" Text="{loc:Tr Txt_NozzleCriticalH}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBox Style="{StaticResource Audio.TextBoxMono}" IsReadOnly="False" Width="70" behaviors:NumericInput.Mode="Decimal"
                                             Text="{Binding NozzleCriticalHours, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Nozzle critical hours"/>
                                </StackPanel>
                            </WrapPanel>

                            <TextBlock Style="{StaticResource Data.Error}" Margin="0,6,0,0"
                                       Text="{loc:TrBinding GlueControlError}"
                                       Visibility="{Binding GlueControlError, Converter={StaticResource String2VisibilityConverter}}"/>
                            <TextBlock Style="{StaticResource Data.Note}" Margin="0,6,0,0"
                                       Text="{loc:Tr Txt_GlueControlSettingsAreNotAvailableGlue}"
                                       Visibility="{Binding HasGlueControl, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ========================================================== -->
            <!-- SUMMARY COLUMN (every tab but Health)                       -->
            <!-- ========================================================== -->
            <Border Grid.Column="1" Style="{StaticResource Audio.Card}"
                    Visibility="{Binding HasSummaryColumn, Converter={StaticResource BoolToVisibility}}">
                <Grid Margin="14,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>   <!-- unit SN banner -->
                        <RowDefinition Height="Auto"/>   <!-- Hourly | Daily -->
                        <RowDefinition Height="*"/>      <!-- summaries -->
                        <RowDefinition Height="Auto"/>   <!-- Export -->
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" MinHeight="44"
                            CornerRadius="{DynamicResource Audio.Radius.Field}"
                            Background="{Binding LastUnitPassed,
                                                 Converter={StaticResource BoolToBrushKey},
                                                 ConverterParameter='Audio.UnitSn.PassBrush|Audio.UnitSn.FailBrush'}">
                        <TextBlock Style="{StaticResource Audio.Title3}"
                                   Text="{loc:TrBinding LastUnitSn}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{Binding LastUnitPassed,
                                                        Converter={StaticResource BoolToBrushKey},
                                                        ConverterParameter='Audio.UnitSn.PassForegroundBrush|Audio.UnitSn.FailForegroundBrush'}"/>
                    </Border>

                    <!-- The production tabs' buckets, and Glue's trend (S2.4.4.5 slides 3 and 4). -->
                    <ListBox Grid.Row="1" Margin="0,10,0,0"
                             HorizontalAlignment="Stretch"
                             Style="{StaticResource Audio.SegmentedControl}"
                             ItemTemplate="{StaticResource Loc.ItemText}"
                             ItemsSource="{Binding Buckets}"
                             SelectedItem="{Binding SelectedBucket, Mode=TwoWay}"
                             AutomationProperties.Name="Time bucket"
                             Visibility="{Binding HasBuckets, Converter={StaticResource BoolToVisibility}}"/>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Audio.Headline}"
                                       Text="{loc:Tr Txt_IOSummary}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding IoSummary}" ItemTemplate="{StaticResource Data.SummaryRow}"/>

                            <TextBlock Style="{StaticResource Audio.Headline}"
                                       Text="{loc:Tr Txt_TossingSummary}" HorizontalAlignment="Center"
                                       Margin="0,16,0,6"/>
                            <ItemsControl ItemsSource="{Binding TossingSummary}" ItemTemplate="{StaticResource Data.TossingRow}"/>
                        </StackPanel>
                    </ScrollViewer>

                    <Button Grid.Row="3" Style="{StaticResource Audio.Button}"
                            Content="{loc:Tr Txt_Export}" Margin="0,10,0,0"
                            HorizontalAlignment="Stretch"
                            Command="{Binding ExportCommand}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
