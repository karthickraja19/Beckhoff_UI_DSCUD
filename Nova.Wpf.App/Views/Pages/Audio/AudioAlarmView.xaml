<UserControl x:Class="Nova.Wpf.App.Views.Pages.Audio.AudioAlarmView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:converters="clr-namespace:Nova.Wpf.App.Converters"
             FontFamily="{DynamicResource Audio.FontFamily}"
             Background="Transparent">

    <!-- ================================================================== -->
    <!-- ALARM PAGE   Audio SW DFM v5.4 slide 56                            -->
    <!-- Filter row across the top, then two half-height bands:              -->
    <!--   upper : Downtime Statistic (Top10) table + pie | duration chart   -->
    <!--   lower : the alarm history table                                    -->
    <!-- ================================================================== -->

    <UserControl.Resources>
        <converters:RankToBrushConverter x:Key="RankToBrush"/>
        <converters:AudioBoolToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- filter row -->
            <RowDefinition Height="*"/>      <!-- slide 56: 1/2 height -->
            <RowDefinition Height="*"/>      <!-- slide 56: 1/2 height -->
        </Grid.RowDefinitions>

        <!-- Filter row -->
        <Border Grid.Row="0" Style="{StaticResource Audio.Card}" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Style="{StaticResource Audio.FieldLabel}"
                           Text="Start Time:" Margin="0,0,8,0"/>
                <hc:DateTimePicker Grid.Column="1" Width="180" Height="28"
                                   SelectedDateTime="{Binding StartTime, Mode=TwoWay}"/>

                <TextBlock Grid.Column="2" Style="{StaticResource Audio.FieldLabel}"
                           Text="End Time:" Margin="16,0,8,0"/>
                <hc:DateTimePicker Grid.Column="3" Width="180" Height="28"
                                   SelectedDateTime="{Binding EndTime, Mode=TwoWay}"/>

                <Button Grid.Column="4" Style="{StaticResource Audio.FilledButton}"
                        Content="Query" Margin="16,0,0,0"
                        Command="{Binding QueryCommand}"/>

                <StackPanel Grid.Column="5" Orientation="Horizontal">
                    <Button Style="{StaticResource Audio.Button}"
                            Content="Save" Margin="8,0,0,0"
                            Command="{Binding SaveCommand}"/>

                    <!-- Generated alarms (Simulated mode) are labelled on screen. -->
                    <Border Background="{DynamicResource Audio.System.Gray5Brush}"
                            CornerRadius="{DynamicResource Audio.Radius.Small}"
                            Padding="10,3" Margin="12,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding IsSampleData, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="HardwareMode is Simulated: these alarms are generated, not recorded by the machine.">
                        <TextBlock Style="{StaticResource Audio.Footnote}" Text="Sample data"/>
                    </Border>
                </StackPanel>

                <!-- Why the panels show what they show. An empty page always says so
                     here rather than only in a dialog the operator may have dismissed. -->
                <TextBlock Grid.Column="6" Style="{StaticResource Audio.Footnote}"
                           Text="{Binding StatusText}"
                           Margin="16,0,0,0"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Upper band -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Downtime Statistic (Top10): table beside the pie it colours -->
            <Border Grid.Column="0" Style="{StaticResource Audio.Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource Audio.Title3}"
                               Text="Downtime Statistic (Top10)" Margin="16,12,16,8"/>

                    <Grid Grid.Row="1" Margin="16,0,16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Style="{StaticResource Audio.ListHeaderRow}">
                                <Grid Margin="8,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="96"/>
                                        <ColumnDefinition Width="72"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" Style="{StaticResource Audio.TableHeaderText}" Text="Error"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource Audio.TableHeaderText}"
                                               Text="Total Time (Min)" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="3" Style="{StaticResource Audio.TableHeaderText}"
                                               Text="Count Total" TextAlignment="Right"/>
                                </Grid>
                            </Border>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding DowntimeTop10}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Audio.ListRow}">
                                                <Grid Margin="8,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="14"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="96"/>
                                                        <ColumnDefinition Width="72"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- The swatch is what ties the row to
                                                         its slice, so it uses the same
                                                         rank-indexed DFM Top 10 colour. -->
                                                    <Rectangle Grid.Column="0" Width="10" Height="10"
                                                               RadiusX="2" RadiusY="2"
                                                               VerticalAlignment="Center"
                                                               Fill="{Binding Rank, Converter={StaticResource RankToBrush}}"/>

                                                    <TextBlock Grid.Column="1" Style="{StaticResource Audio.Callout}"
                                                               Text="{Binding ErrorName}" Margin="8,0,0,0"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="2" Style="{StaticResource Audio.CalloutMono}"
                                                               Text="{Binding TotalMinutesText}" TextAlignment="Right"/>
                                                    <TextBlock Grid.Column="3" Style="{StaticResource Audio.CalloutMono}"
                                                               Text="{Binding OccurrencesText}" TextAlignment="Right"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <lvc:PieChart Grid.Column="1" Width="220"
                                      Series="{Binding DowntimePieSeries}"
                                      LegendPosition="Hidden"
                                      Margin="12,0,0,0"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Alarm durations -->
            <Border Grid.Column="1" Style="{StaticResource Audio.Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource Audio.Title3}"
                               Text="Alarm Durations" Margin="16,12,16,8"/>

                    <lvc:CartesianChart Grid.Row="1" Margin="12,0,16,12"
                                        Series="{Binding DurationSeries}"
                                        XAxes="{Binding DurationXAxes}"
                                        YAxes="{Binding DurationYAxes}"
                                        TooltipPosition="Top"
                                        LegendPosition="Hidden"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Alarm history -->
        <Border Grid.Row="2" Style="{StaticResource Audio.Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Style="{StaticResource Audio.Title3}"
                           Text="Alarm History" Margin="16,12,16,8"/>

                <DataGrid Grid.Row="1" Style="{StaticResource Audio.DataGrid}"
                          ItemsSource="{Binding AlarmRows}"
                          Margin="8,0,8,8">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="110"/>
                        <DataGridTextColumn Header="Start Time" Binding="{Binding StartTime}" Width="190"/>
                        <DataGridTextColumn Header="End Time" Binding="{Binding EndTime}" Width="190"/>
                        <DataGridTextColumn Header="Time in State (Min)" Binding="{Binding TimeInStateText}" Width="140"/>
                        <DataGridTextColumn Header="Error Code" Binding="{Binding ErrorCode}" Width="140"/>
                        <DataGridTextColumn Header="Error Message" Binding="{Binding ErrorMessage}" Width="180"/>
                        <DataGridTextColumn Header="Error Detail" Binding="{Binding ErrorDetail}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
