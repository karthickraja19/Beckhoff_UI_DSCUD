<UserControl x:Class="Nova.Wpf.App.Views.Pages.Audio.AudioAlarmView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:loc="clr-namespace:Nova.Wpf.UI.Localization;assembly=Nova.Wpf.UI"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:converters="clr-namespace:Nova.Wpf.App.Converters"
             FontFamily="{DynamicResource Audio.FontFamily}"
             Background="Transparent">

    <!-- ================================================================== -->
    <!-- ALARM PAGE   Audio SW DFM v5.4 slide 56                            -->
    <!-- Filter row across the top, then two half-height bands:              -->
    <!--   upper : Downtime Statistic (Top10) table + pie | duration chart   -->
    <!--   lower : the alarm history table                                    -->
    <!-- ================================================================== -->

    <UserControl.Resources>
        <converters:RankToBrushConverter x:Key="RankToBrush"/>
        <converters:AudioBoolToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- filter row -->
            <RowDefinition Height="*"/>      <!-- slide 56: 1/2 height -->
            <RowDefinition Height="*"/>      <!-- slide 56: 1/2 height -->
        </Grid.RowDefinitions>

        <!-- Filter row -->
        <Border Grid.Row="0" Style="{StaticResource Audio.Card}" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Style="{StaticResource Audio.FieldLabel}"
                           Text="{loc:Tr Txt_StartTime}" Margin="0,0,8,0"/>
                <hc:DateTimePicker Grid.Column="1" Width="180" Height="28"
                                   SelectedDateTime="{Binding StartTime, Mode=TwoWay}"/>

                <TextBlock Grid.Column="2" Style="{StaticResource Audio.FieldLabel}"
                           Text="{loc:Tr Txt_EndTime}" Margin="16,0,8,0"/>
                <hc:DateTimePicker Grid.Column="3" Width="180" Height="28"
                                   SelectedDateTime="{Binding EndTime, Mode=TwoWay}"/>

                <Button Grid.Column="4" Style="{StaticResource Audio.FilledButton}"
                        Content="{loc:Tr Txt_Query}" Margin="16,0,0,0"
                        Command="{Binding QueryCommand}"/>

                <StackPanel Grid.Column="5" Orientation="Horizontal">
                    <Button Style="{StaticResource Audio.Button}"
                            Content="{loc:Tr Txt_Save}" Margin="8,0,0,0"
                            Command="{Binding SaveCommand}"/>

                </StackPanel>

                <!-- Why the panels show what they show. An empty page always says so
                     here rather than only in a dialog the operator may have dismissed. -->
                <TextBlock Grid.Column="6" Style="{StaticResource Audio.Footnote}"
                           Text="{loc:TrBinding StatusText}"
                           Margin="16,0,0,0"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Upper band -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Downtime Statistic (Top10): table beside the pie it colours -->
            <Border Grid.Column="0" Style="{StaticResource Audio.Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource Audio.Title3}"
                               Text="{loc:Tr Txt_DowntimeStatisticTop10}" Margin="16,12,16,8"/>

                    <Grid Grid.Row="1" Margin="16,0,16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Style="{StaticResource Audio.ListHeaderRow}">
                                <Grid Margin="8,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*" MinWidth="110"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="52"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" Style="{StaticResource Audio.TableHeaderText}" Text="{loc:Tr Txt_Error}"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource Audio.TableHeaderText}"
                                               Text="{loc:Tr Txt_Min}" TextAlignment="Right" ToolTip="{loc:Tr Txt_TotalTimeMin}"/>
                                    <TextBlock Grid.Column="3" Style="{StaticResource Audio.TableHeaderText}"
                                               Text="{loc:Tr Txt_Count}" TextAlignment="Right" ToolTip="{loc:Tr Txt_CountTotal}"/>
                                </Grid>
                            </Border>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding DowntimeTop10}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Audio.ListRow}">
                                                <Grid Margin="8,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="14"/>
                                                        <ColumnDefinition Width="*" MinWidth="110"/>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="52"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- The swatch is what ties the row to
                                                         its slice, so it uses the same
                                                         rank-indexed DFM Top 10 colour. -->
                                                    <Rectangle Grid.Column="0" Width="10" Height="10"
                                                               RadiusX="2" RadiusY="2"
                                                               VerticalAlignment="Center"
                                                               Fill="{Binding Rank, Converter={StaticResource RankToBrush}}"/>

                                                    <TextBlock Grid.Column="1" Style="{StaticResource Audio.Callout}"
                                                               Text="{loc:TrBinding ErrorName, Alarm=True}" Margin="8,0,0,0"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{loc:TrBinding ErrorName, Alarm=True}"/>
                                                    <TextBlock Grid.Column="2" Style="{StaticResource Audio.CalloutMono}"
                                                               Text="{loc:TrBinding TotalMinutesText}" TextAlignment="Right"/>
                                                    <TextBlock Grid.Column="3" Style="{StaticResource Audio.CalloutMono}"
                                                               Text="{loc:TrBinding OccurrencesText}" TextAlignment="Right"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <lvc:PieChart Grid.Column="1" Width="190"
                                      Series="{loc:TrBinding DowntimePieSeries, Chart=True}"
                                      LegendPosition="Hidden"
                                      Margin="12,0,0,0"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Alarm durations -->
            <Border Grid.Column="1" Style="{StaticResource Audio.Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource Audio.Title3}"
                               Text="{loc:Tr Txt_AlarmDurations}" Margin="16,12,16,8"/>

                    <lvc:CartesianChart Grid.Row="1" Margin="12,0,16,12"
                                        Series="{loc:TrBinding DurationSeries, Chart=True}"
                                        XAxes="{loc:TrBinding DurationXAxes, Chart=True}"
                                        YAxes="{loc:TrBinding DurationYAxes, Chart=True}"
                                        TooltipPosition="Top"
                                        LegendPosition="Hidden"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Alarm history -->
        <Border Grid.Row="2" Style="{StaticResource Audio.Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Style="{StaticResource Audio.Title3}"
                           Text="{loc:Tr Txt_AlarmHistory}" Margin="16,12,16,8"/>

                <DataGrid Grid.Row="1" Style="{StaticResource Audio.DataGrid}"
                          ItemsSource="{Binding AlarmRows}"
                          Margin="8,0,8,8">
                    <DataGrid.Resources>
                        <!-- FAM 2 Bug_Id_020: a code, message or detail cut short by its
                             column shows in full on hover. -->
                        <Style x:Key="FullTextOnHover" TargetType="TextBlock"
                               BasedOn="{x:Static DataGridTextColumn.DefaultElementStyle}">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:Tr Txt_Date}" Binding="{Binding Date}" Width="110"/>
                        <DataGridTextColumn Header="{loc:Tr Txt_StartTime_2}" Binding="{Binding StartTime}" Width="190"/>
                        <DataGridTextColumn Header="{loc:Tr Txt_EndTime_2}" Binding="{Binding EndTime}" Width="190"/>
                        <DataGridTextColumn Header="{loc:Tr Txt_TimeInStateMin}" Binding="{loc:TrBinding TimeInStateText}" Width="140"/>
                        <DataGridTextColumn Header="{loc:Tr Txt_ErrorCode_2}" Binding="{Binding ErrorCode}" Width="140"
                                            ElementStyle="{StaticResource FullTextOnHover}"/>
                        <DataGridTextColumn Header="{loc:Tr Txt_ErrorMessage}" Binding="{loc:TrBinding ErrorMessage, Alarm=True}" Width="220"
                                            ElementStyle="{StaticResource FullTextOnHover}"/>
                        <DataGridTextColumn Header="{loc:Tr Txt_ErrorDetail_2}" Binding="{loc:TrBinding ErrorDetail, Alarm=True}" Width="*"
                                            ElementStyle="{StaticResource FullTextOnHover}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
