<UserControl x:Class="Nova.Wpf.App.Views.Pages.Audio.AudioConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Nova.Wpf.App.Converters"
             FontFamily="{DynamicResource Audio.FontFamily}"
             Background="Transparent">

    <!-- ================================================================== -->
    <!-- CONFIG PAGE   Audio SW DFM v5.4 slide 58                           -->
    <!--   2/3 width : machine configuration                                 -->
    <!--   1/3 width : Spec Limits + Edit / Save                             -->
    <!-- Access, from the slide: L1 view only, L2 non-critical config,       -->
    <!-- L3 Edit/Save.                                                        -->
    <!-- ================================================================== -->

    <UserControl.Resources>
        <converters:AudioBoolToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>   <!-- slide 58: 2/3 width -->
            <ColumnDefinition Width="1*"/>   <!-- slide 58: 1/3 width -->
        </Grid.ColumnDefinitions>

        <!-- Machine Configs. The slide labels this area and leaves it blank because
             what a machine is configured with is per-machine; for this machine it is
             the machine configuration tree and the taught recipe. -->
        <Border Grid.Column="0" Style="{StaticResource Audio.Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <ListBox Grid.Row="0" Margin="16,12,16,8"
                         Style="{StaticResource Audio.SegmentedControl}"
                         ItemsSource="{Binding Sections}"
                         SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                         DisplayMemberPath="Title"
                         AutomationProperties.Name="Machine configuration section"/>

                <!-- Slide 58 grades edit authority per section rather than hiding what
                     an operator may not change, so a locked section stays listed and
                     says why it is locked rather than vanishing from the control. -->
                <TextBlock Grid.Row="1" Style="{StaticResource Audio.Footnote}"
                           Margin="16,0,16,8" TextWrapping="Wrap"
                           Foreground="{DynamicResource Audio.System.OrangeBrush}"
                           Text="Locked — this section needs a higher access level to change."
                           Visibility="{Binding SelectedSection.IsEditable,
                                                Converter={StaticResource BoolToVisibility},
                                                ConverterParameter=invert}"/>

                <!-- Recessed host, for the same reason as the Vendor pane: the
                     hosted screens draw their own white panels and need a grey to
                     sit on, or their edges vanish into this card. Margin plus
                     horizontal padding is 16, the segmented control's left margin, so
                     the Machine Configs / Recipe strip, the hosted page's tab strip and
                     any nested strip all start on the same line. -->
                <Border Grid.Row="2"
                        Background="{DynamicResource Audio.Surface.GroupedBrush}"
                        CornerRadius="{DynamicResource Audio.Radius.Field}"
                        Margin="8,0,8,8"
                        Padding="8,10">
                    <ContentControl Content="{Binding SelectedSection.Page}"
                                    IsEnabled="{Binding SelectedSection.IsEditable}"
                                    Focusable="False"/>
                </Border>
            </Grid>
        </Border>

        <!-- Spec Limits -->
        <Border Grid.Column="1" Style="{StaticResource Audio.Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- title -->
                    <RowDefinition Height="Auto"/>   <!-- column header -->
                    <RowDefinition Height="*"/>      <!-- rows -->
                    <RowDefinition Height="Auto"/>   <!-- status -->
                    <RowDefinition Height="Auto"/>   <!-- Edit / Save -->
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Style="{StaticResource Audio.Title3}"
                           Text="Spec Limits" HorizontalAlignment="Center"
                           Margin="16,12,16,8"/>

                <Border Grid.Row="1" Style="{StaticResource Audio.ListHeaderRow}">
                    <Grid Margin="12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="72"/>
                            <ColumnDefinition Width="72"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource Audio.TableHeaderText}" Text="Key Name"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource Audio.TableHeaderText}"
                                   Text="LSL" TextAlignment="Right"/>
                        <TextBlock Grid.Column="2" Style="{StaticResource Audio.TableHeaderText}"
                                   Text="USL" TextAlignment="Right"/>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="SpecLimitRows" ItemsSource="{Binding SpecLimits}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Audio.ListRow}">
                                    <Grid Margin="12,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="72"/>
                                            <ColumnDefinition Width="72"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Column="0" Style="{StaticResource Audio.Callout}"
                                                   Text="{Binding KeyName}" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   ToolTip="{Binding KeyName}"/>

                                        <!-- Read mode: the stored limit, or N/A. -->
                                        <TextBlock Grid.Column="1" Style="{StaticResource Audio.CalloutMono}"
                                                   Text="{Binding LowerLimitText}" TextAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding DataContext.IsEditing, ElementName=SpecLimitRows,
                                                                        Converter={StaticResource BoolToVisibility},
                                                                        ConverterParameter=invert}"/>
                                        <TextBlock Grid.Column="2" Style="{StaticResource Audio.CalloutMono}"
                                                   Text="{Binding UpperLimitText}" TextAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding DataContext.IsEditing, ElementName=SpecLimitRows,
                                                                        Converter={StaticResource BoolToVisibility},
                                                                        ConverterParameter=invert}"/>

                                        <!-- Edit mode: typed limits, blank for no limit. -->
                                        <TextBox Grid.Column="1" Style="{StaticResource Audio.TextBoxMono}"
                                                 IsReadOnly="False" Margin="4,2,0,2"
                                                 Text="{Binding LowerLimit, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="{Binding KeyName, StringFormat='{}{0} LSL'}"
                                                 Visibility="{Binding DataContext.IsEditing, ElementName=SpecLimitRows,
                                                                      Converter={StaticResource BoolToVisibility}}"/>
                                        <TextBox Grid.Column="2" Style="{StaticResource Audio.TextBoxMono}"
                                                 IsReadOnly="False" Margin="4,2,0,2"
                                                 Text="{Binding UpperLimit, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="{Binding KeyName, StringFormat='{}{0} USL'}"
                                                 Visibility="{Binding DataContext.IsEditing, ElementName=SpecLimitRows,
                                                                      Converter={StaticResource BoolToVisibility}}"/>

                                        <!-- Why Save refused this row. -->
                                        <TextBlock Grid.Row="1" Grid.ColumnSpan="3"
                                                   Style="{StaticResource Audio.Footnote}"
                                                   Foreground="{DynamicResource Audio.System.RedBrush}"
                                                   Text="{Binding Error}" TextWrapping="Wrap" Margin="0,0,0,4"
                                                   Visibility="{Binding Error, Converter={StaticResource String2VisibilityConverter}}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Grid.Row="3">
                    <TextBlock Style="{StaticResource Audio.EmptyState}"
                               Text="{Binding SpecLimitsStatus}"
                               Margin="16,12"
                               Visibility="{Binding SpecLimitsStatus, Converter={StaticResource String2VisibilityConverter}}"/>
                    <TextBlock Style="{StaticResource Audio.Footnote}"
                               Margin="16,8,16,0" TextWrapping="Wrap"
                               Text="Leave a limit blank (or type N/A) when there is no spec limit on that side."
                               Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>

                <!-- Slide 58 puts Edit and Save at the foot of this panel, behind
                     Level 3. Disabled rather than hidden, so a Level 1 operator can see
                     that the capability exists and is not theirs. While editing, Edit
                     becomes Cancel so an edit can be abandoned without saving. -->
                <Grid Grid.Row="4" Margin="12,8,12,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Style="{StaticResource Audio.Button}"
                            Content="Edit"
                            Command="{Binding EditCommand}"
                            ToolTip="Changing spec limits requires Level 3"
                            Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"/>

                    <Button Grid.Column="0" Style="{StaticResource Audio.Button}"
                            Content="Cancel"
                            Command="{Binding CancelCommand}"
                            ToolTip="Discard the changes and reload the saved limits"
                            Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}"/>

                    <Button Grid.Column="2" Style="{StaticResource Audio.FilledButton}"
                            Content="Save"
                            Command="{Binding SaveCommand}"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
