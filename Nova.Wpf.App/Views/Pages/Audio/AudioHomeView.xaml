<UserControl x:Class="Nova.Wpf.App.Views.Pages.Audio.AudioHomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:loc="clr-namespace:Nova.Wpf.UI.Localization;assembly=Nova.Wpf.UI"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:converters="clr-namespace:Nova.Wpf.App.Converters"
             FontFamily="{DynamicResource Audio.FontFamily}"
             Background="Transparent">

    <!-- ================================================================== -->
    <!-- HOME PAGE -->
    <!-- Audio SW DFM v5.4 slide 43 "Home Page Formatting" dimensions it: -->
    <!--   left  column  2/3 width : State Changes (1/2 h) over -->
    <!--                             Error Statistics (1/2 h) -->
    <!--   right column  1/3 width : I/O Summary (1/3 h), -->
    <!--                             Parameter Dashboard (1/3 h), -->
    <!--                             Station Card (1/3 h) -->
    <!-- Those proportions are the spec, so they are star sizes here rather -->
    <!-- than fixed heights: the page holds its ratios at any panel size. -->
    <!-- Slide 55's Sensor Connection Dashboard opens in place of the panels. -->
    <!-- ================================================================== -->

    <UserControl.Resources>
        <converters:RatioToStarConverter x:Key="RatioToStar"/>
        <converters:BoolToBrushKeyConverter x:Key="BoolToBrushKey"/>
        <converters:AudioBoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:HealthLevelToBrushConverter x:Key="HealthLevelToBrush"/>

        <!-- A card's title row. Repeated on six panels, so it is a template
             rather than six copies of the same two setters. -->
        <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource Audio.Title3}">
            <Setter Property="Margin" Value="16,12,16,8"/>
        </Style>

        <Style x:Key="Home.Note" TargetType="TextBlock" BasedOn="{StaticResource Audio.Caption1}">
            <Setter Property="Foreground" Value="{DynamicResource Audio.Text.SecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

    </UserControl.Resources>

    <Grid>

        <!-- ============================================================== -->
        <!-- MAIN TAB -->
        <!-- ============================================================== -->
        <Grid
              Visibility="{Binding IsDashboardVisible, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>   <!-- slide 43: 2/3 width -->
                <ColumnDefinition Width="1*"/>   <!-- slide 43: 1/3 width -->
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>  <!-- slide 43: 1/2 height -->
                    <RowDefinition Height="*"/>  <!-- slide 43: 1/2 height -->
                </Grid.RowDefinitions>

                <!-- State Changes: the last seven days from the HIVE state history -->
                <Border Grid.Row="0" Style="{StaticResource Audio.Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <TextBlock Style="{StaticResource CardTitle}" Text="{loc:Tr Txt_StateChanges}"/>
                            <TextBlock Style="{StaticResource Home.Note}" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" Margin="0,8,16,0"
                                       Text="{loc:Tr Txt_ShareOfEachDayInEachHIVE}"/>
                        </Grid>

                        <lvc:CartesianChart Grid.Row="1"
                                            Margin="12,0,16,0"
                                            Series="{loc:TrBinding StateChangeSeries, Chart=True}"
                                            XAxes="{loc:TrBinding StateChangeXAxes, Chart=True}"
                                            YAxes="{loc:TrBinding StateChangeYAxes, Chart=True}"
                                            TooltipPosition="Top"
                                            LegendPosition="Hidden"/>

                        <TextBlock Grid.Row="1" Style="{StaticResource Audio.EmptyState}"
                                   Text="{loc:TrBinding StateChangeNote}" Margin="40,0"
                                   Visibility="{Binding StateChangeNote, Converter={StaticResource String2VisibilityConverter}}"/>

                        <!-- The chart's own legend is hidden and replaced with this
                             one, so the swatches are the DFM's exact state colours and
                             sit where the slide puts them. -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal"
                                    HorizontalAlignment="Center" Margin="0,8,0,12">
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                <Rectangle Width="12" Height="12" RadiusX="2" RadiusY="2"
                                           Fill="{DynamicResource Audio.State.RunningBrush}"
                                           Stroke="{DynamicResource Audio.SeparatorBrush}" StrokeThickness="1"/>
                                <TextBlock Style="{StaticResource Audio.Footnote}" Text="{loc:Tr Txt_Running}" Margin="6,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                <Rectangle Width="12" Height="12" RadiusX="2" RadiusY="2"
                                           Fill="{DynamicResource Audio.State.IdleBrush}"
                                           Stroke="{DynamicResource Audio.SeparatorBrush}" StrokeThickness="1"/>
                                <TextBlock Style="{StaticResource Audio.Footnote}" Text="{loc:Tr Txt_Idle}" Margin="6,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                <Rectangle Width="12" Height="12" RadiusX="2" RadiusY="2"
                                           Fill="{DynamicResource Audio.State.DowntimeBrush}"
                                           Stroke="{DynamicResource Audio.SeparatorBrush}" StrokeThickness="1"/>
                                <TextBlock Style="{StaticResource Audio.Footnote}" Text="{loc:Tr Txt_Downtime}" Margin="6,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="12" Height="12" RadiusX="2" RadiusY="2"
                                           Fill="{DynamicResource Audio.System.Gray5Brush}"
                                           Stroke="{DynamicResource Audio.SeparatorBrush}" StrokeThickness="1"/>
                                <TextBlock Style="{StaticResource Audio.Footnote}" Text="{loc:Tr Txt_NoRecord}" Margin="6,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Error Statistics: alarms per error type in the slider's window -->
                <Border Grid.Row="1" Style="{StaticResource Audio.Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <TextBlock Style="{StaticResource CardTitle}" Text="{loc:Tr Txt_ErrorStatistics}"/>
                            <!-- Slide 54: "Click space areas to jump to error tab". -->
                            <Button Style="{StaticResource Audio.PlainButton}" HorizontalAlignment="Right"
                                    VerticalAlignment="Center" Margin="0,8,8,0" Height="26"
                                    Content="{loc:Tr Txt_OpenAlarmPage}"
                                    Command="{Binding ShowAlarmPageCommand}"/>
                        </Grid>

                        <!-- Slide 43's filter slider over the last seven days, with the
                             window it selects shown in the two boxes either side. -->
                        <Grid Grid.Row="1" Margin="16,0,16,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{DynamicResource Audio.Surface.RecessedBrush}"
                                    CornerRadius="{DynamicResource Audio.Radius.Small}" Padding="8,3" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Audio.Caption1}"
                                           Text="{Binding ErrorFilterStart, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"/>
                            </Border>
                            <hc:RangeSlider Grid.Column="1" Margin="12,0" VerticalAlignment="Center"
                                            Minimum="0" Maximum="{Binding ErrorRangeMaxHours}"
                                            ValueStart="{Binding ErrorRangeStartHours, Mode=TwoWay}"
                                            ValueEnd="{Binding ErrorRangeEndHours, Mode=TwoWay}"
                                            SmallChange="1" LargeChange="24"
                                            IsSnapToTickEnabled="True" TickFrequency="1"
                                            AutomationProperties.Name="Error statistics time window"
                                            ToolTip="{loc:Tr Txt_DragTheHandlesToChooseTheWindow}"/>
                            <Border Grid.Column="2" Background="{DynamicResource Audio.Surface.RecessedBrush}"
                                    CornerRadius="{DynamicResource Audio.Radius.Small}" Padding="8,3" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Audio.Caption1}"
                                           Text="{Binding ErrorFilterEnd, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"/>
                            </Border>
                        </Grid>

                        <!-- The bars are the click target for the Alarm page. -->
                        <Button Grid.Row="2" Style="{StaticResource Audio.CardButton}"
                                Margin="0" BorderThickness="0" Background="Transparent"
                                Command="{Binding ShowAlarmPageCommand}"
                                ToolTip="{loc:Tr Txt_OpenTheAlarmPage}"
                                AutomationProperties.Name="Error statistics - open the Alarm page">
                            <Grid>
                                <TextBlock Style="{StaticResource Audio.EmptyState}"
                                           Text="{loc:TrBinding ErrorStatisticsNote}"
                                           Visibility="{Binding ErrorStatisticsNote, Converter={StaticResource String2VisibilityConverter}}"/>

                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding ErrorStatistics}"
                                                  Margin="16,0,16,12" VerticalAlignment="Center">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3" ToolTip="{loc:TrBinding Detail, Alarm=True}" Background="Transparent">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="140"/>  <!-- category -->
                                                        <ColumnDefinition Width="*"/>    <!-- bar -->
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                               Style="{StaticResource Audio.Footnote}"
                                                               Text="{loc:TrBinding Label, Alarm=True}"
                                                               TextAlignment="Right"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="0,0,10,0"/>

                                                    <!-- Two star columns proportioned by Ratio, so
                                                         the value label sits immediately after the
                                                         bar's end exactly as the slide draws it. -->
                                                    <Grid Grid.Column="1">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="{Binding Ratio, Converter={StaticResource RatioToStar}}"/>
                                                            <ColumnDefinition Width="{Binding Ratio, Converter={StaticResource RatioToStar}, ConverterParameter=invert}"/>
                                                        </Grid.ColumnDefinitions>

                                                        <Border Grid.Column="0" Height="16"
                                                                Background="{DynamicResource Audio.UnitSn.FailBrush}"
                                                                CornerRadius="3"
                                                                HorizontalAlignment="Stretch"/>

                                                        <TextBlock Grid.Column="1"
                                                                   Style="{StaticResource Audio.Caption1}"
                                                                   Text="{Binding CountText}"
                                                                   Margin="6,0,0,0"
                                                                   VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!-- RIGHT COLUMN -->
            <!-- Thirds of the column's height when it is tall enough for every card
                 (the Grid is as high as the viewport); on a shorter window the Grid
                 stops at the sum of the MinHeights and the column scrolls, so no card
                 is ever cut off - the station card's Sensor Connection button is its
                 last row and was the first thing lost. -->
            <ScrollViewer Grid.Column="1" x:Name="RightColumnScroll"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Height="{Binding ViewportHeight, ElementName=RightColumnScroll}" MinHeight="720">
                <!-- Slide 43: a third of the height each. The MinHeights are what each
                     card needs to show all of its content. -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="230"/>  <!-- slide 43: 1/3 height -->
                    <RowDefinition Height="*" MinHeight="200"/>  <!-- slide 43: 1/3 height -->
                    <RowDefinition Height="*" MinHeight="290"/>  <!-- slide 43: 1/3 height -->
                </Grid.RowDefinitions>

                <!-- I/O Summary -->
                <!-- Slide 54: "Click space areas to jump to data tab". -->
                <Button Grid.Row="0"
                        Style="{StaticResource Audio.CardButton}"
                        Command="{Binding ShowDataPageCommand}"
                        ToolTip="{loc:Tr Txt_OpenTheDataPage}"
                        AutomationProperties.Name="I/O summary - open the Data page">
                    <!-- Tight spacing on purpose: the card is a third of the column by
                         spec and has to hold the banner and all five rows at 125 %. -->
                    <Grid Margin="16,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Unit SN banner. Slide 43: "Each unit status shows as it
                             completes processing. Failed units turn SN background
                             red" - DFM green #00F900 / red #EC5D57. -->
                        <Border Grid.Row="0" MinHeight="36"
                                CornerRadius="{DynamicResource Audio.Radius.Field}"
                                Background="{Binding LastUnitPassed,
                                                     Converter={StaticResource BoolToBrushKey},
                                                     ConverterParameter='Audio.UnitSn.PassBrush|Audio.UnitSn.FailBrush'}">
                            <TextBlock Style="{StaticResource Audio.Title3}"
                                       Text="{loc:TrBinding LastUnitSn}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{Binding LastUnitPassed,
                                                            Converter={StaticResource BoolToBrushKey},
                                                            ConverterParameter='Audio.UnitSn.PassForegroundBrush|Audio.UnitSn.FailForegroundBrush'}"/>
                        </Border>

                        <!-- Slide 43: the statistics update hourly, so the headline row
                             says when they last did; the window is in the tooltip. -->
                        <Grid Grid.Row="1" Margin="0,8,0,6" ToolTip="{loc:TrBinding IoSummaryCaption}" Background="Transparent">
                            <TextBlock Style="{StaticResource Audio.Headline}"
                                       Text="{loc:Tr Txt_IOSummary}" HorizontalAlignment="Center"/>
                            <TextBlock Style="{StaticResource Home.Note}" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" Text="{loc:TrBinding IoSummaryUpdated}"/>
                        </Grid>

                        <!-- Scrolled, not just laid out: this card is one third of the
                             column height by spec, and five rows plus the SN banner do
                             not always fit at every window size. -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding IoSummary}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Style="{StaticResource Audio.Footnote}"
                                                       Text="{loc:TrBinding Label}"/>
                                            <TextBlock Grid.Column="1" Style="{StaticResource Audio.CalloutMono}"
                                                       Text="{Binding Value}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                    </Grid>
                </Button>

                <!-- Parameter Dashboard -->
                <Border Grid.Row="1" Style="{StaticResource Audio.Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Style="{StaticResource CardTitle}"
                                   Text="{loc:Tr Txt_ParameterDashboard}" HorizontalAlignment="Center"/>

                        <!-- Column header. Four columns shared with the rows below;
                             the widths are repeated rather than shared because a
                             SharedSizeGroup across a virtualised ItemsControl costs
                             more than it saves at a dozen rows. -->
                        <Border Grid.Row="1" Style="{StaticResource Audio.ListHeaderRow}">
                            <!-- Same 16 left edge as the card's title and the other cards' text,
                                 and a spacer the width of the rows' scroll bar while it shows,
                                 so Value / LSL / USL stay above their columns. -->
                            <Grid Margin="16,0,12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Width" Value="0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ComputedVerticalScrollBarVisibility, ElementName=ParameterScroll}"
                                                             Value="Visible">
                                                    <Setter Property="Width" Value="{x:Static SystemParameters.VerticalScrollBarWidth}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <TextBlock Grid.Column="0" Style="{StaticResource Audio.TableHeaderText}" Text="{loc:Tr Txt_KeyName}"/>
                                <TextBlock Grid.Column="1" Style="{StaticResource Audio.TableHeaderText}" Text="{loc:Tr Txt_Value}" TextAlignment="Right"/>
                                <TextBlock Grid.Column="2" Style="{StaticResource Audio.TableHeaderText}" Text="LSL" TextAlignment="Right"/>
                                <TextBlock Grid.Column="3" Style="{StaticResource Audio.TableHeaderText}" Text="USL" TextAlignment="Right"/>
                            </Grid>
                        </Border>

                        <ScrollViewer x:Name="ParameterScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Parameters}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border>
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource Audio.ListRow}">
                                                    <Style.Triggers>
                                                        <!-- Slide 43: OOS params at the
                                                             top of the list, in red. The
                                                             sort is the view model's; this
                                                             is the red. -->
                                                        <DataTrigger Binding="{Binding IsOutOfSpec}" Value="True">
                                                            <Setter Property="Background"
                                                                    Value="{DynamicResource Audio.UnitSn.FailBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid Margin="16,0,12,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="56"/>
                                                    <ColumnDefinition Width="56"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Style="{StaticResource Audio.Callout}"
                                                           Text="{loc:TrBinding KeyName}" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{loc:TrBinding KeyName}"/>
                                                <TextBlock Grid.Column="1" Style="{StaticResource Audio.CalloutMono}"
                                                           Text="{Binding Value}" TextAlignment="Right"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{loc:TrBinding Value}"/>
                                                <TextBlock Grid.Column="2" Style="{StaticResource Audio.CalloutMono}"
                                                           Text="{loc:TrBinding LowerLimitText}" TextAlignment="Right"/>
                                                <TextBlock Grid.Column="3" Style="{StaticResource Audio.CalloutMono}"
                                                           Text="{loc:TrBinding UpperLimitText}" TextAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock Grid.Row="3" Style="{StaticResource Home.Note}" Margin="16,6,16,10"
                                   Text="{loc:TrBinding ParameterNote}"/>
                    </Grid>
                </Border>

                <!-- Station card -->
                <Border Grid.Row="2">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Audio.Card}">
                            <Style.Triggers>
                                <!-- Slide 40: the card goes orange (#FF8F00) while the
                                     machine is under remote qualification. -->
                                <DataTrigger Binding="{Binding IsRemoteQualification}" Value="True">
                                    <Setter Property="Background"
                                            Value="{DynamicResource Audio.StationCard.RemoteQualBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Grid Margin="16,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>   <!-- station name -->
                            <RowDefinition Height="*"/>      <!-- facts -->
                            <RowDefinition Height="Auto"/>   <!-- links -->
                            <RowDefinition Height="Auto"/>   <!-- log buttons -->
                            <RowDefinition Height="Auto"/>   <!-- sensor dashboard button -->
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Style="{StaticResource Audio.Title3}"
                                   Text="{loc:TrBinding StationTitle}" HorizontalAlignment="Center"/>

                        <!-- The facts as a table: every label in one column and every value
                             starting at the same x, instead of each value sitting wherever
                             its label happened to end. Site and Vendor share the first row. -->
                        <Grid Grid.Row="1" Margin="0,10,0,0" VerticalAlignment="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto" MinWidth="64"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Audio.FieldLabel}"
                                       Text="{loc:Tr Txt_Site}" Margin="0,2,10,2"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource Audio.Footnote}"
                                       Foreground="{DynamicResource Audio.Text.PrimaryBrush}" VerticalAlignment="Center"
                                       Text="{loc:TrBinding Site}" Margin="0,2,16,2"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource Audio.FieldLabel}"
                                       Text="{loc:Tr Txt_Vendor}" Margin="0,2,10,2"/>
                            <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource Audio.Footnote}"
                                       Foreground="{DynamicResource Audio.Text.PrimaryBrush}" VerticalAlignment="Center"
                                       Text="{loc:TrBinding Vendor}" Margin="0,2" TextTrimming="CharacterEllipsis"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Audio.FieldLabel}"
                                       Text="{loc:Tr Txt_SWVersion}" Margin="0,2,10,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Style="{StaticResource Audio.Caption1Mono}"
                                       Foreground="{DynamicResource Audio.Text.PrimaryBrush}" VerticalAlignment="Center"
                                       Text="{loc:TrBinding SoftwareVersion}" Margin="0,2" TextTrimming="CharacterEllipsis"
                                       ToolTip="{loc:TrBinding SoftwareVersion}"/>

                            <!-- Slide 43: "click to open the path". -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Audio.FieldLabel}"
                                       Text="{loc:Tr Txt_MainSWPath}" Margin="0,2,10,2"/>
                            <Button Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Style="{StaticResource Audio.PlainButton}"
                                    Height="20" Padding="0" Margin="0,1" HorizontalAlignment="Left"
                                    HorizontalContentAlignment="Left"
                                    Command="{Binding OpenMainSoftwarePathCommand}"
                                    ToolTip="{loc:TrBinding MainSoftwarePath}">
                                <TextBlock Style="{StaticResource Audio.Caption1Mono}"
                                           Foreground="{DynamicResource Audio.System.BlueBrush}"
                                           Text="{loc:TrBinding MainSoftwarePath}"
                                           TextTrimming="CharacterEllipsis"/>
                            </Button>

                            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource Audio.FieldLabel}"
                                       Text="{loc:Tr Txt_MSHash}" Margin="0,2,10,2"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Style="{StaticResource Audio.Caption1Mono}"
                                       Foreground="{DynamicResource Audio.Text.PrimaryBrush}" VerticalAlignment="Center"
                                       Text="{loc:TrBinding MainSoftwareHash}" Margin="0,2" TextTrimming="CharacterEllipsis"
                                       ToolTip="{loc:TrBinding MainSoftwareHash}"/>
                        </Grid>

                        <!-- Green when connected, red when not (slide 43); the tooltip
                             says what lies behind it. -->
                        <ItemsControl Grid.Row="2" ItemsSource="{Binding Links}" Margin="0,10,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource Audio.Caption1}"
                                               Text="{loc:TrBinding StatusText}"
                                               HorizontalAlignment="Center"
                                               FontWeight="SemiBold"
                                               ToolTip="{loc:TrBinding Detail}"
                                               Foreground="{Binding IsConnected,
                                                                    Converter={StaticResource BoolToBrushKey},
                                                                    ConverterParameter='Audio.Link.ConnectedBrush|Audio.Link.DisconnectedBrush'}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid Grid.Row="3" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource Audio.LogButton}"
                                    Content="{loc:Tr Txt_MachineLog}" Command="{Binding OpenMachineLogCommand}"/>
                            <Button Grid.Column="2" Style="{StaticResource Audio.LogButton}"
                                    Content="{loc:Tr Txt_HIVELog}" Command="{Binding OpenHiveLogCommand}"/>
                        </Grid>

                        <!-- Slide 54: "Show sensor connection button after login". -->
                        <Button Grid.Row="4" Style="{StaticResource Audio.PlainButton}"
                                HorizontalAlignment="Left" Margin="0,10,0,0" Height="26"
                                Content="{loc:Tr Txt_SensorConnection}"
                                Command="{Binding OpenSensorDashboardCommand}"
                                Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVisibility}}"
                                AutomationProperties.Name="Sensor Connection"/>
                    </Grid>
                </Border>
            </Grid>
            </ScrollViewer>
        </Grid>

        <!-- ============================================================== -->
        <!-- SENSOR CONNECTION DASHBOARD  (slide 55) -->
        <!-- Opened from the station card after login. Level 1 views only; -->
        <!-- Level 2/3 can disable non-critical sensors. -->
        <!-- ============================================================== -->
        <Border Style="{StaticResource Audio.Card}"
                Visibility="{Binding IsSensorDashboardVisible, Converter={StaticResource BoolToVisibility}}">
            <Grid Margin="16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- title, back -->
                    <RowDefinition Height="Auto"/>   <!-- access note + legend -->
                    <RowDefinition Height="*"/>      <!-- sensors | units, devices -->
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <TextBlock Style="{StaticResource Audio.Title3}" Text="{loc:Tr Txt_SensorConnectionDashboard}"/>
                    <Button Style="{StaticResource Audio.Button}" HorizontalAlignment="Right"
                            Content="{loc:Tr Txt_BackToHome}" Command="{Binding CloseSensorDashboardCommand}"/>
                </Grid>

                <Grid Grid.Row="1" Margin="0,6,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource Home.Note}" VerticalAlignment="Center"
                               Text="{loc:TrBinding SensorAccessNote}"/>
                    <!-- The four sensor states of slide 55. -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="10" Height="10" Fill="{DynamicResource Audio.System.GreenBrush}"/>
                        <TextBlock Style="{StaticResource Audio.Footnote}" Text="{loc:Tr Txt_Activated}" Margin="6,0,16,0"/>
                        <Ellipse Width="10" Height="10" Fill="{DynamicResource Audio.System.GrayBrush}"/>
                        <TextBlock Style="{StaticResource Audio.Footnote}" Text="{loc:Tr Txt_Idle}" Margin="6,0,16,0"/>
                        <Ellipse Width="10" Height="10" Fill="{DynamicResource Audio.System.OrangeBrush}"/>
                        <TextBlock Style="{StaticResource Audio.Footnote}" Text="{loc:Tr Txt_ManuallyDisabled}" Margin="6,0,16,0"/>
                        <Ellipse Width="10" Height="10" Fill="{DynamicResource Audio.System.RedBrush}"/>
                        <TextBlock Style="{StaticResource Audio.Footnote}" Text="{loc:Tr Txt_SignalLost}" Margin="6,0,0,0"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Sensors, grouped by the location they watch -->
                    <Border Grid.Column="0" Background="{DynamicResource Audio.Surface.RecessedBrush}"
                            CornerRadius="{DynamicResource Audio.Radius.Field}" Padding="12,8">
                        <Grid>
                            <TextBlock Style="{StaticResource Audio.EmptyState}" MaxWidth="520"
                                       Text="{loc:Tr Txt_SensorStatesAreNotLinkedToThis}"
                                       Visibility="{Binding HasSensorService, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"/>

                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding SensorGroups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,4,0,8">
                                                <TextBlock Style="{StaticResource Audio.Headline}" Text="{loc:TrBinding Location}" Margin="2,0,0,4"/>
                                                <ItemsControl ItemsSource="{Binding Sensors}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <!-- Slide 55: "Click to enable/disable sensor". -->
                                                            <Button Style="{StaticResource Audio.CardButton}" Margin="0,0,8,8"
                                                                    Width="230" Height="64"
                                                                    Command="{Binding DataContext.ToggleSensorCommand,
                                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    ToolTip="{loc:TrBinding ToolTip}"
                                                                    AutomationProperties.Name="{Binding Id, StringFormat='Sensor {0}'}">
                                                                <Grid Margin="10,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border Grid.Column="0" Width="6" CornerRadius="3" Margin="0,0,10,0"
                                                                            Background="{Binding Level, Converter={StaticResource HealthLevelToBrush}}"/>
                                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Style="{StaticResource Audio.CalloutMono}" Text="{loc:TrBinding Id}" FontWeight="SemiBold"/>
                                                                            <Border Background="{DynamicResource Audio.System.Gray5Brush}"
                                                                                    CornerRadius="{DynamicResource Audio.Radius.Small}"
                                                                                    Padding="5,0" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                                    Visibility="{Binding IsCritical, Converter={StaticResource BoolToVisibility}}">
                                                                                <TextBlock Style="{StaticResource Audio.Caption1}" Text="{loc:Tr Txt_Critical}"/>
                                                                            </Border>
                                                                        </StackPanel>
                                                                        <TextBlock Style="{StaticResource Audio.Caption1}" Text="{loc:TrBinding Name}"
                                                                                   TextTrimming="CharacterEllipsis"/>
                                                                        <TextBlock Style="{StaticResource Audio.Caption1}" Text="{loc:TrBinding StateText}"
                                                                                   Foreground="{Binding Level, Converter={StaticResource HealthLevelToBrush}}"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- Unit positions and device connections -->
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Audio.Headline}" Text="{loc:Tr Txt_UnitsOnTheMachine}" Margin="0,0,0,6"
                                       Visibility="{Binding HasSensorService, Converter={StaticResource BoolToVisibility}}"/>
                            <ItemsControl ItemsSource="{Binding UnitLocations}" Margin="0,0,0,14">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,3">
                                            <!-- Filled when a unit is there, hollow when not (slide 55: A / B). -->
                                            <Border Width="14" Height="14" CornerRadius="3" BorderThickness="2"
                                                    BorderBrush="{DynamicResource Audio.System.BlueBrush}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasUnit}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource Audio.System.BlueBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                            <TextBlock Style="{StaticResource Audio.Footnote}" Text="{loc:TrBinding StateText}" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Style="{StaticResource Audio.Headline}" Text="{loc:Tr Txt_DeviceConnections}" Margin="0,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding Devices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,3">
                                            <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                                                     Fill="{Binding IsConnected,
                                                                    Converter={StaticResource BoolToBrushKey},
                                                                    ConverterParameter='Audio.System.GreenBrush|Audio.System.RedBrush'}"/>
                                            <TextBlock Style="{StaticResource Audio.Footnote}" Text="{loc:TrBinding StatusText}" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
