<UserControl x:Class="Nova.Wpf.App.Views.Pages.Settings.AnalogIoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="HeaderCell" TargetType="TextBlock" BasedOn="{StaticResource Nova.TableHeaderText}">
            <Setter Property="Margin" Value="16,0"/>
        </Style>

        <Style x:Key="NoDataTextStyle" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,18,0,18"/>
            <Setter Property="FontSize" Value="{DynamicResource Nova.FontSize.Body}"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasChannels}" Value="False">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RowsHostStyle" TargetType="ItemsControl">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasChannels}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- One analog channel row -->
        <DataTemplate x:Key="ChannelRowTemplate">
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" MinHeight="52">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="2.2*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="0.7*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding ChannelId}" FontSize="{DynamicResource Nova.FontSize.Body}" Margin="16,0"
                               FontFamily="Consolas, Cascadia Mono, monospace" VerticalAlignment="Center"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="{DynamicResource Nova.FontSize.Body}" Margin="16,0"
                               FontFamily="Consolas, Cascadia Mono, monospace" VerticalAlignment="Center"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBlock Grid.Column="2" Text="{Binding RawValue}" FontSize="{DynamicResource Nova.FontSize.Body}" Margin="16,0"
                               FontFamily="Consolas, Cascadia Mono, monospace" VerticalAlignment="Center"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>

                    <!-- Scaled value + bar -->
                    <Grid Grid.Column="3" Margin="16,0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ScaledValue}" FontSize="{DynamicResource Nova.FontSize.Body}" FontWeight="SemiBold"
                                       FontFamily="Consolas, Cascadia Mono, monospace"
                                       Foreground="{DynamicResource PrimaryBrush}"/>
                            <TextBlock Text="{Binding ScaledUnit}" FontSize="{DynamicResource Nova.FontSize.Caption}"
                                       FontFamily="Consolas, Cascadia Mono, monospace"
                                       Foreground="{DynamicResource PrimaryBrush}"/>
                        </StackPanel>
                        <ProgressBar Grid.Column="1" Height="6" Minimum="0" Maximum="100"
                                     Value="{Binding Percent, Mode=OneWay}" VerticalAlignment="Center"
                                     Foreground="{DynamicResource DarkPrimaryBrush}"
                                     Background="{DynamicResource Nova.TableHeaderBrush}" BorderThickness="0"/>
                    </Grid>

                    <!-- Status badge -->
                    <!-- Status badge = label: no outline. The status word is already
                         colour-coded, which is the cue that carries at a distance. -->
                    <Border Grid.Column="4" x:Name="StatusBadge" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Margin="16,0" CornerRadius="4" Padding="8,3"
                            Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                        <TextBlock x:Name="StatusText" Text="{Binding Status}" FontSize="{DynamicResource Nova.FontSize.Caption}" FontWeight="SemiBold"
                                   FontFamily="Consolas, Cascadia Mono, monospace"
                                   Foreground="{DynamicResource SuccessBrush}"/>
                    </Border>

                    <TextBlock Grid.Column="5" Text="{Binding Unit}" FontSize="{DynamicResource Nova.FontSize.Body}" FontWeight="SemiBold" Margin="16,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="WARNING">
                    <Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <!-- Centred table card -->
    <Border Background="{DynamicResource RegionBrush}" CornerRadius="8" MaxWidth="860" Margin="8,16"
            HorizontalAlignment="Center" VerticalAlignment="Top"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Effect="{StaticResource EffectShadow1}">
        <DockPanel>
            <!-- Column header -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource Nova.TableHeaderBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Height="38" CornerRadius="8,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="2.2*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="0.7*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Channel  ID" Style="{StaticResource HeaderCell}"/>
                    <TextBlock Grid.Column="1" Text="Name" Style="{StaticResource HeaderCell}"/>
                    <TextBlock Grid.Column="2" Text="Value" Style="{StaticResource HeaderCell}"/>
                    <TextBlock Grid.Column="3" Text="Scaled Value" Style="{StaticResource HeaderCell}"/>
                    <TextBlock Grid.Column="4" Text="Status" Style="{StaticResource HeaderCell}"/>
                    <TextBlock Grid.Column="5" Text="Unit" Style="{StaticResource HeaderCell}"/>
                </Grid>
            </Border>

            <!-- Rows -->
            <Grid MinWidth="820">
                <TextBlock Text="No data available" Style="{StaticResource NoDataTextStyle}"/>
                <ItemsControl Style="{StaticResource RowsHostStyle}"
                              ItemsSource="{Binding Channels}"
                              ItemTemplate="{StaticResource ChannelRowTemplate}"/>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>