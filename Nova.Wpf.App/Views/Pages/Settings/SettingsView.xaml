<UserControl x:Class="Nova.Wpf.App.Views.Pages.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:loc="clr-namespace:Nova.Wpf.UI.Localization;assembly=Nova.Wpf.UI"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:settingsVm="clr-namespace:Nova.ViewModels.Pages.Settings;assembly=Nova.ViewModels"
             xmlns:local="clr-namespace:Nova.Wpf.App.Views.Pages.Settings"
             Background="Transparent">

    <!-- Connected-tab look + icon/label header come from the shared implicit
         TabControl/TabItem styles (Nova.Wpf.UI/Styles/TabStyles.xaml) — same as Manual.
         No margin: the host page's padding places this strip level with the strip
         above it, and a margin here would indent it. -->
    <Grid>
        <TabControl ItemsSource="{Binding Tabs}"
                    SelectedItem="{Binding SelectedTab}">
            <TabControl.Resources>
                <!-- Device Settings has a dedicated composite layout. -->
                <DataTemplate DataType="{x:Type settingsVm:DeviceSettingsViewModel}">
                    <local:DeviceSettingsView/>
                </DataTemplate>

                <!-- I/O Diagnostics: digital inputs and outputs. -->
                <DataTemplate DataType="{x:Type settingsVm:DigitalIoViewModel}">
                    <local:DigitalIoView/>
                </DataTemplate>

                <!-- Axis Parameter Settings: axis table. -->
                <DataTemplate DataType="{x:Type settingsVm:AxisConfigurationViewModel}">
                    <local:AxisParametersView/>
                </DataTemplate>

                <!-- Grouped tabs (SFC / Calibration) host nested tabs. -->
                <DataTemplate DataType="{x:Type settingsVm:SettingsGroupViewModel}">
                    <local:SettingsGroupView/>
                </DataTemplate>

            </TabControl.Resources>
        </TabControl>
    </Grid>
</UserControl>
