<UserControl x:Class="Nova.Wpf.App.Views.Pages.Settings.SettingsFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border" BasedOn="{StaticResource Nova.Card}">
            <Setter Property="Margin" Value="8"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource Nova.FontSize.Body}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
        </Style>

        <Style x:Key="EditInput" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="IsEnabled" Value="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
        </Style>

        <!-- One field row: label + editor chosen by Kind -->
        <DataTemplate x:Key="FieldRowTemplate">
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding Label}" Style="{StaticResource FieldLabel}" Margin="0,0,10,0"/>

                <!-- Text editor -->
                <Grid x:Name="TextEditor" Grid.Column="1" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Style="{StaticResource EditInput}"
                             Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Unit}" FontSize="{DynamicResource Nova.FontSize.Caption}" VerticalAlignment="Center"
                               Margin="6,0,0,0" Foreground="{DynamicResource SecondaryTextBrush}"/>
                </Grid>

                <!-- Toggle editor -->
                <ToggleButton x:Name="ToggleEditor" Grid.Column="1" Visibility="Collapsed"
                              HorizontalAlignment="Right" Style="{StaticResource ToggleButtonSwitch}"
                              IsChecked="{Binding IsOn, Mode=TwoWay}"
                              IsEnabled="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}}"/>

                <!-- Read-only value -->
                <TextBlock x:Name="ReadEditor" Grid.Column="1" Visibility="Collapsed"
                           Text="{Binding Value}" FontSize="{DynamicResource Nova.FontSize.Body}" FontWeight="SemiBold" TextAlignment="Right"
                           VerticalAlignment="Center" TextWrapping="Wrap"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Text">
                    <Setter TargetName="TextEditor" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Toggle">
                    <Setter TargetName="ToggleEditor" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="ReadOnly">
                    <Setter TargetName="ReadEditor" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- One section card -->
        <DataTemplate x:Key="SectionCardTemplate">
            <Border Style="{StaticResource Card}" Width="380" VerticalAlignment="Top">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <iconPacks:PackIconLucide Kind="{Binding Icon}" Width="16" Height="16" VerticalAlignment="Center"
                                                  Margin="0,0,8,0" Foreground="{DynamicResource PrimaryBrush}"/>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource Nova.SectionTitle}"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Fields}" ItemTemplate="{StaticResource FieldRowTemplate}"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="8,6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Action bar -->
        <Grid Grid.Row="0" Margin="8,0,8,4">
            <TextBlock Text="{Binding Title}" FontSize="{DynamicResource Nova.FontSize.Heading}" FontWeight="Bold" VerticalAlignment="Center"
                       Foreground="{DynamicResource PrimaryTextBrush}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource Nova.ButtonInfo}"
                        Command="{Binding EditCommand}" IsEnabled="{Binding CanEdit}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="Pencil" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Edit" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Nova.ButtonPrimary}" Margin="10,0,0,0"
                        Command="{Binding SaveCommand}" IsEnabled="{Binding IsEditing}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="Save" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Save" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Section cards -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Sections}" ItemTemplate="{StaticResource SectionCardTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
