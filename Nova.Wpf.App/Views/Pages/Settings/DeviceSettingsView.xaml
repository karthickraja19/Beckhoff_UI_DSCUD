<UserControl x:Class="Nova.Wpf.App.Views.Pages.Settings.DeviceSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:loc="clr-namespace:Nova.Wpf.UI.Localization;assembly=Nova.Wpf.UI"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="Transparent">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style x:Key="Card" TargetType="Border" BasedOn="{StaticResource Nova.Card}"/>

        <Style x:Key="CardHeaderText" TargetType="TextBlock" BasedOn="{StaticResource Nova.SectionTitle}"/>

        <!-- Single-select machine mode chip. Despite the name it IS a button, so
             it wears the button outline in every state; selection is shown by the
             lighter fill and the dot, not by swapping the border colour. -->
        <Style x:Key="ModeChip" TargetType="Button">
            <Setter Property="IsEnabled" Value="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            <Setter Property="ToolTip" Value="{Binding UnavailableReason}"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Setter Property="Height" Value="{DynamicResource Nova.Button.Height}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="chip" CornerRadius="{DynamicResource Nova.Button.CornerRadius}" Padding="14,0"
                                BorderThickness="{DynamicResource Nova.Button.BorderThickness}"
                                Background="{DynamicResource Nova.Button.SurfaceBrush}"
                                BorderBrush="{DynamicResource Nova.Button.BorderBrush}"
                                Effect="{DynamicResource EffectShadow1}">
                            <Grid>
                                <TextBlock Text="{loc:TrBinding Name}" FontSize="{DynamicResource Nova.FontSize.Body}"
                                           FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <Ellipse x:Name="dot" Width="9" Height="9" HorizontalAlignment="Right" VerticalAlignment="Center"
                                         Fill="{DynamicResource SuccessBrush}" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="chip" Property="Background" Value="{DynamicResource RegionBrush}"/>
                                <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chip" Property="Effect" Value="{DynamicResource EffectShadow2}"/>
                                <Setter TargetName="chip" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="-1"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="chip" Property="Effect" Value="{x:Null}"/>
                                <Setter TargetName="chip" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="1"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="chip" Property="Opacity" Value="0.40"/>
                                <Setter TargetName="chip" Property="Effect" Value="{x:Null}"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- A mode the PLC has no run mode for cannot be picked; the tooltip says why. -->
                <DataTrigger Binding="{Binding IsSupported}" Value="False">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Bypass toggle row. The row itself is NOT pressable (the switch is), so
             it stays a flat labelled surface: no outline, and the on-state is shown
             by a lighter fill instead of the black border it used to grow. -->
        <DataTemplate x:Key="BypassRowTemplate">

            <Border x:Name="row" CornerRadius="{DynamicResource Nova.Button.CornerRadius}" Padding="14,0" Height="{DynamicResource Nova.Button.Height}" Margin="0,0,0,8"
                    BorderThickness="{DynamicResource Nova.Button.BorderThickness}"
                    BorderBrush="{DynamicResource Nova.Button.BorderBrush}"
                    Background="{DynamicResource Nova.Button.SurfaceBrush}"
                    Effect="{DynamicResource EffectShadow1}">

                <Grid>
                    <TextBlock Text="{loc:TrBinding Name}" Style="{StaticResource Nova.LabelText}"/>
                    <ToggleButton HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Style="{StaticResource ToggleButtonSwitch}" IsChecked="{Binding IsOn, Mode=TwoWay}"
                                  IsEnabled="{Binding IsEnabled}"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsOn}" Value="True">
                    <Setter TargetName="row" Property="Background" Value="{DynamicResource RegionBrush}"/>
                    <Setter TargetName="row" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <!-- System Settings + Bypass Settings centered in the screen; Edit/Save top right.
         (The TCP IP / Serial Comm grids live in Axis Parameter Settings.) -->
    <!-- Status line and Edit/Save have a row of their own above the cards: centred in
         the whole page, the cards ran up over them on a short screen. -->
    <Grid Margin="8,6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- What the PLC reports: its run mode and whether it takes a change now. -->
        <DockPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="2,0,12,0">
            <Ellipse DockPanel.Dock="Left" Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,8,0">
                <Ellipse.Style>
                    <Style TargetType="Ellipse">
                        <Setter Property="Fill" Value="{DynamicResource DangerBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPlcLive}" Value="True">
                                <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
            </Ellipse>
            <TextBlock Text="{Binding PlcStatusText}" Style="{StaticResource Nova.LabelText}" VerticalAlignment="Center"
                       TextWrapping="Wrap"/>
        </DockPanel>

        <!-- Action bar -->
        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Style="{StaticResource Nova.ButtonInfo}"
                    Command="{Binding EditCommand}" IsEnabled="{Binding CanEdit}">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconLucide Kind="Pencil" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Tr Txt_Edit}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource Nova.ButtonPrimary}" Margin="10,0,0,0"
                    Command="{Binding SaveCommand}" IsEnabled="{Binding IsEditing}">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconLucide Kind="Save" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Tr Txt_Save}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- The cards sit under the bar, centred across; Maintenance Mode's station list
             makes the left card taller, so the area scrolls rather than clipping. -->
        <ScrollViewer Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="LayoutGrid" Width="16" Height="16" VerticalAlignment="Center"
                                                      Margin="0,0,8,0" Foreground="{DynamicResource PrimaryBrush}"/>
                            <TextBlock Text="{loc:Tr Txt_SystemSettings}" Style="{StaticResource CardHeaderText}"/>
                        </StackPanel>
                        <iconPacks:PackIconLucide Kind="EllipsisVertical" Width="16" Height="16" HorizontalAlignment="Right"
                                                  VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Modes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ModeChip}"
                                        Command="{Binding DataContext.SelectModeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Maintenance Mode: the stations it takes out of production. -->
                    <StackPanel Margin="0,6,0,0"
                                Visibility="{Binding IsMaintenanceSelected, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{loc:Tr Txt_MaintenanceStations}" Style="{StaticResource Nova.LabelText}" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding MaintenanceStations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="row" CornerRadius="{DynamicResource Nova.Button.CornerRadius}" Padding="14,0"
                                            Height="{DynamicResource Nova.Button.Height}" Margin="0,0,0,8"
                                            BorderThickness="{DynamicResource Nova.Button.BorderThickness}"
                                            BorderBrush="{DynamicResource Nova.Button.BorderBrush}"
                                            Background="{DynamicResource Nova.Button.SurfaceBrush}"
                                            Effect="{DynamicResource EffectShadow1}">
                                        <CheckBox Content="{loc:TrBinding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  VerticalAlignment="Center" FontSize="{DynamicResource Nova.FontSize.Body}">
                                            <CheckBox.Style>
                                                <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                                    <Setter Property="IsEnabled" Value="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                    <Style.Triggers>
                                                        <!-- A station the PLC cannot hold out stays locked. -->
                                                        <DataTrigger Binding="{Binding IsSupported}" Value="False">
                                                            <Setter Property="IsEnabled" Value="False"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </CheckBox.Style>
                                        </CheckBox>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="row" Property="Background" Value="{DynamicResource RegionBrush}"/>
                                            <Setter TargetName="row" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="CircleAlert" Width="16" Height="16" VerticalAlignment="Center"
                                                      Margin="0,0,8,0" Foreground="{DynamicResource PrimaryBrush}"/>
                            <TextBlock Text="{loc:Tr Txt_BypassSettings}" Style="{StaticResource CardHeaderText}"/>
                        </StackPanel>
                        <iconPacks:PackIconLucide Kind="EllipsisVertical" Width="16" Height="16" HorizontalAlignment="Right"
                                                  VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Bypasses}" ItemTemplate="{StaticResource BypassRowTemplate}"/>
                </StackPanel>
            </Border>
        </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
