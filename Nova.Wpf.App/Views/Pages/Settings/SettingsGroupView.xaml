<UserControl x:Class="Nova.Wpf.App.Views.Pages.Settings.SettingsGroupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settingsVm="clr-namespace:Nova.ViewModels.Pages.Settings;assembly=Nova.ViewModels"
             xmlns:local="clr-namespace:Nova.Wpf.App.Views.Pages.Settings"
             Background="Transparent">

    <!-- Nested tab control (same connected style as the parent Settings tabs). -->
    <Grid Margin="8">
        <TabControl ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}">
            <TabControl.Resources>
                <DataTemplate DataType="{x:Type settingsVm:SettingsTabViewModel}">
                    <local:SettingsFormView/>
                </DataTemplate>
                <!-- Calibration sub-tabs have dedicated layouts. -->
                <DataTemplate DataType="{x:Type settingsVm:CalibrationCameraViewModel}">
                    <local:CalibrationCameraView/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type settingsVm:CalibrationRobotViewModel}">
                    <local:CalibrationRobotView/>
                </DataTemplate>
                <!-- SFC & PDCA AE-limit grids. -->
                <DataTemplate DataType="{x:Type settingsVm:AeLimitsViewModel}">
                    <local:AeLimitsView/>
                </DataTemplate>
                <!-- I/O Diagnostics sub-tabs. -->
                <DataTemplate DataType="{x:Type settingsVm:DigitalIoViewModel}">
                    <local:DigitalIoView/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type settingsVm:AnalogIoViewModel}">
                    <local:AnalogIoView/>
                </DataTemplate>
            </TabControl.Resources>
        </TabControl>
    </Grid>
</UserControl>
