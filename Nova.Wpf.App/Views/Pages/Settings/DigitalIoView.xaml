<UserControl x:Class="Nova.Wpf.App.Views.Pages.Settings.DigitalIoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:ui="clr-namespace:Nova.Wpf.UI.Components;assembly=Nova.Wpf.UI"
             Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border" BasedOn="{StaticResource Nova.Card}"/>

        <Style x:Key="CountBadge" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SecondaryRegionBrush}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>



        <!-- Input row: name + indicator dot (right-aligned) -->
        <DataTemplate x:Key="InputRowTemplate">
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="2,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}" FontSize="{DynamicResource Nova.FontSize.Body}" VerticalAlignment="Center"
                               FontFamily="Consolas, Cascadia Mono, monospace"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Address}" Margin="10,0,4,0"
                               FontSize="{DynamicResource Nova.FontSize.Caption}"
                               FontFamily="Consolas, Cascadia Mono, monospace"
                               VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <ui:StatusIndicator Grid.Column="2" IsActive="{Binding IsOn}"
                                        VerticalAlignment="Center" Margin="10,0,4,0"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Output row: name + address + toggle switch -->
        <DataTemplate x:Key="OutputRowTemplate">
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="2,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}" FontSize="{DynamicResource Nova.FontSize.Body}" VerticalAlignment="Center"
                               FontFamily="Consolas, Cascadia Mono, monospace"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Address}" Margin="10,0,4,0"
                               FontSize="{DynamicResource Nova.FontSize.Caption}"
                               FontFamily="Consolas, Cascadia Mono, monospace"
                               VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>

                    <ToggleButton Grid.Column="2" Style="{StaticResource ToggleButtonSwitch}"

                                  VerticalAlignment="Center" Margin="10,0,4,0"
                                  Command="{Binding DataContext.ToggleOutputCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}"
                                  IsChecked="{Binding IsOn, Mode=OneWay}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="8,6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ Inputs ============ -->
        <Border Grid.Column="0" Style="{StaticResource Card}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock Text="Input Name" Style="{StaticResource Nova.SectionTitle}"/>
                    <Border Style="{StaticResource CountBadge}" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ActiveCountText}" FontSize="{DynamicResource Nova.FontSize.Caption}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                    </Border>
                </Grid>

                <Border DockPanel.Dock="Top" CornerRadius="8" Height="34" Margin="0,0,0,10"
                        Background="{DynamicResource Nova.TableHeaderBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <iconPacks:PackIconLucide Grid.Column="0" Kind="Search" Width="14" Height="14" Margin="10,0,8,0"
                                                  VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBox Grid.Column="1" VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent"
                                 FontSize="{DynamicResource Nova.FontSize.Body}" Text="{Binding InputSearch, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="2" Style="{StaticResource Nova.ButtonIconInline}"
                                Command="{Binding ClearInputSearchCommand}" Margin="0,0,8,0" HorizontalAlignment="Right">
                            <iconPacks:PackIconLucide Kind="CircleX" Width="14" Height="14" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </Button>
                    </Grid>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Inputs}" ItemTemplate="{StaticResource InputRowTemplate}"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ============ Outputs ============ -->
        <Border Grid.Column="2" Style="{StaticResource Card}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock Text="Output Name" Style="{StaticResource Nova.SectionTitle}"/>
                    <Border Style="{StaticResource CountBadge}" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ForcedCountText}" FontSize="{DynamicResource Nova.FontSize.Caption}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                    </Border>
                </Grid>

                <Border DockPanel.Dock="Top" CornerRadius="8" Height="34" Margin="0,0,0,10"
                        Background="{DynamicResource Nova.TableHeaderBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <iconPacks:PackIconLucide Grid.Column="0" Kind="Search" Width="14" Height="14" Margin="10,0,8,0"
                                                  VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBox Grid.Column="1" VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent"
                                 FontSize="{DynamicResource Nova.FontSize.Body}" Text="{Binding OutputSearch, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="2" Style="{StaticResource Nova.ButtonIconInline}"
                                Command="{Binding ClearOutputSearchCommand}" Margin="0,0,8,0" HorizontalAlignment="Right">
                            <iconPacks:PackIconLucide Kind="CircleX" Width="14" Height="14" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </Button>
                    </Grid>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Outputs}" ItemTemplate="{StaticResource OutputRowTemplate}"/>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
