<UserControl x:Class="Nova.Wpf.App.Views.Pages.Settings.AxisConfigurationTableView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:loc="clr-namespace:Nova.Wpf.UI.Localization;assembly=Nova.Wpf.UI"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:common="clr-namespace:Nova.Wpf.App.Views.Common"
             Background="Transparent">

    <!-- Axis parameter table card -->
    <Border Background="{DynamicResource RegionBrush}" CornerRadius="8" Margin="10"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Effect="{StaticResource EffectShadow1}">
        <DockPanel Margin="14">

            <!-- Card header: title + Edit/Save buttons -->
            <Grid DockPanel.Dock="Top" Margin="2,0,2,12">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconLucide Kind="SlidersHorizontal" Width="16" Height="16" VerticalAlignment="Center"
                                              Margin="0,0,8,0" Foreground="{DynamicResource PrimaryBrush}"/>
                    <TextBlock Text="{loc:Tr Txt_AxisConfiguration}" Style="{StaticResource Nova.SectionTitle}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource Nova.ButtonInfo}"
                            Command="{Binding EditCommand}" IsEnabled="{Binding CanEdit}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="Pencil" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Tr Txt_Edit}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Nova.ButtonPrimary}" Margin="10,0,0,0"
                            Command="{Binding SaveCommand}" IsEnabled="{Binding IsEditing}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="Save" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Tr Txt_Save}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Dynamic DataGrid using Nova.DataGrid and DynamicGridHelper -->
            <DataGrid Style="{StaticResource Nova.DataGrid}"
                      ItemsSource="{Binding Rows}"
                      common:DynamicGridHelper.ColumnsSource="{Binding Columns}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="False"
                      HeadersVisibility="Column"/>
        </DockPanel>
    </Border>
</UserControl>

