<UserControl x:Class="Nova.Wpf.App.Views.Pages.Settings.CalibrationCameraView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource Nova.FieldLabel}">
            <Setter Property="Margin" Value="0"/>
        </Style>

        <!-- Shared Nova affordance (black outline, radius, four states) at the
             local 46px process-button height. -->
        <Style x:Key="ProcButton" TargetType="Button" BasedOn="{StaticResource Nova.ButtonSecondary}">
            <Setter Property="Height" Value="46"/>
            <Setter Property="MinWidth" Value="0"/>
        </Style>
        <Style x:Key="StartButton" TargetType="Button" BasedOn="{StaticResource ProcButton}">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ReverseTextBrush}"/>
        </Style>
        <!-- App-wide stop colour (danger) -->
        <Style x:Key="StopButton" TargetType="Button" BasedOn="{StaticResource ProcButton}">
            <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ReverseTextBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Border Background="{DynamicResource RegionBrush}" CornerRadius="8" Padding="24" Width="520"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Effect="{StaticResource EffectShadow1}">
            <StackPanel>
                <!-- Header -->
                <Grid Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="Camera" Width="18" Height="18" VerticalAlignment="Center"
                                                  Margin="0,0,8,0" Foreground="{DynamicResource PrimaryBrush}"/>
                        <TextBlock Text="CCD Calibration" FontSize="{DynamicResource Nova.FontSize.Heading}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                    </StackPanel>
                    <iconPacks:PackIconLucide Kind="EllipsisVertical" Width="16" Height="16" HorizontalAlignment="Right"
                                              VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                </Grid>

                <!-- Choose camera -->
                <TextBlock Text="CHOOSE CAMERA" Style="{StaticResource Caption}" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <RadioButton Content="CCD 1, 2, 3" GroupName="cam" VerticalContentAlignment="Center"
                                 IsChecked="{Binding IsCcd123, Mode=TwoWay}" Margin="0,0,32,0"/>
                    <RadioButton Content="CCD 4" GroupName="cam" VerticalContentAlignment="Center"
                                 IsChecked="{Binding IsCcd4, Mode=TwoWay}"/>
                </StackPanel>

                <!-- Start / Stop -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource StartButton}" Command="{Binding StartCommand}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="Play" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Start" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource StopButton}" Command="{Binding StopCommand}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="Square" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Stop" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Current status -->
                <Border Background="{DynamicResource Nova.TableHeaderBrush}" CornerRadius="8" Padding="16,12" Margin="0,20,0,0"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="CURRENT STATUS" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding StatusText}" FontSize="{DynamicResource Nova.FontSize.Body}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryBrush}"/>
                        </StackPanel>
                        <!-- Status badge = label: no outline (that reads as a button).
                             The dot and the green text carry the state. Thickness is
                             kept with a transparent brush so nothing shifts. -->
                        <Border x:Name="OnlineBadge" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="10" Padding="10,3"
                                Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0" Fill="{DynamicResource SuccessBrush}"/>
                                <TextBlock Text="ONLINE" FontSize="{DynamicResource Nova.FontSize.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}"/>
                            </StackPanel>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>