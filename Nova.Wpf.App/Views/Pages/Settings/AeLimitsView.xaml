<UserControl x:Class="Nova.Wpf.App.Views.Pages.Settings.AeLimitsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:loc="clr-namespace:Nova.Wpf.UI.Localization;assembly=Nova.Wpf.UI"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:common="clr-namespace:Nova.Wpf.App.Views.Common"
             Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource Nova.ButtonOutline}"/>


    </UserControl.Resources>

    <Border Background="{DynamicResource RegionBrush}" CornerRadius="8" Margin="0,6,0,0"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Effect="{StaticResource EffectShadow1}">
        <DockPanel Margin="14">
            <!-- Toolbar -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                <Border CornerRadius="8" Height="{DynamicResource Nova.Field.Height}" Width="320" HorizontalAlignment="Left"
                        Background="{DynamicResource RegionBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <iconPacks:PackIconLucide Grid.Column="0" Kind="Search" Width="15" Height="15" Margin="12,0,8,0"
                                                  VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBox Grid.Column="1" VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent"
                                 hc:InfoElement.Placeholder="{loc:Tr Txt_SearchParameters}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="2" Style="{StaticResource Nova.ButtonIconInline}"
                                Command="{Binding ClearSearchCommand}" Margin="0,0,8,0" ToolTip="{loc:Tr Txt_Clear}">
                            <iconPacks:PackIconLucide Kind="CircleX" Width="15" Height="15" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </Button>
                    </Grid>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource ToolButton}" Command="{Binding FilterCommand}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="ListFilter" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Tr Txt_Filter}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Command="{Binding ExportCommand}" Margin="8,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="Download" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Tr Txt_Export}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Command="{Binding EditCommand}" IsEnabled="{Binding CanEdit}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="Pencil" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Tr Txt_Edit}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Nova.ButtonPrimary}" Margin="8,0,0,0"
                            Command="{Binding SaveCommand}" IsEnabled="{Binding IsEditing}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="Save" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Tr Txt_Save}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Filter row: revealed by the Filter button above. A column can be picked,
                 or "All columns" to match a unit or a limit value without choosing. -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFilterVisible}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <ComboBox Width="180" Height="{DynamicResource Nova.Field.Height}" VerticalContentAlignment="Center"
                          ItemsSource="{Binding FilterColumns}" ItemTemplate="{StaticResource Loc.ItemText}"
                          SelectedItem="{Binding FilterColumn, Mode=TwoWay}"/>

                <Border CornerRadius="8" Height="{DynamicResource Nova.Field.Height}" Width="280" Margin="8,0,0,0"
                        Background="{DynamicResource RegionBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <iconPacks:PackIconLucide Grid.Column="0" Kind="ListFilter" Width="14" Height="14" Margin="10,0,6,0"
                                                  VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBox Grid.Column="1" VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent"
                                 hc:InfoElement.Placeholder="{loc:Tr Txt_FilterValue}"
                                 Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="2" Style="{StaticResource Nova.ButtonIconInline}"
                                Command="{Binding ClearFilterCommand}" Margin="0,0,8,0" ToolTip="{loc:Tr Txt_ClearFilter}">
                            <iconPacks:PackIconLucide Kind="CircleX" Width="14" Height="14" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </Button>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Footer: range -->
            <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <TextBlock Text="{loc:TrBinding RangeText}" FontSize="{DynamicResource Nova.FontSize.Body}" VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>
            </Grid>

            <!-- Dynamic DataGrid using Nova.DataGrid -->
            <DataGrid Style="{StaticResource Nova.DataGrid}"
                      ItemsSource="{Binding Rows}"
                      common:DynamicGridHelper.ColumnsSource="{Binding Columns}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="False"
                      HeadersVisibility="Column"/>
        </DockPanel>
    </Border>
</UserControl>

