<UserControl x:Class="Nova.Wpf.App.Views.Pages.Settings.CalibrationRobotView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource Nova.FieldLabel}"/>

        <Style x:Key="FilledButton" TargetType="Button" BasedOn="{StaticResource Nova.ButtonPrimary}"/>
        <Style x:Key="OutlineButton" TargetType="Button" BasedOn="{StaticResource Nova.ButtonOutline}"/>
        <Style x:Key="ResetLink" TargetType="Button" BasedOn="{StaticResource Nova.ButtonDangerLink}"/>

        <DataTemplate x:Key="StreamLineTemplate">
            <StackPanel Orientation="Horizontal" Margin="0,1">
                <TextBlock Text="&gt;&gt;" FontFamily="Consolas, Cascadia Mono, monospace" FontSize="{DynamicResource Nova.FontSize.Body}"
                           Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,8,0"/>
                <TextBlock x:Name="LineText" Text="{Binding Text}" FontFamily="Consolas, Cascadia Mono, monospace"
                           FontSize="{DynamicResource Nova.FontSize.Body}" Foreground="{DynamicResource ReverseTextBrush}"/>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsAck}" Value="True">
                    <Setter TargetName="LineText" Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Border Background="{DynamicResource RegionBrush}" CornerRadius="8" Padding="24" Width="520"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Effect="{StaticResource EffectShadow1}">
            <StackPanel>
                <!-- Header -->
                <Grid Margin="0,0,0,18">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="Bot" Width="18" Height="18" VerticalAlignment="Center"
                                                  Margin="0,0,8,0" Foreground="{DynamicResource PrimaryBrush}"/>
                        <TextBlock Text="Robot" FontSize="{DynamicResource Nova.FontSize.Heading}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- Comm status = label: no outline, state reads from the dot
                             and the text colour. -->
                        <Border x:Name="CommBadge" CornerRadius="10" Padding="10,3" VerticalAlignment="Center"
                                Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="CommDot" Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0"
                                         Fill="{DynamicResource DangerBrush}"/>
                                <TextBlock x:Name="CommText" Text="{Binding CommStatusText}" FontSize="{DynamicResource Nova.FontSize.Caption}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource DangerBrush}"/>
                            </StackPanel>
                        </Border>
                        <iconPacks:PackIconLucide Kind="EllipsisVertical" Width="16" Height="16" VerticalAlignment="Center"
                                                  Margin="10,0,0,0" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                </Grid>

                <!-- Trigger command -->
                <TextBlock Text="SELECT TRIGGER COMMAND" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                <ComboBox Height="32" VerticalContentAlignment="Center" ItemsSource="{Binding Commands}"
                          SelectedItem="{Binding SelectedCommand, Mode=TwoWay}"/>

                <!-- Received data stream -->
                <TextBlock Text="RECEIVED DATA STREAM" Style="{StaticResource Caption}" Margin="0,16,0,6"/>
                <Border CornerRadius="8" Background="{DynamicResource PrimaryTextBrush}" Height="150" Effect="{StaticResource EffectShadow1}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,10">
                        <ItemsControl ItemsSource="{Binding DataStream}" ItemTemplate="{StaticResource StreamLineTemplate}"/>
                    </ScrollViewer>
                </Border>

                <!-- Actions -->
                <Grid Margin="0,18,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Style="{StaticResource FilledButton}" Content="Connect" Command="{Binding ConnectCommand}"
                                IsEnabled="{Binding CanConnect}"/>
                        <Button Style="{StaticResource OutlineButton}" Content="Trigger" Command="{Binding TriggerCommand}"
                                IsEnabled="{Binding IsConnected}" Margin="10,0,0,0"/>
                    </StackPanel>
                    <Button Style="{StaticResource ResetLink}" Command="{Binding ManualResetCommand}" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="Diamond" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="MANUAL RESET" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
