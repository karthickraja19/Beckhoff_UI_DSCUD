<UserControl x:Class="Nova.Wpf.App.Views.Pages.Recipe.GantryRecipeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:common="clr-namespace:Nova.Wpf.App.Views.Common"
             xmlns:behaviors="clr-namespace:Nova.Wpf.UI.Behaviors;assembly=Nova.Wpf.UI"
             Background="Transparent">

    <UserControl.Resources>
        <!-- Narrow columns: shared header typography, tighter margin to match cells. -->
        <Style x:Key="HeaderCell" TargetType="TextBlock" BasedOn="{StaticResource Nova.TableHeaderText}">
            <Setter Property="Margin" Value="8,0"/>
        </Style>
        <Style x:Key="CompactGridHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource Nova.DataGridColumnHeader}">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>

        <Style x:Key="CenteredHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource CompactGridHeader}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <!-- Flat numeric cell: plain text until Edit mode (same pattern as Axis Parameters). -->
        <Style x:Key="CellBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Padding" Value="3,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="{DynamicResource Nova.FontSize.Body}"/>
            <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, monospace"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="IsReadOnly" Value="{Binding DataContext.IsReadOnlyMode, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            <Style.Triggers>
                <Trigger Property="IsReadOnly" Value="False">
                    <Setter Property="Background" Value="{DynamicResource RegionBrush}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RecipeCard" TargetType="Border" BasedOn="{StaticResource Nova.Card}">
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <Style x:Key="CardHeaderText" TargetType="TextBlock" BasedOn="{StaticResource Nova.SectionTitle}"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Nova.FieldLabel}">
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>

        <!-- Speed: unsigned, and the view model refuses anything above the axis
             parameter speed. -->
        <Style x:Key="InputField" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="behaviors:NumericInput.Mode" Value="Decimal"/>
        </Style>

        <!-- Position: signed. In Absolute mode it is a coordinate (this machine teaches
             X = -200), in Relative mode a distance whose sign is the direction. -->
        <Style x:Key="PositionInputField" TargetType="TextBox" BasedOn="{StaticResource InputField}">
            <Setter Property="behaviors:NumericInput.Mode" Value="SignedDecimal"/>
        </Style>

        <!-- Square icon-only jog button -->
        <Style x:Key="JogButton" TargetType="Button" BasedOn="{StaticResource Nova.ButtonPrimary}">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="46"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="3"/>
        </Style>

        <!-- Jog readout label / value. The label is a plain caption (regular
             weight); the value below it carries the emphasis. -->
        <Style x:Key="ReadoutLabel" TargetType="TextBlock" BasedOn="{StaticResource Nova.FieldLabel}">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style x:Key="ReadoutValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource Nova.FontSize.Readout}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, monospace"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>

        <!-- Selectable table row: left accent + bottom rule, no default ListBox chrome -->
        <Style x:Key="PositionRowContainer" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                                Background="{TemplateBinding Background}" MinHeight="38">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Accent" Background="Transparent"/>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SecondaryRegionBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SecondaryRegionBrush}"/>
                                <Setter TargetName="Accent" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One taught-position row -->
        <DataTemplate x:Key="PositionRowTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="0.55*"/>
                    <ColumnDefinition Width="0.9*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="0.55*"/>
                    <ColumnDefinition Width="0.9*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="0.55*"/>
                    <ColumnDefinition Width="0.9*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding Position}" FontSize="{DynamicResource Nova.FontSize.Body}" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                <TextBox Grid.Column="1" Style="{StaticResource CellBox}" Text="{Binding X, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBox Grid.Column="2" Style="{StaticResource CellBox}" Text="{Binding XVel, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBox Grid.Column="3" Style="{StaticResource CellBox}" Text="{Binding XAcc, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBox Grid.Column="4" Style="{StaticResource CellBox}" Text="{Binding XDeAcc, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBox Grid.Column="5" Style="{StaticResource CellBox}" Text="{Binding Y, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBox Grid.Column="6" Style="{StaticResource CellBox}" Text="{Binding YVel, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBox Grid.Column="7" Style="{StaticResource CellBox}" Text="{Binding YAcc, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBox Grid.Column="8" Style="{StaticResource CellBox}" Text="{Binding YDeAcc, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBox Grid.Column="9" Style="{StaticResource CellBox}" Text="{Binding Z, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBox Grid.Column="10" Style="{StaticResource CellBox}" Text="{Binding ZVel, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBox Grid.Column="11" Style="{StaticResource CellBox}" Text="{Binding ZAcc, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBox Grid.Column="12" Style="{StaticResource CellBox}" Text="{Binding ZDeAcc, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <!-- Module selector + position table -->
            <RowDefinition Height="Auto"/>
            <!-- Servo motion / jog / loadcells -->
        </Grid.RowDefinitions>

        <!-- ============ Positions card ============ -->
        <Border Grid.Row="0" Style="{StaticResource RecipeCard}">
            <DockPanel>

                <!-- Header: module selector + Edit/Save -->
                <Grid DockPanel.Dock="Top" Margin="2,0,2,12">
                    <StackPanel>
                        <TextBlock Text="SELECT GANTRY MODULE" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                        <Grid Width="280" HorizontalAlignment="Left">
                            <ComboBox Height="32" Padding="30,0,8,0" VerticalContentAlignment="Center"
                                      ItemsSource="{Binding GantryModules}"
                                      SelectedItem="{Binding SelectedGantryModule, Mode=TwoWay}"/>
                            <iconPacks:PackIconLucide Kind="Search" Width="14" Height="14" Margin="10,0,0,0"
                                                      HorizontalAlignment="Left" VerticalAlignment="Center"
                                                      IsHitTestVisible="False"
                                                      Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                        <Button Style="{StaticResource Nova.ButtonInfo}"
                                Command="{Binding EditCommand}" IsEnabled="{Binding CanEdit}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="Pencil" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Edit" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Nova.ButtonPrimary}" Margin="10,0,0,0"
                                Command="{Binding SaveCommand}" IsEnabled="{Binding IsEditing}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="Save" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Save" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <DataGrid Style="{StaticResource Nova.DataGrid}"
                          Margin="0,2,0,0"
                          CanUserSortColumns="False"
                          ItemsSource="{Binding Rows}"
                          common:DynamicGridHelper.ColumnsSource="{Binding Columns}"
                          SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                          hc:DataGridAttach.CanUnselectAllWithBlankArea="True">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Move"
                                      Command="{Binding PlacementTarget.DataContext.MoveSelectedRowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="Teach"
                                      Command="{Binding PlacementTarget.DataContext.TeachSelectedRowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      IsEnabled="{Binding PlacementTarget.DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- ============ Bottom row: motion / jog / loadcells ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="1.9*"/>
                <ColumnDefinition Width="0.9*"/>
            </Grid.ColumnDefinitions>

            <!-- Servo motion -->
            <Border Grid.Column="0" Style="{StaticResource RecipeCard}">
                <StackPanel>
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="Move" Width="15" Height="15" VerticalAlignment="Center"
                                                      Margin="0,0,8,0" Foreground="{DynamicResource PrimaryBrush}"/>
                            <TextBlock Style="{StaticResource CardHeaderText}"
                                       Text="{Binding SelectedAxis, StringFormat='{}{0} Motion'}"/>
                        </StackPanel>
                        <iconPacks:PackIconLucide Kind="SlidersHorizontal" Width="14" Height="14"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="SELECT AXIS" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Grid.Row="1" Grid.Column="0" Height="32" VerticalContentAlignment="Center"
                                  ItemsSource="{Binding Axes}"
                                  SelectedItem="{Binding SelectedAxis, Mode=TwoWay}"/>

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="MODE" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Grid.Row="1" Grid.Column="2" Height="32" VerticalContentAlignment="Center"
                                  ItemsSource="{Binding MotionModes}"
                                  SelectedItem="{Binding SelectedMotionMode, Mode=TwoWay}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="SPEED (MM/S)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Row="3" Grid.Column="0" Style="{StaticResource InputField}"
                                 Text="{Binding Speed, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="2" Grid.Column="2" Text="POSITION (MM)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Row="3" Grid.Column="2" Style="{StaticResource PositionInputField}"
                                 Text="{Binding TargetPosition, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource Nova.ButtonPrimary}"
                                Content="Move" Command="{Binding MoveCommand}"/>
                        <Button Grid.Column="2" Style="{StaticResource Nova.ButtonDanger}"
                                Content="Stop" Command="{Binding StopCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Module jog pad -->
            <Border Grid.Column="1" Style="{StaticResource RecipeCard}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" HorizontalAlignment="Center" Margin="0,0,0,10"
                               Style="{StaticResource CardHeaderText}"
                               Text="{Binding SelectedGantryModule, StringFormat='{}{0} Jog'}"/>

                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Z jog + rotation -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <Button Style="{StaticResource JogButton}" ToolTip="{Binding ZAxisName, StringFormat='Jog {0} positive'}"
                                    IsEnabled="{Binding CanJogZ}"
                                    PreviewMouseDown="JogZPositive_PreviewMouseDown"
                                    PreviewMouseUp="Jog_PreviewMouseUp"
                                    MouseLeave="Jog_MouseLeave">
                                <iconPacks:PackIconLucide Kind="ChevronUp" Width="18" Height="18"/>
                            </Button>
                            <Button Style="{StaticResource JogButton}" ToolTip="{Binding ZAxisName, StringFormat='Jog {0} negative'}"
                                    IsEnabled="{Binding CanJogZ}"
                                    PreviewMouseDown="JogZNegative_PreviewMouseDown"
                                    PreviewMouseUp="Jog_PreviewMouseUp"
                                    MouseLeave="Jog_MouseLeave">
                                <iconPacks:PackIconLucide Kind="ChevronDown" Width="18" Height="18"/>
                            </Button>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Style="{StaticResource JogButton}" ToolTip="{Binding RAxisName, StringFormat='Rotate {0} counter-clockwise'}"
                                        IsEnabled="{Binding CanJogR}"
                                        PreviewMouseDown="JogRotateCcw_PreviewMouseDown"
                                        PreviewMouseUp="Jog_PreviewMouseUp"
                                        MouseLeave="Jog_MouseLeave">
                                    <iconPacks:PackIconLucide Kind="RotateCcw" Width="16" Height="16"/>
                                </Button>
                                <Button Style="{StaticResource JogButton}" ToolTip="{Binding RAxisName, StringFormat='Rotate {0} clockwise'}"
                                        IsEnabled="{Binding CanJogR}"
                                        PreviewMouseDown="JogRotateCw_PreviewMouseDown"
                                        PreviewMouseUp="Jog_PreviewMouseUp"
                                        MouseLeave="Jog_MouseLeave">
                                    <iconPacks:PackIconLucide Kind="RotateCw" Width="16" Height="16"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <!-- X/Y jog diamond -->
                        <Grid Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource JogButton}"
                                    ToolTip="{Binding YAxisName, StringFormat='Jog {0} positive'}" IsEnabled="{Binding CanJogY}"
                                    PreviewMouseDown="JogYPositive_PreviewMouseDown"
                                    PreviewMouseUp="Jog_PreviewMouseUp"
                                    MouseLeave="Jog_MouseLeave">
                                <iconPacks:PackIconLucide Kind="ChevronUp" Width="18" Height="18"/>
                            </Button>
                            <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource JogButton}"
                                    ToolTip="{Binding XAxisName, StringFormat='Jog {0} negative'}" IsEnabled="{Binding CanJogX}"
                                    PreviewMouseDown="JogXNegative_PreviewMouseDown"
                                    PreviewMouseUp="Jog_PreviewMouseUp"
                                    MouseLeave="Jog_MouseLeave">
                                <iconPacks:PackIconLucide Kind="ChevronLeft" Width="18" Height="18"/>
                            </Button>
                            <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource JogButton}"
                                    ToolTip="{Binding XAxisName, StringFormat='Jog {0} positive'}" IsEnabled="{Binding CanJogX}"
                                    PreviewMouseDown="JogXPositive_PreviewMouseDown"
                                    PreviewMouseUp="Jog_PreviewMouseUp"
                                    MouseLeave="Jog_MouseLeave">
                                <iconPacks:PackIconLucide Kind="ChevronRight" Width="18" Height="18"/>
                            </Button>
                            <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource JogButton}"
                                    ToolTip="{Binding YAxisName, StringFormat='Jog {0} negative'}" IsEnabled="{Binding CanJogY}"
                                    PreviewMouseDown="JogYNegative_PreviewMouseDown"
                                    PreviewMouseUp="Jog_PreviewMouseUp"
                                    MouseLeave="Jog_MouseLeave">
                                <iconPacks:PackIconLucide Kind="ChevronDown" Width="18" Height="18"/>
                            </Button>
                        </Grid>

                        <!-- Live positions -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="90">
                            <TextBlock Text="X POS" Style="{StaticResource ReadoutLabel}"/>
                            <TextBlock Text="{Binding XPos, StringFormat={}{0:0.00}}" Style="{StaticResource ReadoutValue}"/>
                            <TextBlock Text="Y POS" Style="{StaticResource ReadoutLabel}"/>
                            <TextBlock Text="{Binding YPos, StringFormat={}{0:0.00}}" Style="{StaticResource ReadoutValue}"/>
                            <TextBlock Text="Z POS" Style="{StaticResource ReadoutLabel}"/>
                            <TextBlock Text="{Binding ZPos, StringFormat={}{0:0.00}}" Style="{StaticResource ReadoutValue}"/>
                            <TextBlock Text="R POS" Style="{StaticResource ReadoutLabel}"/>
                            <TextBlock Text="{Binding RPos, StringFormat={}{0:0.00}}" Style="{StaticResource ReadoutValue}" Margin="0"/>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Loadcells -->
            <Border Grid.Column="2" Style="{StaticResource RecipeCard}">
                <ItemsControl ItemsSource="{Binding LoadCells}" VerticalAlignment="Center">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="4" Padding="12,10" Margin="0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" FontSize="{DynamicResource Nova.FontSize.Body}" FontWeight="Bold"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Value, StringFormat={}{0:00.00}}"
                                                   FontSize="{DynamicResource Nova.FontSize.Readout}" FontWeight="Bold"
                                                   FontFamily="Consolas, Cascadia Mono, monospace"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        <TextBlock Text="KG" FontSize="{DynamicResource Nova.FontSize.Caption}" FontWeight="SemiBold" Margin="4,0,0,2"
                                                   VerticalAlignment="Bottom"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Grid>
    </Grid>
</UserControl>