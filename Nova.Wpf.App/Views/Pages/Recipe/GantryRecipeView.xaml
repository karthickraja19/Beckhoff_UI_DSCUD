<UserControl x:Class="Nova.Wpf.App.Views.Pages.Recipe.GantryRecipeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:loc="clr-namespace:Nova.Wpf.UI.Localization;assembly=Nova.Wpf.UI"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:common="clr-namespace:Nova.Wpf.App.Views.Common"
             xmlns:behaviors="clr-namespace:Nova.Wpf.UI.Behaviors;assembly=Nova.Wpf.UI"
             Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="RecipeCard" TargetType="Border" BasedOn="{StaticResource Nova.Card}">
            <Setter Property="Margin" Value="{DynamicResource Nova.Card.Gap}"/>
        </Style>

        <Style x:Key="CardHeaderText" TargetType="TextBlock" BasedOn="{StaticResource Nova.SectionTitle}"/>

        <!-- Every card title on this tab: coloured icon, then the title, left-aligned. -->
        <Style x:Key="CardHeaderIcon" TargetType="iconPacks:PackIconLucide">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
        </Style>

        <!-- Small caption over each group of jog buttons. -->
        <Style x:Key="JogGroupLabel" TargetType="TextBlock" BasedOn="{StaticResource Nova.FieldLabel}">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Nova.FieldLabel}">
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>

        <!-- Speed: unsigned, and the view model refuses anything above the axis
             parameter speed. -->
        <Style x:Key="InputField" TargetType="TextBox">
            <Setter Property="Height" Value="{DynamicResource Nova.Field.Height}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="behaviors:NumericInput.Mode" Value="Decimal"/>
            <!-- FAM 2 RC_05: up to 8 digits. -->
            <Setter Property="behaviors:NumericInput.MaxDigits" Value="8"/>
        </Style>

        <!-- Position: signed. In Absolute mode it is a coordinate (this machine teaches
             X = -200), in Relative mode a distance whose sign is the direction. -->
        <Style x:Key="PositionInputField" TargetType="TextBox" BasedOn="{StaticResource InputField}">
            <Setter Property="behaviors:NumericInput.Mode" Value="SignedDecimal"/>
        </Style>

        <!-- Square icon-only jog button -->
        <Style x:Key="JogButton" TargetType="Button" BasedOn="{StaticResource Nova.ButtonPrimary}">
            <Setter Property="Width" Value="40"/>
            <Setter Property="MinWidth" Value="40"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="3"/>
        </Style>

        <!-- Jog readout label / value. The label is a plain caption (regular
             weight); the value below it carries the emphasis. -->
        <Style x:Key="ReadoutLabel" TargetType="TextBlock" BasedOn="{StaticResource Nova.FieldLabel}">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style x:Key="ReadoutValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource Nova.FontSize.Readout}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, monospace"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>
    </UserControl.Resources>

    <!-- The page is the viewport's height, so the position table takes what the
         motion / jog / loadcell row leaves. On a short screen (the machine's panel)
         MinHeight wins and the tab scrolls instead of squeezing the table down to
         its column header. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="4" MinHeight="560"
          Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="240"/>
            <!-- Module selector + position table -->
            <RowDefinition Height="Auto"/>
            <!-- Servo motion / jog / loadcells -->
        </Grid.RowDefinitions>

        <!-- ============ Positions card ============ -->
        <Border Grid.Row="0" Style="{StaticResource RecipeCard}">
            <DockPanel>

                <!-- Header: module selector + Edit/Save -->
                <Grid DockPanel.Dock="Top" Margin="2,0,2,12">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Txt_SELECTGANTRYMODULE}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                        <Grid Width="280" HorizontalAlignment="Left">
                            <ComboBox Height="{DynamicResource Nova.Field.Height}" Padding="30,0,8,0" VerticalContentAlignment="Center"
                                      ItemsSource="{Binding GantryModules}"
                                      SelectedItem="{Binding SelectedGantryModule, Mode=TwoWay}"/>
                            <iconPacks:PackIconLucide Kind="Search" Width="14" Height="14" Margin="10,0,0,0"
                                                      HorizontalAlignment="Left" VerticalAlignment="Center"
                                                      IsHitTestVisible="False"
                                                      Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                        <Button Style="{StaticResource Nova.ButtonOutline}"
                                Command="{Binding EditCommand}" IsEnabled="{Binding CanEdit}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="Pencil" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Tr Txt_Edit}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Nova.ButtonPrimary}" Margin="8,0,0,0"
                                Command="{Binding SaveCommand}" IsEnabled="{Binding IsEditing}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="Save" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Tr Txt_Save}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <DataGrid Style="{StaticResource Nova.DataGrid}"
                          Margin="0,2,0,0"
                          CanUserSortColumns="False"
                          ItemsSource="{Binding Rows}"
                          common:DynamicGridHelper.ColumnsSource="{Binding Columns}"
                          SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                          hc:DataGridAttach.CanUnselectAllWithBlankArea="True">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{loc:Tr Txt_Move}"
                                      Command="{Binding PlacementTarget.DataContext.MoveSelectedRowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="{loc:Tr Txt_Teach}"
                                      Command="{Binding PlacementTarget.DataContext.TeachSelectedRowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      IsEnabled="{Binding PlacementTarget.DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- ============ Bottom row: motion / jog / loadcells ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="1.9*"/>
                <ColumnDefinition Width="0.9*"/>
            </Grid.ColumnDefinitions>

            <!-- Servo motion -->
            <Border Grid.Column="0" Style="{StaticResource RecipeCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="Move" Style="{StaticResource CardHeaderIcon}"/>
                        <TextBlock Style="{StaticResource CardHeaderText}"
                                   Text="{loc:TrBinding SelectedAxis, StringFormat='{}{0} Motion'}"/>                        
                    </StackPanel>                     

                        <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Tr Txt_SELECTAXIS}" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Grid.Row="1" Grid.Column="0" Height="{DynamicResource Nova.Field.Height}" VerticalContentAlignment="Center"
                                  ItemsSource="{Binding Axes}"
                                  SelectedItem="{Binding SelectedAxis, Mode=TwoWay}"/>

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{loc:Tr Txt_MODE}" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Grid.Row="1" Grid.Column="2" Height="{DynamicResource Nova.Field.Height}" VerticalContentAlignment="Center"
                                  ItemsSource="{Binding MotionModes}"
                                  SelectedItem="{Binding SelectedMotionMode, Mode=TwoWay}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Tr Txt_SPEEDMMS}" Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Row="3" Grid.Column="0" Style="{StaticResource InputField}"
                                 Text="{Binding Speed, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{loc:Tr Txt_POSITIONMM}" Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Row="3" Grid.Column="2" Style="{StaticResource PositionInputField}"
                                 Text="{Binding TargetPosition, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource Nova.ButtonPrimary}"
                                Content="{loc:Tr Txt_Move}" Command="{Binding MoveCommand}"/>
                        <Button Grid.Column="2" Style="{StaticResource Nova.ButtonDanger}"
                                Content="{loc:Tr Txt_Stop}" Command="{Binding StopCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Module jog pad -->
            <Border Grid.Column="1" Style="{StaticResource RecipeCard}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <iconPacks:PackIconLucide Kind="Gamepad2" Style="{StaticResource CardHeaderIcon}"/>
                        <TextBlock Style="{StaticResource CardHeaderText}"
                                   Text="{loc:TrBinding SelectedGantryModule, StringFormat='{}{0} Jog'}"/>
                    </StackPanel>

                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Z jog + rotation -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Z" Style="{StaticResource JogGroupLabel}"/>
                            <Button Style="{StaticResource JogButton}" ToolTip="{loc:TrBinding ZAxisName, StringFormat='Jog {0} positive'}"
                                    IsEnabled="{Binding CanJogZ}"
                                    PreviewMouseDown="JogZPositive_PreviewMouseDown"
                                    PreviewMouseUp="Jog_PreviewMouseUp"
                                    MouseLeave="Jog_MouseLeave">
                                <iconPacks:PackIconLucide Kind="ChevronUp" Width="18" Height="18"/>
                            </Button>
                            <Button Style="{StaticResource JogButton}" ToolTip="{loc:TrBinding ZAxisName, StringFormat='Jog {0} negative'}"
                                    IsEnabled="{Binding CanJogZ}"
                                    PreviewMouseDown="JogZNegative_PreviewMouseDown"
                                    PreviewMouseUp="Jog_PreviewMouseUp"
                                    MouseLeave="Jog_MouseLeave">
                                <iconPacks:PackIconLucide Kind="ChevronDown" Width="18" Height="18"/>
                            </Button>
                            <TextBlock Text="R" Style="{StaticResource JogGroupLabel}" Margin="0,8,0,2"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource JogButton}" ToolTip="{loc:TrBinding RAxisName, StringFormat='Rotate {0} counter-clockwise'}"
                                        IsEnabled="{Binding CanJogR}"
                                        PreviewMouseDown="JogRotateCcw_PreviewMouseDown"
                                        PreviewMouseUp="Jog_PreviewMouseUp"
                                        MouseLeave="Jog_MouseLeave">
                                    <iconPacks:PackIconLucide Kind="RotateCcw" Width="16" Height="16"/>
                                </Button>
                                <Button Style="{StaticResource JogButton}" ToolTip="{loc:TrBinding RAxisName, StringFormat='Rotate {0} clockwise'}"
                                        IsEnabled="{Binding CanJogR}"
                                        PreviewMouseDown="JogRotateCw_PreviewMouseDown"
                                        PreviewMouseUp="Jog_PreviewMouseUp"
                                        MouseLeave="Jog_MouseLeave">
                                    <iconPacks:PackIconLucide Kind="RotateCw" Width="16" Height="16"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <!-- X/Y jog diamond -->
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="X / Y" Style="{StaticResource JogGroupLabel}"/>
                            <Grid HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource JogButton}"
                                        ToolTip="{loc:TrBinding YAxisName, StringFormat='Jog {0} positive'}" IsEnabled="{Binding CanJogY}"
                                        PreviewMouseDown="JogYPositive_PreviewMouseDown"
                                        PreviewMouseUp="Jog_PreviewMouseUp"
                                        MouseLeave="Jog_MouseLeave">
                                    <iconPacks:PackIconLucide Kind="ChevronUp" Width="18" Height="18"/>
                                </Button>
                                <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource JogButton}"
                                        ToolTip="{loc:TrBinding XAxisName, StringFormat='Jog {0} negative'}" IsEnabled="{Binding CanJogX}"
                                        PreviewMouseDown="JogXNegative_PreviewMouseDown"
                                        PreviewMouseUp="Jog_PreviewMouseUp"
                                        MouseLeave="Jog_MouseLeave">
                                    <iconPacks:PackIconLucide Kind="ChevronLeft" Width="18" Height="18"/>
                                </Button>
                                <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource JogButton}"
                                        ToolTip="{loc:TrBinding XAxisName, StringFormat='Jog {0} positive'}" IsEnabled="{Binding CanJogX}"
                                        PreviewMouseDown="JogXPositive_PreviewMouseDown"
                                        PreviewMouseUp="Jog_PreviewMouseUp"
                                        MouseLeave="Jog_MouseLeave">
                                    <iconPacks:PackIconLucide Kind="ChevronRight" Width="18" Height="18"/>
                                </Button>
                                <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource JogButton}"
                                        ToolTip="{loc:TrBinding YAxisName, StringFormat='Jog {0} negative'}" IsEnabled="{Binding CanJogY}"
                                        PreviewMouseDown="JogYNegative_PreviewMouseDown"
                                        PreviewMouseUp="Jog_PreviewMouseUp"
                                        MouseLeave="Jog_MouseLeave">
                                    <iconPacks:PackIconLucide Kind="ChevronDown" Width="18" Height="18"/>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- Live positions, two by two so the readouts are no taller than
                             the jog buttons beside them. -->
                        <Grid Grid.Column="2" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="80"/>
                                <ColumnDefinition Width="Auto" MinWidth="80"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{loc:Tr Txt_XPOS}" Style="{StaticResource ReadoutLabel}"/>
                                <TextBlock Text="{Binding XPos, StringFormat={}{0:0.00}}" Style="{StaticResource ReadoutValue}"/>
                                <TextBlock Text="{loc:Tr Txt_ZPOS}" Style="{StaticResource ReadoutLabel}"/>
                                <TextBlock Text="{Binding ZPos, StringFormat={}{0:0.00}}" Style="{StaticResource ReadoutValue}" Margin="0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock Text="{loc:Tr Txt_YPOS}" Style="{StaticResource ReadoutLabel}"/>
                                <TextBlock Text="{Binding YPos, StringFormat={}{0:0.00}}" Style="{StaticResource ReadoutValue}"/>
                                <TextBlock Text="{loc:Tr Txt_RPOS}" Style="{StaticResource ReadoutLabel}"/>
                                <TextBlock Text="{Binding RPos, StringFormat={}{0:0.00}}" Style="{StaticResource ReadoutValue}" Margin="0"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Loadcells: name on its own line above the reading, so a long name is
                 trimmed instead of running into the value beside it. -->
            <Border Grid.Column="2" Style="{StaticResource RecipeCard}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <iconPacks:PackIconLucide Kind="Weight" Style="{StaticResource CardHeaderIcon}"/>
                        <TextBlock Style="{StaticResource CardHeaderText}" Text="{loc:Tr Txt_LoadCells}"/>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding LoadCells}" VerticalAlignment="Top">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{loc:TrBinding Name}" Style="{StaticResource Nova.FieldLabel}" Margin="0"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{loc:TrBinding Name}"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding Value, StringFormat={}{0:00.00}}"
                                                       FontSize="{DynamicResource Nova.FontSize.Readout}" FontWeight="Bold"
                                                       FontFamily="Consolas, Cascadia Mono, monospace"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <TextBlock Text="KG" FontSize="{DynamicResource Nova.FontSize.Caption}" FontWeight="SemiBold" Margin="4,0,0,2"
                                                       VerticalAlignment="Bottom"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
    </ScrollViewer>
</UserControl>
