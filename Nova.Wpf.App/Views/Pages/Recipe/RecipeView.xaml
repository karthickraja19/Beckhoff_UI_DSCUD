<UserControl x:Class="Nova.Wpf.App.Views.Pages.Recipe.RecipeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:loc="clr-namespace:Nova.Wpf.UI.Localization;assembly=Nova.Wpf.UI"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:recipeVm="clr-namespace:Nova.ViewModels.Pages.Recipe;assembly=Nova.ViewModels"
             xmlns:local="clr-namespace:Nova.Wpf.App.Views.Pages.Recipe"
             Background="Transparent">

    <!-- Connected-tab look + icon/label header come from the shared implicit
         TabControl/TabItem styles (Nova.Wpf.UI/Styles/TabStyles.xaml). No margin: the
         host page's padding places this strip level with the strip above it. -->
    <Grid>
        <TabControl ItemsSource="{Binding Tabs}"
                    SelectedItem="{Binding SelectedTab}">
            <TabControl.Resources>
                <!-- Content templates -->
                <DataTemplate DataType="{x:Type recipeVm:GantryRecipeViewModel}">
                    <local:GantryRecipeView/>
                </DataTemplate>

                <DataTemplate DataType="{x:Type recipeVm:RobotRecipeViewModel}">
                    <local:RobotRecipeView/>
                </DataTemplate>

                <DataTemplate DataType="{x:Type recipeVm:CNCRecipeViewModel}">
                    <local:CNCRecipeView/>
                </DataTemplate>
            </TabControl.Resources>
        </TabControl>
    </Grid>
</UserControl>
