<UserControl x:Class="Nova.Wpf.App.Views.Pages.Recipe.LightRecipeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:common="clr-namespace:Nova.Wpf.App.Views.Common"
             Background="Transparent">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page header + Edit/Save -->
        <Grid Grid.Row="0" Margin="2,0,2,14">
            <StackPanel>
                <TextBlock Text="Light Control Parameters" FontSize="{DynamicResource Nova.FontSize.Heading}" FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                <TextBlock Text="Configure precision illumination intensities for vision system calibration."
                           FontSize="{DynamicResource Nova.FontSize.Caption}" Margin="0,2,0,0"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource Nova.ButtonInfo}"
                        Command="{Binding EditCommand}" IsEnabled="{Binding CanEdit}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="Pencil" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Edit" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Nova.ButtonPrimary}" Margin="10,0,0,0"
                        Command="{Binding SaveCommand}" IsEnabled="{Binding IsEditing}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="Save" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Save" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Centered colour-code table card -->
        <Border Grid.Row="1" Background="{DynamicResource RegionBrush}" CornerRadius="8"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                Effect="{StaticResource EffectShadow1}"
                MinWidth="560" MaxWidth="900" Width="Auto" HorizontalAlignment="Center" VerticalAlignment="Top">
            <DockPanel>

                <!-- Card header -->
                <Border DockPanel.Dock="Top" Background="{DynamicResource Nova.TableHeaderBrush}"
                        CornerRadius="8,8,0,0" Padding="14,10">
                    <Grid>
                        <TextBlock Text="Colour Code Table" Style="{StaticResource Nova.SectionTitle}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding FilterSummary}" VerticalAlignment="Center" Margin="0,0,10,0"
                                       FontSize="{DynamicResource Nova.FontSize.Caption}"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <Button Style="{StaticResource Nova.ButtonIconInline}"
                                    Command="{Binding FilterCommand}" ToolTip="Filter">
                                <iconPacks:PackIconLucide Kind="ListFilter" Width="14" Height="14"
                                                          Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </Button>
                            <iconPacks:PackIconLucide Kind="EllipsisVertical" Width="14" Height="14" Margin="4,0,0,0"
                                                      VerticalAlignment="Center"
                                                      Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Filter bar: revealed by the Filter button above. Matches on every
                     column, so a colour, a colour code or an intensity all work. -->
                <Border DockPanel.Dock="Top" Margin="14,10,14,0"
                        CornerRadius="8" Height="34" HorizontalAlignment="Left" Width="280"
                        Background="{DynamicResource RegionBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFilterVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <iconPacks:PackIconLucide Grid.Column="0" Kind="ListFilter" Width="14" Height="14" Margin="10,0,6,0"
                                                  VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBox Grid.Column="1" VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent"
                                 hc:InfoElement.Placeholder="Filter colour code, colour or value"
                                 Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="2" Style="{StaticResource Nova.ButtonIconInline}"
                                Command="{Binding ClearFilterCommand}" Margin="0,0,8,0" ToolTip="Clear filter">
                            <iconPacks:PackIconLucide Kind="CircleX" Width="14" Height="14" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Dynamic DataGrid using Nova.DataGrid -->
                <DataGrid Style="{StaticResource Nova.DataGrid}"
                          Margin="14,4,14,14"
                          MinHeight="280"
                          CanUserSortColumns="False"
                          ItemsSource="{Binding Rows}"
                          common:DynamicGridHelper.ColumnsSource="{Binding Columns}"
                          SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                          hc:DataGridAttach.CanUnselectAllWithBlankArea="True"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>

