<UserControl x:Class="Nova.Wpf.App.Views.Pages.Recipe.LightRecipeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:common="clr-namespace:Nova.Wpf.App.Views.Common"
             Background="Transparent">

    <!-- One card, the same shape as the Gantry and Robot tabs: title and actions on one
         header row inside the card, the filter bar under it when shown, then the table. -->
    <Border Style="{StaticResource Nova.Card}" Margin="{DynamicResource Nova.Card.Gap}">
        <DockPanel>
            <Grid DockPanel.Dock="Top" Margin="2,0,2,12">
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="Lightbulb" Width="16" Height="16" Margin="0,0,8,0"
                                                  VerticalAlignment="Center" Foreground="{DynamicResource PrimaryBrush}"/>
                        <TextBlock Text="Light Control" Style="{StaticResource Nova.SectionTitle}"/>
                    </StackPanel>
                    <TextBlock Text="Illumination intensity for each colour channel."
                               FontSize="{DynamicResource Nova.FontSize.Caption}" Margin="0,2,0,0"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding FilterSummary}" VerticalAlignment="Center" Margin="0,0,10,0"
                               FontSize="{DynamicResource Nova.FontSize.Caption}"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <Button Style="{StaticResource Nova.ButtonOutline}" Command="{Binding FilterCommand}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="ListFilter" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Filter" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Nova.ButtonOutline}" Margin="8,0,0,0"
                            Command="{Binding EditCommand}" IsEnabled="{Binding CanEdit}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="Pencil" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Edit" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Nova.ButtonPrimary}" Margin="8,0,0,0"
                            Command="{Binding SaveCommand}" IsEnabled="{Binding IsEditing}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="Save" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Save" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Filter bar: revealed by the Filter button above. Matches on every
                 column, so a colour, a colour code or an intensity all work. -->
            <Border DockPanel.Dock="Top" Margin="0,0,0,12"
                    CornerRadius="8" Height="{DynamicResource Nova.Field.Height}" HorizontalAlignment="Left" Width="280"
                    Background="{DynamicResource RegionBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFilterVisible}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <iconPacks:PackIconLucide Grid.Column="0" Kind="ListFilter" Width="14" Height="14" Margin="10,0,6,0"
                                              VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBox Grid.Column="1" VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent"
                             hc:InfoElement.Placeholder="Filter colour code, colour or value"
                             Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Grid.Column="2" Style="{StaticResource Nova.ButtonIconInline}"
                            Command="{Binding ClearFilterCommand}" Margin="0,0,8,0" ToolTip="Clear filter">
                        <iconPacks:PackIconLucide Kind="CircleX" Width="14" Height="14" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </Button>
                </Grid>
            </Border>

            <DataGrid Style="{StaticResource Nova.DataGrid}"
                      CanUserSortColumns="False"
                      ItemsSource="{Binding Rows}"
                      common:DynamicGridHelper.ColumnsSource="{Binding Columns}"
                      SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                      hc:DataGridAttach.CanUnselectAllWithBlankArea="True"/>
        </DockPanel>
    </Border>
</UserControl>
