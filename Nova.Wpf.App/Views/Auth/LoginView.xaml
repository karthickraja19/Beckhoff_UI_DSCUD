<UserControl x:Class="Nova.Wpf.App.Views.Auth.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:loc="clr-namespace:Nova.Wpf.UI.Localization;assembly=Nova.Wpf.UI"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:converters="clr-namespace:Nova.Wpf.App.Converters"
             Background="{DynamicResource SecondaryRegionBrush}"
             Focusable="True"
             Loaded="LoginView_Loaded"
             Unloaded="LoginView_Unloaded">

    <!-- ==================================================================== -->
    <!-- LOGIN POP UP   Audio SW DFM v5.4 slide 44                            -->
    <!--                                                                      -->
    <!-- "Swipe/Scan ID card to auto load login info" - there is no username  -->
    <!-- box and no password box on this screen, because the DFM does not put -->
    <!-- any there. The card reader is a keyboard-wedge device; the code-      -->
    <!-- behind captures its keystrokes and never exposes an editable field,  -->
    <!-- which is what "Data are read only" requires.                          -->
    <!-- ==================================================================== -->

    <UserControl.Resources>
        <converters:String2VisibilityConverter x:Key="String2Visibility"/>
    </UserControl.Resources>

    <Border Style="{StaticResource Nova.Card}"
            Width="460" Padding="32"
            HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>

            <!-- Terminal being signed in to -->
            <TextBlock Style="{StaticResource Nova.PageTitle}"
                       Text="{loc:Tr Txt_SignIn}" HorizontalAlignment="Center"/>
            <TextBlock Style="{StaticResource Nova.PageSubtitle}"
                       HorizontalAlignment="Center" TextAlignment="Center"
                       Margin="0,4,0,0"
                       Text="{loc:TrBinding TerminalName, TargetNullValue='(terminal not configured)'}"/>
            <TextBlock Style="{StaticResource Nova.PageSubtitle}"
                       HorizontalAlignment="Center" TextAlignment="Center"
                       Text="{loc:TrBinding SoftwareType, StringFormat='{}{0} software'}"/>

            <!-- Card prompt -->
            <Border Margin="0,24,0,0" Padding="24"
                    Background="{DynamicResource SecondaryRegionBrush}"
                    CornerRadius="12">
                <StackPanel>
                    <iconPacks:PackIconLucide Kind="CreditCard" Width="44" Height="44"
                                              HorizontalAlignment="Center"
                                              Foreground="{DynamicResource PrimaryBrush}"/>
                    <TextBlock Margin="0,14,0,0"
                               Style="{StaticResource Nova.BodyText}"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap"
                               Text="{loc:TrBinding Prompt}"/>

                    <!-- Reader activity -->
                    <TextBlock Margin="0,10,0,0"
                               Style="{StaticResource Nova.PageSubtitle}"
                               HorizontalAlignment="Center"
                               Text="{loc:Tr Txt_CheckingAccess}"
                               Visibility="{Binding IsBusy, Converter={StaticResource Boolean2VisibilityReValueConverter}}"/>
                </StackPanel>
            </Border>

            <!-- What the access check returned. Read-only by construction: these are
                 TextBlocks, not inputs - slide 44 "Data are read only". -->
            <Grid Margin="0,20,0,0"
                  Visibility="{Binding OperatorName, Converter={StaticResource String2Visibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Nova.FieldLabel}"
                           Text="{loc:Tr Txt_Name}" Margin="0,0,16,6"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource Nova.BodyText}"
                           Text="{loc:TrBinding OperatorName}" Margin="0,0,0,6"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Nova.FieldLabel}"
                           Text="{loc:Tr Txt_Access}" Margin="0,0,16,6"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Nova.BodyText}"
                           Text="{loc:TrBinding AccessLevelText}" TextWrapping="Wrap" Margin="0,0,0,6"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Nova.FieldLabel}"
                           Text="{loc:Tr Txt_Team}" Margin="0,0,16,0"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Nova.BodyText}"
                           Text="{loc:TrBinding FunctionTeam}" TextWrapping="Wrap"/>
            </Grid>

            <!-- Refusal / second-step problem -->
            <Border Margin="0,16,0,0" Padding="12" CornerRadius="8"
                    Background="{DynamicResource DangerBrush}"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource String2Visibility}}">
                <TextBlock Text="{loc:TrBinding ErrorMessage}" TextWrapping="Wrap"
                           Foreground="{DynamicResource ReverseTextBrush}"
                           FontSize="{DynamicResource Nova.FontSize.Body}"/>
            </Border>

            <!-- Only shown while a Level 3 SI login is waiting for its second badge.
                 There is no "sign in" button anywhere on this screen: the swipe is
                 the action, per slide 44. -->
            <Button Margin="0,20,0,0" HorizontalAlignment="Center"
                    Style="{StaticResource Nova.ButtonSecondary}"
                    Content="{loc:Tr Txt_Cancel}"
                    Command="{Binding CancelVerificationCommand}"
                    Visibility="{Binding IsAwaitingVerification, Converter={StaticResource Boolean2VisibilityReValueConverter}}"/>
        </StackPanel>
    </Border>
</UserControl>
