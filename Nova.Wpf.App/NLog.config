<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
	  internalLogLevel="Trace"
      internalLogFile="C:/TEAL_Log_Data/nlog-internal.log">

	<targets>

		<!-- Running Log -->
		<target xsi:type="File"
						name="RunningLog"
						createDirs="true"
						keepFileOpen="true"
						encoding="utf-8"
						fileName="C:/TEAL_Log_Data/RunningLog/${date:format=dd-MM-yyyy}/${date:format=dd-MM-yyyy_HH}_${gdc:ShiftName}.csv"
						archiveEvery="Day"
						maxArchiveDays="60"
						header="DateTime,LogType,Module,Function Name,Station,Message,ErrorMessage,StackTraceLine,MachineName"
						layout="${message}" />
		<!-- Dryrun Log -->
		<target xsi:type="File"
						name="DryrunLog"
						createDirs="true"
						keepFileOpen="true"
						encoding="utf-8"
						fileName="C:/TEAL_Log_Data/DryrunLog/${date:format=dd-MM-yyyy}/${date:format=dd-MM-yyyy_HH}_${gdc:ShiftName}.csv"
						archiveEvery="Day"
						maxArchiveDays="60"
						header="DateTime,LogType,Module,Function Name,Station,Message,ErrorMessage,StackTraceLine,MachineName"
						layout="${message}" />
		<!-- Dummyrun Log -->
		<target xsi:type="File"
						name="DummyrunLog"
						createDirs="true"
						keepFileOpen="true"
						encoding="utf-8"
						fileName="C:/TEAL_Log_Data/DummyrunLog/${date:format=dd-MM-yyyy}/${date:format=dd-MM-yyyy_HH}_${gdc:ShiftName}.csv"
						archiveEvery="Day"
						maxArchiveDays="60"
						header="DateTime,LogType,Module,Function Name,Station,Message,ErrorMessage,StackTraceLine,MachineName"
						layout="${message}" />


		<!-- Machine Log -->
		<target xsi:type="File"
					 name="machineLog"
					 createDirs="true"
					 keepFileOpen="true"
					 encoding="utf-8"
					 fileName="C:/MachineLogs/MachineLog/${date:format=dd-MM-yyyy}/${date:format=dd-MM-yyyy_HH}.csv"
					 archiveEvery="Day"
					 maxArchiveDays="60"
					 header="DateTime,Module,Step,Class.Function,Line,Message,Extra,Exception"
					 layout="${date:format=yyyy-MM-dd HH\:mm\:ss.fff},${message},${exception:format=ToString}" />

		<!-- Error Log -->
		<target xsi:type="File"
						name="errorLog"
						createDirs="true"
						keepFileOpen="true"
						encoding="utf-8"
						fileName="C:/TEAL_Log_Data/ErrorLog/${date:format=dd-MM-yyyy}/${date:format=dd-MM-yyyy_HH}.csv"
						archiveEvery="Day"
						maxArchiveDays="60"
						header="DateTime,LogType,Module,Function,Station,Message,ErrorMessage,StackTraceLine,MachineName"
						layout="${message}" />

		<!-- Alarm Error Log -->
		<target xsi:type="File"
							name="AlarmLog"
							createDirs="true"
							keepFileOpen="true"
							encoding="utf-8"
							fileName="C:/TEAL_Log_Data/AlarmLog/${date:format=dd-MM-yyyy}/${date:format=dd-MM-yyyy_HH}_${gdc:ShiftName}.csv"
							archiveEvery="Day"
							maxArchiveDays="60"
							header="AlarmCode,AlarmDescription,Time,Shift"
						layout="${message}" />

		<!-- Cycle Time Log -->
		<target xsi:type="File"
						name="CycleTimeLog"
						createDirs="true"
						keepFileOpen="true"
						encoding="utf-8"
					fileName="C:/TEAL_Log_Data/CycleTime/${date:format=dd-MM-yyyy}/${date:format=dd-MM-yyyy_HH}_${gdc:ShiftName}.csv"
					archiveEvery="Day"
					maxArchiveDays="60"
					header="DateTime,MachineMode,CycleTime,MachineName,Shift"
					layout="${message}" />

		<!-- Cpk Log -->
		<target xsi:type="File"
						name="CpkLog"
						createDirs="true"
						keepFileOpen="true"
						encoding="utf-8"
					fileName="C:/TEAL_Log_Data/CpkLog/${date:format=dd-MM-yyyy}/${date:format=dd-MM-yyyy_HH}_${gdc:ShiftName}.csv"
					archiveEvery="Day"
					maxArchiveDays="60"
					header="DateTime,MachineMode,Cpk,MachineName,Shift"
					layout="${message}" />

		<!-- GRR Log -->
		<target xsi:type="File"
						name="GRRLog"
						createDirs="true"
						keepFileOpen="true"
						encoding="utf-8"
					fileName="C:/TEAL_Log_Data/GRRLog/${date:format=dd-MM-yyyy}/${date:format=dd-MM-yyyy_HH}_${gdc:ShiftName}.csv"
					archiveEvery="Day"
					maxArchiveDays="60"
					header="DateTime,MachineMode,GRR,MachineName,Shift"
					layout="${message}" />

		<!-- Production Log: one CSV row per finished unit (CustomLogs.Production, fed by the PLC's
		     FB_CustomLog). No layout here: Teal.Library.Log's CustomLog<T> sets the CSV layout itself.
		     The target must exist before the app starts. -->
		<target xsi:type="File"
				name="ProductionTarget"
				fileName="C:/TEAL_Log_Data/ProductionData/${date:format=dd-MM-yyyy}/${date:format=dd-MM-yyyy_HH}.csv"
				createDirs="true"
				keepFileOpen="false" />
	
		<!-- Static / Dynamic Log: one CSV row per vision command (CustomLogs.StaticDynamic, fed by the
		     PLC's MAIN.sdlog). Same rules as the production log: no layout, the target must exist at start. -->
		<target xsi:type="File"
				name="StaticDynamicTarget"
				fileName="C:/TEAL_Log_Data/StaticDynamic/${date:format=dd-MM-yyyy}/${date:format=dd-MM-yyyy_HH}.csv"
				createDirs="true"
				keepFileOpen="false" />
	</targets>


	<rules>
		<!-- Production Log: first and final, or every row would also go to another log. -->
		<logger name="ProductionLogger" minlevel="Info" writeTo="ProductionTarget" final="true" />
		<logger name="StaticDynamicLogger" minlevel="Info" writeTo="StaticDynamicTarget" final="true" />

		<!-- Teal.Library.Log's Logger.WriteLog picks the logger from the LogType (RunningLog,
		     DryRun, DummyRun, Error, AlarmError, CycleTime, Cpk, Grr, MachineLog): one rule each.
		     File names carry ${gdc:ShiftName} (set from GlobalClass.CurrentShift) and the
		     CSV rows carry MachineName (set from Data\config.txt). -->
		<logger name="RunningLogger" minlevel="Info" writeTo="RunningLog" final="true" />
		<logger name="DummyRunLogger" minlevel="Info" writeTo="DummyrunLog" final="true" />
		<logger name="DryRunLogger" minlevel="Info" writeTo="DryrunLog" final="true" />
		<logger name="ErrorLog" minlevel="Error" writeTo="errorLog" final="true" />
		<logger name="AlarmLog" minlevel="Error" writeTo="AlarmLog" final="true" />
		<logger name="CycleTime" minlevel="Info" writeTo="CycleTimeLog" final="true" />
		<logger name="CpkLogger" minlevel="Info" writeTo="CpkLog" final="true" />
		<logger name="GRRLogger" minlevel="Info" writeTo="GRRLog" final="true" />
		<logger name="MachineLog" minlevel="Debug" writeTo="machineLog" />


	</rules>

</nlog>