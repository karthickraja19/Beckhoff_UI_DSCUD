<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
	  internalLogLevel="Trace"
      internalLogFile="C:/TEAL_Log_Data/nlog-internal.log">

	<targets>
		<!-- Running Log -->
		<target xsi:type="File"
            name="RunningLog"
            fileName="C:/TEAL_Log_Data/Logs/RunningLog/${level}/${logger}_${date:format=yyyy-MM-dd_HH}.csv"
            createDirs="true"
            keepFileOpen="false"
            encoding="utf-8">

			<layout xsi:type="CsvLayout"
					withHeader="true"
					delimiter=",">

				<column name="DateTime" layout="${date:format=yyyy-MM-dd HH\:mm\:ss.fff}" />
				<column name="LogType" layout="${level}" />
				<column name="ModuleName" layout="${logger}" />
				<column name="ErrorMessage" layout="${message}" />
				<column name="FunctionName" layout="${event-properties:FunctionName}" />
				<column name="LineNumber" layout="${event-properties:LineNo}" />
			</layout>
		</target>
		<!-- Sequence Log -->
		<target xsi:type="File"
            name="SequenceLog"
            fileName="C:/TEAL_Log_Data/Logs/SequenceLog/${logger}/${level}/${logger}_${date:format=yyyy-MM-dd_HH}.csv"
            createDirs="true"
            keepFileOpen="false"
            encoding="utf-8">

			<layout xsi:type="CsvLayout"
					withHeader="true"
					delimiter=",">

				<column name="DateTime" layout="${date:format=yyyy-MM-dd HH\:mm\:ss.fff}" />
				<column name="LogType" layout="${level}" />
				<column name="ModuleName" layout="${logger}" />
				<column name="ErrorMessage" layout="${message}" />
				<column name="FunctionName" layout="${event-properties:FunctionName}" />
				<column name="LineNumber" layout="${event-properties:LineNo}" />
			</layout>
		</target>
		<!-- Exception Log -->
		<target xsi:type="File"
            name="ExceptionLog"
            fileName="C:/TEAL_Log_Data/Logs/ExceptionLog/${logger}/${logger}_${date:format=yyyy-MM-dd}.csv"
            createDirs="true"
            keepFileOpen="false"
            encoding="utf-8">

			<layout xsi:type="CsvLayout"
					withHeader="true"
					delimiter=",">

				<column name="DateTime" layout="${date:format=yyyy-MM-dd HH\:mm\:ss.fff}" />
				<column name="LogType" layout="${level}" />
				<column name="ModuleName" layout="${logger}" />
				<column name="ErrorMessage" layout="${message}" />
				<column name="FunctionName" layout="${event-properties:FunctionName}" />
				<column name="LineNumber" layout="${event-properties:LineNo}" />
			</layout>
		</target>
		<!-- Alarm Log -->
		<target xsi:type="File"
            name="AlarmLog"
            fileName="C:/TEAL_Log_Data/Logs/AlarmLog/${logger}/${logger}_${date:format=yyyy-MM-dd}.csv"
            createDirs="true"
            keepFileOpen="false"
            encoding="utf-8">

			<layout xsi:type="CsvLayout"
					withHeader="true"
					delimiter=",">

				<column name="DateTime" layout="${date:format=yyyy-MM-dd HH\:mm\:ss.fff}" />
				<column name="LogType" layout="${level}" />
				<column name="ModuleName" layout="${logger}" />
				<column name="ErrorMessage" layout="${message}" />
				<column name="FunctionName" layout="${event-properties:FunctionName}" />
				<column name="LineNumber" layout="${event-properties:LineNo}" />
			</layout>
		</target>
		<!-- System Log -->
		<target xsi:type="File"
            name="SystemLog"
            fileName="C:/TEAL_Log_Data/Logs/SystemLog/${logger}/${logger}_${date:format=yyyy-MM-dd}.csv"
            createDirs="true"
            keepFileOpen="false"
            encoding="utf-8">

			<layout xsi:type="CsvLayout"
					withHeader="true"
					delimiter=",">

				<column name="DateTime" layout="${date:format=yyyy-MM-dd HH\:mm\:ss.fff}" />
				<column name="LogType" layout="${level}" />
				<column name="ModuleName" layout="${logger}" />
				<column name="ErrorMessage" layout="${message}" />
				<column name="FunctionName" layout="${event-properties:FunctionName}" />
				<column name="LineNumber" layout="${event-properties:LineNo}" />
			</layout>
		</target>

	</targets>

	<!-- Logging rules -->
	<rules>

		<!--Exception Log-->
		<logger name="*" minlevel="Error" writeTo="ExceptionLog"/>

		<!--Sequence Log-->
		<logger name="SeqGlobalClass" minlevel="Info" writeTo="SequenceLog" />
		<logger name="HomingSequence" minlevel="Info" writeTo="SequenceLog" />

		<!--Alarm Log-->
		<logger name="*" minlevel="Warn" writeTo="AlarmLog"/>

		<!--Running Log-->
		<logger name="*" minlevel="Info" writeTo="RunningLog" />

		<!--System Log-->
		<logger name="AlarmScreen" minlevel="Info" writeTo="SystemLog" />
		<logger name="HomeScreen" minlevel="Info" writeTo="SystemLog" />
		<logger name="Login" minlevel="Info" writeTo="SystemLog" />
		<logger name="MainForm" minlevel="Info" writeTo="SystemLog" />
		<logger name="ManualScreen" minlevel="Info" writeTo="SystemLog" />
		<logger name="RecipieForm" minlevel="Info" writeTo="SystemLog" />
		<logger name="Report" minlevel="Info" writeTo="SystemLog" />
		<logger name="Settings" minlevel="Info" writeTo="SystemLog" />
		<logger name="UserForm" minlevel="Info" writeTo="SystemLog" />

	</rules>
</nlog>