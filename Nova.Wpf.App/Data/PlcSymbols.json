  // ---------------------------------------------------------------------------------
  // SENSOR DISABLE  (HMI -> PLC)  -  Home > Sensor Connection Dashboard
  // ---------------------------------------------------------------------------------
  // The PLC's ARRAY OF BOOL that disables the sensors: one element per Master.Configuration
  // ESensor member, in the enum's order (a sensor's "Input" in Data\Settings\Sensors.json is
  // the ESensor / EInput member name). The HMI writes TRUE to disable, FALSE to enable.
  // FirstIndex is the array's lower bound in the PLC: 0 for ARRAY[0..n], 1 for ARRAY[1..n].
  // Example:   "Array": "GVL_HMI.abSensorDisable", "FirstIndex": 0
  // PLC TODO: the PLC has no sensor disable array yet; blank = no sensor can be disabled.
  "SensorDisable": {
    "Array": "",
    "FirstIndex": 0
  }
