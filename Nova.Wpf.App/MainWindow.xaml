<handyControl:Window x:Class="Nova.Wpf.App.MainWindow"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:handyControl="clr-namespace:HandyControl.Controls;assembly=HandyControl"
                     xmlns:hc="https://handyorg.github.io/handycontrol"
                     Title="{Binding WindowTitle}"
                     Height="768"
                     Width="1024"
                     WindowStartupLocation="CenterScreen"
                     WindowState="Maximized"
                     Background="{DynamicResource SecondaryRegionBrush}"
                     Foreground="{DynamicResource PrimaryTextBrush}"
                     FontSize="{DynamicResource Nova.FontSize.Base}"
                     FontFamily="{DynamicResource Audio.FontFamily}"
                     ShowTitle="False"
                     NonClientAreaBackground="{DynamicResource RegionBrush}"
                     NonClientAreaForeground="{DynamicResource PrimaryTextBrush}"
                     xmlns:data="clr-namespace:Nova.Wpf.App.Data"
                     Closing="Window_Closing" >

    <!-- The title bar carries only the window buttons (minimise, maximise/restore,
         close); no NonClientAreaContent, so no logo, version, machine name or clock. -->
    <Grid hc:Dialog.Token="{x:Static data:DialogTokens.MainWindow}">
        <hc:DialogContainer>
            <!-- This top border acts as the Title Bar's underline but spans the ENTIRE width under the close button -->
            <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderBrush}">
                <ContentControl Content="{Binding CurrentView}" Focusable="False"/>
            </Border>
        </hc:DialogContainer>
    </Grid>
</handyControl:Window>
