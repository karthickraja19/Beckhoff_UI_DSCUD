<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- Controller family, surfaced through IMachineContext.MasterCardType. -->
    <add key="MasterCardType" value="Twincat" />

    <!-- Running-log folder opened by the Log nav entry (same key as V3) -->
    <add key="LogFilePath" value="C:\TEAL_Log_Data" />

    <!-- "Simulated" runs the HMI with no PLC connected. "Twincat" connects to the PLC over
         ADS and drives the steppers in Data\Steppers.json through the Beckhoff library;
         every other device stays simulated until its TwinCAT adapter is written. -->
    <add key="HardwareMode" value="Twincat" />

    <!-- TwinCAT ADS target, used when HardwareMode=Twincat. PlcAmsNetId is the AMS Net ID
         of the PLC runtime: 127.0.0.1.1.1 for the runtime on this PC, otherwise the
         target's Net ID (TwinCAT XAE > SYSTEM > Routes). Port 851 is the first PLC. -->
    <add key="PlcAmsNetId" value="127.0.0.1.1.1" />
    <add key="PlcAdsPort" value="851" />
    <!-- GVL and array holding the steppers: GLOBAL_STEPPER.gStepper[Id]. The PLC array is
         ARRAY[1..4], so the Ids in Data\Steppers.json start at 1. -->
    <add key="PlcStepperGvl" value="GLOBAL_STEPPER" />
    <add key="PlcStepperArray" value="gStepper" />

    <!-- TEAL_Master database for alarm history, production, shift and reports. Leave
         blank to fall back to the CSV data access. -->
    <add key="connectionString" value="Data Source=.\;Database=TEAL_Master;Integrated Security=True;" />

    <!-- ACCESS CONTROL - Audio SW DFM v5.4 slide 52.
         TerminalName identifies THIS terminal to the access check and is part of every
         request, so a badge valid on one station is not valid on the next. Format is
         the slide's: Site_Building-Floor-LineSide_Instance_GHDS-ID, all capitalised,
         following the Insight definitions. It is per-install and MUST be set before
         the machine ships - an empty value refuses every login rather than accepting
         badges from anywhere.
         SoftwareType distinguishes the main application from the vision one, and is
         also matched on. -->
    <add key="TerminalName" value="ITKS_E03-4FT-01B_1_STATION59" />
    <add key="SoftwareType" value="Main" />

    <!-- COMMISSIONING ONLY. "true" opens the Config and Settings pages to everyone as
         Level 3, with or without a login; Home, Alarm, Data and Vision are unaffected.
         Set to "false" (or delete the key) before the machine ships. -->
    <add key="BypassAccessLevels" value="true" />

    <!-- Manual > Axis point-to-point limits, same keys and values as Master.UI:
         the largest iteration count the operator may command, and the digit limit of
         the box it is typed into. -->
    <add key="PtpIterationCount" value="100" />
    <add key="PPCIterationLen" value="3" />

    <!-- Shift / OEE and data retention, carried over from V3 for the shift/OEE service.
         Nothing reads these yet. -->
    <!-- OEE Performance = (units x IdealCycleTime) / runtime. Seconds per unit. -->
    <add key="IdealCycleTime" value="9" />
    <add key="StatusRefreshSeconds" value="300" />
    <add key="IdleThresholdMinutes" value="1" />
    <add key="RetentionDaysForCSV" value="30" />
    <add key="RetentionDaysForProductionData" value="30" />
    <add key="RetentionDaysForAlarmData" value="10" />
    <add key="RetentionDaysForShiftStatusData" value="30" />
    <add key="RetentionDaysForHealthData" value="1" />
  </appSettings>
  <runtime>
    <loadFromRemoteSources enabled="true"/>
    <!-- Binding redirects are generated at build time from the resolved package
         graph (GenerateBindingRedirectsOutputType). Do not hand-maintain them here. -->
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
    </assemblyBinding>
  </runtime>
</configuration>
