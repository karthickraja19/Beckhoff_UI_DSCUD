<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- PLC variable names are not here. Every TwinCAT variable the HMI reads or writes is in
         Data\PlcSymbols.json (see Docs\TwinCAT_Integration.md). -->
    <!-- Controller family, surfaced through IMachineContext.MasterCardType. -->
    <add key="MasterCardType" value="Twincat" />

    <!-- Where the machine's configuration, recipes and settings are read from and saved to
         (same key and folder as V3). Blank = C:\TEAL\Data. The Data folder next to the exe
         holds the shipped defaults; on every start each one this folder does not have yet is
         copied in, never over a file already there. -->
    <add key="TealDataDirectory" value="C:\TEAL\Data" />

    <!-- Beckhoff's CNC HMI (Beckhoff.App.Shell.Core.exe), started by the button on Recipe > CNC.
         It is a separate program with its own settings (System\GeneralSettings.xml, including
         the PLC's AMS Net ID, and Log\) kept in its own folder, so install it per machine in a
         folder the user can write to. Its exe, or the folder holding it: a full path, or
         relative to this exe; environment variables are expanded. Blank = a CncHmi folder
         beside the data folder (C:\TEAL\CncHmi when the data folder is C:\TEAL\Data). -->
    <add key="CncHmiExe" value="D:\Beckhoff_Karthi\13-11-2026\2. CNC_HMI\2. CNC_HMI\Beckhoff.App.Shell.Core.exe"/>

    <!-- Running-log folder opened by the Log nav entry (same key as V3) -->
    <add key="LogFilePath" value="C:\TEAL_Log_Data" />

    <!-- The HMI connects to the PLC over ADS and drives the steppers, cylinders, vacuums,
         servos, CCDs, scanners and robots in Data\ through the Beckhoff library. SFC
         has no driver yet, so its Manual tab lists no device.
         The PLC itself is Data\CardsConfiguration.json, read through Master.Configuration:
         ConnectionId is the AMS Net ID of the PLC runtime (127.0.0.1.1.1 for the runtime on
         this PC, otherwise the target's Net ID from TwinCAT XAE > SYSTEM > Routes), PortNo
         851 is the first PLC, and DBName.ServoDUTName (CylinderDUTName, VacuumDUTName,
         StepperDUTName) is the PLC's mapping block for that kind of device - MAIN.servocall,
         MAIN.cylindercall, MAIN.vaccumcall, MAIN.steppercall. The library finds each device in
         it by its Id, the PLC array index: the arrays are ARRAY[1..n], so the Ids in
         Data\Servos.json, Cylinders.json, Vacuums.json and Steppers.json start at 1. The robots are on EtherCAT: the library reads robot Id's I/O
         from Robot{Id}_hw_IO_GVL and its connection from RobotGVL.Robots[Id], so Data\Robots.json
         needs only the Id. -->


    <!-- The valve outputs and sensors named in Data\Cylinders.json and Vacuums.json are
         Data\Config.csv points (the PLC's E_Outputs / E_Input names), used only to label the
         Manual boards: the PLC wires them into each device's block itself (FB_CylinderMapping,
         FB_VacuumMapping). A name that is not in Config.csv is reported in the startup warnings. -->

    <!-- HIVE REPORTING - Audio SW DFM v5.4 S1.1.
         HiveEnabled "false" is for a desk with no HIVE gateway: the machine state is
         worked out and written to the HIVE log, the alarm pop-up still asks for a badge,
         but nothing is sent. Set it to "true" before the machine runs on the line - HIVE
         is line critical and may not be switched off without AME approval.
         HiveMachineType must be one of the DFM's machine types (disp_hm, pnp, screw,
         solder, aoi, ...); HIVE refuses a payload without it.
         HiveSequence is this machine's sub-machine number; 0 is the machine as a whole. -->
    <add key="HiveEnabled" value="true" />
    <add key="HiveGatewayUrl" value="http://localhost:5193" />
    <add key="HiveMachineType" value="disp_hm" />
    <add key="HiveSequence" value="0" />
    <add key="HiveStateFile" value="C:\Hive\LatestHiveState.ini" />
    <!-- The PLC variable that says what state the machine is in (E_MachineState). The
         HIVE state is worked out from it: auto = running, 90 s after it stops
         processing = idle, alarm or stop = downtime. Leave blank to not read it. -->
    <!-- Running / Idle follow units (DFM slides 7-8): the PLC variable that says a unit entered
         the machine. A BOOL the PLC sets for each unit (every rising edge counts), or with
         PlcUnitEnteredIsCounter "true" an INT it increments (every change counts). Blank keeps
         the 90 s rule that starts when the PLC leaves auto. -->
    <!-- HIVE payloads the gateway has not accepted are kept here and sent after a restart.
         Blank = HivePending.json beside HiveStateFile. -->
    <add key="HivePendingFile" value="" />
    <!-- UNIT DATA (machine_data, DFM S1.2): one payload per finished unit, built from the
         PLC's unit record (PlcSymbols.json: Status.UnitDoneCount / UnitDoneSerial, UnitRecord),
         the Parameters of the symbol map, the consumables and Config > Spec Limits.
         HiveLimitsVersion is sent as limits_version (the revision of the spec limits, e.g.
         "ABC_1.1.0.0_241115_POR"); blank leaves the key out and a startup warning says so.
         The gateway has HiveUnitTimeoutMs to answer 200/201, and the upload is tried
         HiveUnitAttempts times (S12: 2 s, three times). With no 200/201 the machine goes to
         downtime X03IPOO-01 "HIVE upload unsuccessful" (slide 14) and the payload is sent
         again every 5 minutes. For the DFM's "within 3 sec" to the letter: 3000 and 1. -->
    <add key="HiveLimitsVersion" value="" />
    <!-- Each switch to Running asks MES to check the hash keys (CHECK_AUDIO_INFO, S3.6); no
         MesUrl, no check. When MES gives no usable answer (down, not JSON) "downtime" puts
         HIVE into downtime X02 "Failed to receive information from MES"; "ignore" lets
         production go on and only writes the machine log. A false answer is always downtime. -->
    <add key="HiveHashCheckOnMesError" value="downtime" />
    <add key="HiveUnitTimeoutMs" value="2000" />
    <add key="HiveUnitAttempts" value="3" />


    <!-- RESET (the small unlabelled button beside Homing on the Manual tab's Log page):
         every BOOL listed (';'-separated) is set TRUE in this order, then all FALSE 200 ms later.
         MAIN.bResetPb runs fbAlarmManager.AckAll() and the device resets (the PLC leaves ALARM
         once no fault is raised again); MAIN.modecall.bResetPb is FB_ModeSelection's own RESET,
         which leaves STOP after an emergency. MAIN does not pass one to the other, so both are
         pulsed. Blank: says it is not wired. -->

    <!-- MANUAL MODE (Setting page, Manual and Calibration tabs; Recipe page, Gantry tab). This
         BOOL is TRUE while one of those tabs is on screen (moving between them keeps it TRUE), and
         FALSE on any other tab or page and when the HMI closes. The PLC goes to
         MANUAL from IDLE, PAUSE or ALARM, and back to IDLE (homing required) when it is
         cleared. Blank: the Manual tab does not change the mode. -->


    <!-- RECIPE (Config page, Recipe > Gantry tab). The PLC's FB_RecipeMapping.Recipe array,
         one FB_Recipe per gantry (E_Recipe), which the sequences drive every taught move
         from. A module's positions (its servos' ConfiguredPositions in Data\Servos.json)
         go to Recipe[PlcGantry] (its PlcGantry in Data\Gantry.json; 0 = not written):
         Step[row, axis] (axis = the servo's Type in Gantry.json as E_Servo, X=1
         Y=2 Z=3 R=4), Name[row], nPosUsed, nAxisUsed, and bLoaded TRUE last. Written on
         Save, and every mapped gantry again each time the PLC comes back to Run. Blank:
         recipes are saved but not written to the PLC. -->

    <!-- ROBOT RECIPE (Config page, Recipe > Robot tab). The PLC's FB_RobotSD array; each
         row of Data\RobotRecipe.json with a "PlcMember" goes to [Id].{PlcMember} of every
         robot in Data\Robots.json (Speed: cmd.robotSpeed, which FB_RobotSD sends to the
         robot in AUTO_RUNNING), within the row's optional "Min" and "Max". Written on
         Save, and again each time the PLC comes back to Run. Blank: the robot recipe is
         saved but not written to the PLC. -->

    <!-- CNC RECIPE (Config page, Recipe > CNC tab). The PLC's array of ST_CncRecipe
         (aPos : ARRAY[1..MAX_POS, 1..7] OF LREAL = X1, Y1, Z1, A, R, X2, Z2 per position;
         aName : ARRAY[1..MAX_POS] OF STRING(30); nPosUsed : INT; bLoaded : BOOL), e.g.
         MAIN.recipe.Cnc. A channel's positions go to [PlcChannel] (its PlcChannel in
         Data\CncRecipe.json; 0 = not written), bLoaded cleared first and set TRUE last.
         Written on Save, and every mapped channel again each time the PLC comes back to
         Run. Blank: the CNC recipe is saved but not written to the PLC - the PLC has no
         CNC recipe yet. -->


    <!-- TEAL_Master database for alarm history, production, shift and reports. Leave
         blank to fall back to the CSV data access. -->
	  <add key="connectionString" value="Data Source=DESKTOP-AI7168D\SQLEXPRESS;Database=TEAL_Master;Integrated Security=True;" />

    <!-- ACCESS CONTROL - Audio SW DFM v5.4 slide 52.
         TerminalName identifies THIS terminal to the access check and is part of every
         request, so a badge valid on one station is not valid on the next. Format is
         the slide's: Site_Building-Floor-LineSide_Instance_GHDS-ID, all capitalised,
         following the Insight definitions. It is per-install and MUST be set before
         the machine ships - an empty value refuses every login rather than accepting
         badges from anywhere.
         SoftwareType distinguishes the main application from the vision one, and is
         also matched on. -->
    <add key="TerminalName" value="ITKS_E03-4FT-01B_1_STATION59" />
    <add key="SoftwareType" value="Main" />

    <!-- MES WebAPI: the GetCmdResult address, e.g. http://10.32.16.114/api/Assy/GetCmdResult
         (a bare http://10.32.16.114 has the path added). Used for the badge check when the
         Setting page's Access Control tab has "Access Control with MES" on, for uploading
         hash keys (PD-15) and for the valve and nozzle checks (PD-04, PD-12). Blank means
         there is no MES: those functions say so instead of calling it. -->
    <add key="MesUrl" value="" />
    <!-- MES MACHINE STATE (S1.1.2): every HIVE state change is also posted to MES.
         MesStateUrl blank = MesUrl's host + /api/machine/collmachinestatefromcard.
         MesMachineName is machine_Name, the ICT process station id (e.g. BE010; blank = the
         Station of the station profile). MesLineName is pdline_name, the CM line (e.g. R1;
         blank = the profile's Line). No MesUrl, no report. -->
    <add key="MesStateUrl" value="" />
    <add key="MesMachineName" value="" />
    <add key="MesLineName" value="" />

    <!-- PICTURE UPLOAD QUANTITY CHECK (T5). PictureRecordFolder is where Pic_Upload_Record
         is written, one CSV per day. Process.PictureDispensingStop (Data\PlcSymbols.json) is the PLC BOOL that receives
         "dispensing control" (TRUE = the SCUD may dispense); blank writes nothing. -->
    <add key="PictureRecordFolder" value="D:\Pic_Upload_Record" />
    <!-- UNIT IMAGES (T5, DFM slides 19 and 20). UnitImageFolder is where the vision software
         saves a unit's AOI images: every image under it whose file name, or whose folder's
         name, contains the unit's serial number is counted (Picture Qty. Check) and sent to
         HIVE with the unit as one zip, UnitSN_Project_Line_Station_Instance_yyyyMMddHHmmss.zip.
         Blank = not available: nothing is counted and no zip is sent.
         UnitImageZipFolder is where the zips are written (blank = HiveZip under UnitImageFolder). -->
    <add key="UnitImageFolder" value="" />
    <add key="UnitImageZipFolder" value="" />

    <!-- NG COUNTING (T6, Option 1): HiveNgConsecutiveLimit NG units in a row, or HiveNgTotalLimit
         in total, put the machine down (P99DSOO-01 "Consecutive Error"); an NG below that is a
         pop-up and the buzzer (Process.NgWarningBuzzer). HiveNgScope "gantry" counts each
         station on its own (single-glue dispensing), "machine" counts the whole machine
         (dual glue). The counts start again when HIVE leaves the downtime they raised. -->
    <add key="HiveNgScope" value="gantry" />
    <add key="HiveNgConsecutiveLimit" value="3" />
    <add key="HiveNgTotalLimit" value="5" />

    <!-- VALVE SN CHECK (S3.1 PD-04): for a valve model with an internal SN the controller's SN
         is read every ValveSnCheckMinutes on the clock and compared with the recorded one.
         A mismatch or a failed read is downtime G05DSVP-01. 0 switches the check off. -->
    <add key="ValveSnCheckMinutes" value="5" />

    <!-- EARLY WARNING (S17): "card" = a Level 3 card, checked with MES, closes the pop-up and
         changes the enable switch (AE / HIVE stations); "confirm" = a Confirm button only
         (URP / ME stations). -->
    <add key="EarlyWarningClose" value="card" />

    <!-- 24-HOUR DRY RUN (S4.1, FAT remote qualification). HiveDryRunSiCode is the SI code the
         two DLLs (UUID.dll, UMSID.dll, beside the exe) are called with. Blank = the dry run
         cannot be enabled. -->
    <add key="HiveDryRunSiCode" value="" />

    <!-- Nominal length of a badge UID (slide 37: "checks the character string length ...
         to confirm that it is nominal"). One number, e.g. "10", or a range, e.g. "8-10".
         A swipe of any other length is refused and cleared. Blank accepts 3 to 32
         characters, which covers the sample access file - set the real length of the
         site's badges before the machine ships. -->
    <add key="BadgeUidLength" value="" />

    <!-- VISION PAGE (slide 61): the folder the vision software saves its images to. The
         page shows the newest VisionImageCount images in it (or in any folder below it),
         newest first; no folder per camera is needed. Clicking one magnifies it. A file named
         SN_yyyyMMddHHmmss_OK.jpg gives the unit SN, time and result, and a .txt with the same
         name beside the image, with key=value lines, gives the values shown for the capture.
         Blank VisionImageFolder: no images. -->
    <add key="VisionImageFolder" value="" />
    <add key="VisionImageCount" value="6" />

    <!-- GLUE WARNINGS (S2.4.4.4). The PLC drives the buzzer and tower light from these:
         Process.GlueAlertLevel (Data\PlcSymbols.json) (INT) gets 0 none, 1 low glue / pot life ending / nozzle low
         (alternating buzzer, flashing green), 2 glue empty / pot life expired / nozzle
         critical (continuous buzzer, flashing red); Process.GlueBuzzerMute (Data\PlcSymbols.json) (BOOL) is TRUE while
         the operator has muted the buzzer. Blank writes nothing. -->

    <!-- ALARM POP-UP (slide 50). Whose badge may close it: 1 = any operator (DFM v5.4 slide 50),
         2 = Level 2 or 3 only (the Alarm page spec). Open question Q8 with AME. -->
    <add key="AlarmPopupCloseLevel" value="1" />
    <!-- The pop-up only appears while HIVE is enabled (HiveEnabled, or the HIVE Control tab),
         one pop-up per alarm. AlarmPopupClosable: true = the pop-up has an X in its title bar and
         can be closed without Confirm (nothing is reported to HIVE); false = no X, it goes away
         only with Confirm + badge. -->
    <add key="AlarmPopupClosable" value="true" />

    <!-- COMMISSIONING ONLY. "true" opens the Config and Settings pages to everyone as
         Level 3, with or without a login; Home, Alarm, Data and Vision are unaffected.
         Set to "false" (or delete the key) before the machine ships. -->
    <add key="BypassAccessLevels" value="true" />

    <!-- DEMONSTRATION ONLY. "true" shows generated alarms, units, glue data and coordinates
         on the Alarm and Data pages, instead of what the machine recorded. Both pages show a
         "Sample data" badge. Home and the PLC are unaffected. Set to "false" (or delete the
         key) before the machine ships. -->
 
    <!-- Manual > Axis point-to-point limits, same keys and values as Master.UI:
         the largest iteration count the operator may command, and the digit limit of
         the box it is typed into, and the longest wait between moves in seconds.
         ManualPositionLimit is the largest position (mm, either side of home) Move and
         point-to-point accept: V3's SQT range check, -99999 to +99999. -->
    <add key="PtpIterationCount" value="100" />
    <add key="PPCIterationLen" value="3" />
    <add key="PtpWaitingTime" value="120" />
    <add key="ManualPositionLimit" value="99999" />

    <!-- Data > Yield: the target line, in percent. Set it to the yield target agreed for
         the station; leave it blank to draw no line. -->
    <add key="TargetYieldPercent" value="80.0" />

    <!-- Master.Scheduler (Quartz), as in V3. Every *.csv under LogFilePath older than
         RetentionDaysForCSV is deleted (checked every 2 minutes); the database rows past
         RetentionDaysFor* are deleted daily at 23:30, with the OEE rows from before today.
         Each value must be a number, and 0 keeps nothing (not "for ever"). -->
    <add key="RetentionDaysForCSV" value="30" />
    <add key="RetentionDaysForProductionData" value="100" />
    <add key="RetentionDaysForAlarmData" value="100" />
    <add key="RetentionDaysForShiftStatusData" value="100" />
    <add key="RetentionDaysForHealthData" value="10" />
    <!-- Shift status and OEE refresh, seconds. -->
    <add key="StatusRefreshSeconds" value="300" />
    <!-- OEE Performance = (units x IdealCycleTime) / runtime. Seconds per unit (V3's value). -->
    <add key="IdealCycleTime" value="9" />
  </appSettings>
  <runtime>
    <loadFromRemoteSources enabled="true"/>
    <!-- Binding redirects are generated at build time from the resolved package
         graph (GenerateBindingRedirectsOutputType). Do not hand-maintain them here. -->
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
    </assemblyBinding>
  </runtime>
</configuration>
