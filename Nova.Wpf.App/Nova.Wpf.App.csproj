<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <OutputType>WinExe</OutputType>
    <!-- AnyCPU: TwinCAT ADS is managed TCP, so the x86 lock V3 needed for the
         32-bit Advantech driver no longer applies. -->
    <LangVersion>7.3</LangVersion>
    <UseWPF>true</UseWPF>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <NoWarn>NU1605;$(NoWarn)</NoWarn>
    <AssemblyName>Nova.Wpf.App</AssemblyName>
    <RootNamespace>Nova.Wpf.App</RootNamespace>
    <StartupObject>Nova.Wpf.App.App</StartupObject>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- Same TwinCAT ADS version the Beckhoff library is built against. -->
    <PackageReference Include="Beckhoff.TwinCAT.Ads" Version="7.0.317" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="HandyControl" Version="3.5.1" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.4" />
    <PackageReference Include="MahApps.Metro.IconPacks.Lucide" Version="6.2.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <!-- Teal.Library.Log binds NLog 6.x; without it every Logger.WriteLog throws
         FileNotFoundException at the first call. -->
    <PackageReference Include="NLog" Version="6.1.0" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.9" />
    <PackageReference Include="System.Text.Json" Version="10.0.7" />
  </ItemGroup>
  <ItemGroup>
    <!-- The MES WebAPI client (Core\Comm\MesClient.cs). -->
    <Reference Include="System.Net.Http" />
    <!-- The unit image zip for Insight (Services\UnitImagePackager.cs). -->
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>
  <ItemGroup>
    <!-- 24-hour dry run (S4.1): UUID.dll, UMSID.dll and the C++ runtime DLLs of the RQ DLL
         package ("DLL_2.0.0.1 for C#&Winform_X86-64\Release"). They are not in this
         repository; when they are put in References\RemoteQualification they go beside the
         exe. Without them the dry run cannot be enabled and the HIVE Control tab says why. -->
    <None Include="..\References\RemoteQualification\*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Nova.Abstractions\Nova.Abstractions.csproj" />
    <ProjectReference Include="..\Nova.ViewModels\Nova.ViewModels.csproj" />
    <ProjectReference Include="..\Nova.Wpf.UI\Nova.Wpf.UI.csproj" />
    <ProjectReference Include="..\Master.Repository\Master.Repository.csproj" />
    <!-- Device configuration (Data\*.json) is read through Master.Configuration, not directly. -->
    <ProjectReference Include="..\Master.Configuration\Master.Configuration.csproj" />
    <ProjectReference Include="..\Nova.Alarm\Nova.Alarm.csproj" />
    <ProjectReference Include="..\Nova.Hive\Nova.Hive.csproj" />
    <!-- Scheduled housekeeping (Quartz): CSV clean-up, shift status / OEE, database purge. -->
    <ProjectReference Include="..\Master.Scheduler\Master.Scheduler.csproj" />
    <ProjectReference Include="..\Master.SharedUtilities\Master.SharedUtilities.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Beckhoff library, built from D:\BeckhOffLibrary\BeckhOffLibrary into References\Beckhoff.
         After changing the library, run References\Beckhoff\Update-BeckhoffLibrary.ps1 and rebuild.
         Teal.Library.Log is also the queue RunningLogService drains into the Home screen. -->
    <Reference Include="Teal.Library.Contracts">
      <HintPath>..\References\Beckhoff\Teal.Library.Contracts.dll</HintPath>
    </Reference>
    <Reference Include="Teal.Library.Cylinder">
      <HintPath>..\References\Beckhoff\Teal.Library.Cylinder.dll</HintPath>
    </Reference>
    <Reference Include="Teal.Library.Log">
      <HintPath>..\References\Beckhoff\Teal.Library.Log.dll</HintPath>
    </Reference>
    <Reference Include="Teal.Library.Servo">
      <HintPath>..\References\Beckhoff\Teal.Library.Servo.dll</HintPath>
    </Reference>
    <Reference Include="Teal.Library.Stepper">
      <HintPath>..\References\Beckhoff\Teal.Library.Stepper.dll</HintPath>
    </Reference>
    <Reference Include="Teal.Library.TcpIp">
      <HintPath>..\References\Beckhoff\Teal.Library.TcpIp.dll</HintPath>
    </Reference>
    <Reference Include="Teal.Library.Twincat">
      <HintPath>..\References\Beckhoff\Teal.Library.Twincat.dll</HintPath>
    </Reference>
    <Reference Include="Teal.Library.Vacuum">
      <HintPath>..\References\Beckhoff\Teal.Library.Vacuum.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <!-- Dual language (English / Chinese / Vietnamese): the same Teal.Library.Localization
         Odyssey.Master_V3 uses, copied from its References folder. -->
    <Reference Include="Teal.Library.Localization">
      <HintPath>..\References\Localization\Teal.Library.Localization.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>
  <ItemGroup>
    <!-- NLog targets (running / alarm CSV logs under C:\TEAL_Log_Data) for Teal.Library.Log. -->
    <None Update="NLog.config" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- Language files, deployed loose to Localization\ beside the exe: Teal.Library.Localization
         reads them at runtime and Setting > Localization Editor writes them back, so a
         corrected translation needs no rebuild. Not embedded for that reason.
         PreserveNewest, so a rebuild does not overwrite corrections made on the machine. -->
    <EmbeddedResource Remove="Localization\**\*.resx" />
    <None Include="Localization\Strings.resx" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Localization\Strings.zh-CN.resx" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Localization\Strings.vi.resx" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- Machine profile, recipes and settings, deployed next to the exe as the shipped defaults:
         the app copies each one App.config TealDataDirectory (C:\TEAL\Data) lacks into it at
         startup, and reads and saves only there. -->
    <None Update="Data\**\*.json;Data\**\*.xml;Data\**\*.csv;Data\**\*.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- Same as V3: the recipe and settings JSON the screens edit are re-copied on every build. -->
    <None Update="Data\Settings\*.json;Data\Gantry*.json;Data\RobotRecipe.json;Data\CncRecipe.json" CopyToOutputDirectory="Always" />
    <!-- Except the station profile and the files below: the app only copies a default into
         the data folder when it has none, but keeping the copy next to the exe stable avoids
         surprises when TealDataDirectory is pointed back at the exe's Data folder. -->
    <None Update="Data\Settings\StationProfile.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Likewise the files the Setting page's tabs and the planned-downtime procedures
         write (access control, HIVE control, hash key paths, consumables, picture check). -->
    <None Update="Data\Settings\AccessControl.json;Data\Settings\HiveControl.json;Data\Settings\HashKeys.json;Data\Settings\Consumables.json;Data\Settings\PictureQuantityCheck.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
