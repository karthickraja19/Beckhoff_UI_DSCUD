<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- 
      Offline Distribution Strategy:
      Forces Visual Studio and dotnet CLI to restore all NuGet packages 
      directly into a "packages" folder inside the repository.
      When zipping the repo for air-gapped machine deployment, all packages are bundled!
    -->
    <add key="globalPackagesFolder" value=".\packages" />
  </config>

  <packageSources>
    <!--
      Local offline feed: .nupkg files vendored in the repo, checked first so an
      air-gapped restore never needs the network. Holds the dependency closure of
      the Teal.Library.* binaries in References\ (ExcelDataReader, YamlDotNet,
      Newtonsoft.Json, NLog, EPPlus, System.Text.Encoding.CodePages).
    -->
    <add key="Local Offline Feed" value=".\LocalNugetRepository" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
