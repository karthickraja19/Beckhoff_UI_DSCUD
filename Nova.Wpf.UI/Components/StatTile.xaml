<UserControl x:Class="Nova.Wpf.UI.Components.StatTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Nova.Wpf.UI.Converters"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <conv:HexToBrushConverter x:Key="HexToBrush"/>
    </UserControl.Resources>
    <!-- A single metric as a rounded card: optional status dot + label + value. -->
    <Border Margin="2" CornerRadius="4"
            Background="{DynamicResource RegionBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid Margin="8,6" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <Ellipse Grid.Column="0" Width="12" Height="12" Margin="0,0,7,0" VerticalAlignment="Center"
                     Fill="{Binding DotColor, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource HexToBrush}}">
                <Ellipse.Style>
                    <Style TargetType="Ellipse">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowDot, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
            </Ellipse>
            
            <TextBlock Grid.Column="1" Text="{Binding Label, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       FontSize="{DynamicResource Nova.FontSize.Caption}" VerticalAlignment="Center" Margin="0,0,12,0"
                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                       
            <TextBlock Grid.Column="2" Text="{Binding Value, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       FontSize="{DynamicResource Nova.FontSize.Body}" FontWeight="SemiBold" VerticalAlignment="Center"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       HorizontalAlignment="Right"/>
        </Grid>
    </Border>
</UserControl>
