<UserControl x:Class="Nova.Wpf.UI.Components.StatusIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Ellipse x:Name="Halo" Width="22" Height="22" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Ellipse x:Name="Dot" Width="16" Height="16" Fill="{DynamicResource ThirdlyTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <TextBlock x:Name="Label" Visibility="Collapsed"/>
    </Grid>
</UserControl>
