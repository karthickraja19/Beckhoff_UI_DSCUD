<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =========================================================== -->
    <!-- THE APPLICATION PALETTE                                     -->
    <!--                                                             -->
    <!-- One palette, and it is the Audio one. Every colour below is -->
    <!-- the Apple HIG / DFM value already defined in                -->
    <!-- Styles/AudioTokens.xaml under an Audio.* key; this file      -->
    <!-- republishes them under the shared key names                 -->
    <!-- (PrimaryBrush, RegionBrush, BorderBrush, ...) that the       -->
    <!-- pre-Audio screens and HandyControl's own templates bind to.  -->
    <!--                                                             -->
    <!-- WHY THE DUPLICATION. Audio.* keys live in a dictionary that  -->
    <!-- is merged AFTER HandyControl and must stay independent of    -->
    <!-- it, so it cannot simply alias these names. Repointing here   -->
    <!-- is what makes the Manual, Machine Config and Recipe screens  -->
    <!-- render in the DFM's colours without rewriting 5,000 lines of -->
    <!-- their XAML: they ask for PrimaryBrush, and PrimaryBrush is   -->
    <!-- now System Blue rather than the old industrial teal.         -->
    <!--                                                             -->
    <!-- The values are duplicated literally rather than by           -->
    <!-- StaticResource because AudioTokens.xaml is merged after this -->
    <!-- file and its keys are not yet resolvable here. Any change to -->
    <!-- an Audio.* colour must be mirrored below.                    -->
    <!--                                                             -->
    <!-- The file keeps its name so the pack:// URI in App.xaml and   -->
    <!-- every existing reference stay valid.                         -->
    <!-- =========================================================== -->

    <!-- ===== Accent: HIG System Blue (Audio.System.BlueColor) ===== -->
    <Color x:Key="PrimaryColor">#FF007AFF</Color>
    <!-- Pressed / active accent. HIG darkens the blue rather than shading it. -->
    <Color x:Key="DarkPrimaryColor">#FF0051D5</Color>
    <Color x:Key="LightPrimaryColor">#FF4DA2FF</Color>
    <Color x:Key="SecondaryColor">#FF0062CC</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="DarkPrimaryBrush" Color="{StaticResource DarkPrimaryColor}"/>
    <SolidColorBrush x:Key="LightPrimaryBrush" Color="{StaticResource LightPrimaryColor}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource PrimaryColor}"/>

    <!-- The TEAL wordmark in the title bar is a brand asset, not a theme
         colour, so it keeps its own grey. -->
    <Color x:Key="LogoGrayColor">#FF8E8E93</Color>
    <SolidColorBrush x:Key="LogoGray" Color="{StaticResource LogoGrayColor}"/>

    <!-- ===== Surfaces (Audio.Surface.*) ===== -->
    <!-- Cards and panels sit white on the grouped background, exactly as the
         Audio pages do. SecondaryRegion was #CCCCCC, a mid grey that made every
         legacy page read as a darker shade than the Audio ones around it. -->
    <Color x:Key="RegionColor">#FFFFFFFF</Color>
    <SolidColorBrush x:Key="RegionBrush" Color="{StaticResource RegionColor}"/>

    <Color x:Key="SecondaryRegionColor">#FFF2F2F7</Color>
    <SolidColorBrush x:Key="SecondaryRegionBrush" Color="{StaticResource SecondaryRegionColor}"/>

    <Color x:Key="ThirdlyRegionColor">#FFF7F7FA</Color>
    <SolidColorBrush x:Key="ThirdlyRegionBrush" Color="{StaticResource ThirdlyRegionColor}"/>

    <!-- ===== Separators (Audio.SeparatorColor) ===== -->
    <!-- Was #8C949E - a heavy mid grey that drew a hard box around every field
         and table cell. HIG separators are hairlines. -->
    <Color x:Key="BorderColor">#FFC6C6C8</Color>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <Color x:Key="SecondaryBorderColor">#FFE5E5EA</Color>
    <SolidColorBrush x:Key="SecondaryBorderBrush" Color="{StaticResource SecondaryBorderColor}"/>

    <!-- ===== Buttons ===== -->
    <!-- The outline was pure black, which is why every legacy button read as a
         hard-edged box. HIG uses a filled grey surface with no border at all;
         the border key is kept (templates bind to it) and set to the hairline. -->
    <Color x:Key="Nova.Button.BorderColor">#FFC6C6C8</Color>
    <SolidColorBrush x:Key="Nova.Button.BorderBrush" Color="{StaticResource Nova.Button.BorderColor}"/>

    <Color x:Key="Nova.Button.SurfaceColor">#FFF2F2F7</Color>
    <SolidColorBrush x:Key="Nova.Button.SurfaceBrush" Color="{StaticResource Nova.Button.SurfaceColor}"/>

    <Color x:Key="Nova.Button.ShadeColor">#FF000000</Color>
    <SolidColorBrush x:Key="Nova.Button.ShadeBrush" Color="{StaticResource Nova.Button.ShadeColor}"/>

    <!-- ===== Text (Audio.Text.*) ===== -->
    <!-- Secondary and tertiary were both pure black, so "muted" text was not
         muted at all and every label competed with its own value. HIG grades
         them by opacity over a near-black. -->
    <Color x:Key="PrimaryTextColor">#FF000000</Color>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}"/>
    <Color x:Key="SecondaryTextColor">#FF3C3C43</Color>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" Opacity="0.60"/>
    <Color x:Key="ThirdlyTextColor">#FF3C3C43</Color>
    <SolidColorBrush x:Key="ThirdlyTextBrush" Color="{StaticResource ThirdlyTextColor}" Opacity="0.30"/>
    <Color x:Key="ReverseTextColor">#FFFFFFFF</Color>
    <SolidColorBrush x:Key="ReverseTextBrush" Color="{StaticResource ReverseTextColor}"/>

    <!-- ===== Semantic state colours (Audio.System.*) ===== -->
    <!-- HandyControl defines SuccessBrush / DangerBrush / WarningBrush /
         InfoBrush in its own Theme.xaml, and the legacy screens use them for
         run/stop/fault. This dictionary is merged after HandyControl, so
         redefining the keys here is what repoints them. -->
    <Color x:Key="SuccessColor">#FF34C759</Color>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <Color x:Key="DangerColor">#FFFF3B30</Color>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <Color x:Key="WarningColor">#FFFF9500</Color>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <Color x:Key="InfoColor">#FF007AFF</Color>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>

    <!-- Tinted chip fills used by the status pills on the legacy screens. -->
    <Color x:Key="Color.Success">#FF34C759</Color>
    <Color x:Key="Color.SuccessForeground">#FFFFFFFF</Color>
    <Color x:Key="Color.WarningYellow">#FFFF9500</Color>
    <Color x:Key="Color.WarningYellowForeground">#FFFFFFFF</Color>
    <Color x:Key="Color.ErrorOrange">#FFFF9500</Color>
    <Color x:Key="Color.ErrorOrangeForeground">#FFFFFFFF</Color>
    <Color x:Key="Color.FailedRed">#FFFF3B30</Color>
    <Color x:Key="Color.FailedRedForeground">#FFFFFFFF</Color>
    <Color x:Key="Color.Info">#FF007AFF</Color>
    <Color x:Key="Color.InfoForeground">#FFFFFFFF</Color>

    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}"/>
    <SolidColorBrush x:Key="Brush.SuccessForeground" Color="{StaticResource Color.SuccessForeground}"/>
    <SolidColorBrush x:Key="Brush.WarningYellow" Color="{StaticResource Color.WarningYellow}"/>
    <SolidColorBrush x:Key="Brush.WarningYellowForeground" Color="{StaticResource Color.WarningYellowForeground}"/>
    <SolidColorBrush x:Key="Brush.ErrorOrange" Color="{StaticResource Color.ErrorOrange}"/>
    <SolidColorBrush x:Key="Brush.ErrorOrangeForeground" Color="{StaticResource Color.ErrorOrangeForeground}"/>
    <SolidColorBrush x:Key="Brush.FailedRed" Color="{StaticResource Color.FailedRed}"/>
    <SolidColorBrush x:Key="Brush.FailedRedForeground" Color="{StaticResource Color.FailedRedForeground}"/>

    <SolidColorBrush x:Key="SidebarSelectionBrush" Color="{StaticResource PrimaryColor}" Opacity="0.10"/>

    <!-- ===== Tinted surfaces ===== -->
    <!-- System Blue flattened onto white at roughly 6% and 10%. These carry the
         only colour on an otherwise neutral screen: a table header bar and the
         header strip of a grouped panel, so a grid reads as a grid rather than as
         text floating on a card.

         Safe to tint because the DFM fixes only the state, SKU, unit-SN and Top-10
         colours (slide 40) and says nothing about table chrome - these are HIG
         surface colours, and none of them is an Audio.* key. -->
    <Color x:Key="Nova.TableHeaderColor">#FFEDF4FF</Color>
    <SolidColorBrush x:Key="Nova.TableHeaderBrush" Color="{StaticResource Nova.TableHeaderColor}"/>

    <Color x:Key="Nova.PanelHeaderColor">#FFE3EEFF</Color>
    <SolidColorBrush x:Key="Nova.PanelHeaderBrush" Color="{StaticResource Nova.PanelHeaderColor}"/>

    <!-- Hairline in the same hue, so a tinted header does not meet a grey rule. -->
    <SolidColorBrush x:Key="Nova.TableHeaderBorderBrush" Color="#FFCFE0FA"/>

    <!-- ===== Elevation ===== -->
    <!-- HandyControl's EffectShadow1/2 are pronounced drop shadows, and the
         pre-Audio screens apply them to 23 separate panels. HIG separates a
         grouped card from its background by fill, not by lifting it off the
         page, so these are softened to near-flat rather than removed - the keys
         are still referenced in a dozen views, and a missing resource would
         throw at load. Redefined here because this dictionary is merged after
         HandyControl's Theme.xaml. -->
    <DropShadowEffect x:Key="EffectShadow1"
                      BlurRadius="6" ShadowDepth="1" Direction="270"
                      Color="#FF000000" Opacity="0.04"/>
    <DropShadowEffect x:Key="EffectShadow2"
                      BlurRadius="10" ShadowDepth="2" Direction="270"
                      Color="#FF000000" Opacity="0.06"/>

</ResourceDictionary>
