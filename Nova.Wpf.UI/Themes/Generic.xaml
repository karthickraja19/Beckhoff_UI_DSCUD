<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="clr-namespace:Nova.Wpf.UI.Components">

    <!-- ================================================================== -->
    <!-- DEFAULT TEMPLATES FOR THIS ASSEMBLY'S CUSTOM CONTROLS              -->
    <!--                                                                    -->
    <!-- WPF resolves a Control's default style from Themes/Generic.xaml in -->
    <!-- the assembly that declares it, which is why this file exists       -->
    <!-- separately from Styles/*.xaml: it is found by the framework, not    -->
    <!-- merged by App.xaml. A control whose template lived only in a merged -->
    <!-- dictionary would render blank anywhere that dictionary was not      -->
    <!-- merged - including the XAML designer.                               -->
    <!--                                                                    -->
    <!-- Requires [assembly: ThemeInfo(None, SourceAssembly)], which is in   -->
    <!-- Properties/AssemblyInfo.cs.                                         -->
    <!-- ================================================================== -->

    <Style TargetType="{x:Type components:AudioIcon}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type components:AudioIcon}">
                    <!-- Uniform, never UniformToFill: the DFM glyphs are drawn on
                         their own rounded-square plate and cropping one would cut
                         that plate's corners off. -->
                    <Image Source="{TemplateBinding Source}"
                           Stretch="Uniform"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
