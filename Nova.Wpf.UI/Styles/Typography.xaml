<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ================================================================ -->
    <!-- NOVA TYPE SCALE                                                  -->
    <!--                                                                  -->
    <!-- Single source of truth for every font size in the app. Views     -->
    <!-- must reference these keys instead of literal numbers so the      -->
    <!-- whole UI can be scaled from one place (e.g. for a larger panel   -->
    <!-- PC or an operator standing further from the machine).            -->
    <!--                                                                  -->
    <!-- Deliberately SHORT. Five sizes, one per ROLE — not a decorative  -->
    <!-- ramp. Every page therefore renders body text at exactly the same -->
    <!-- size and every heading at exactly the same size; a page cannot   -->
    <!-- drift by picking a neighbouring step, because there isn't one.   -->
    <!-- If a new element does not fit a role below, it is a body or a    -->
    <!-- caption — do NOT add a step.                                     -->
    <!--                                                                  -->
    <!--   Key            px   Role                                       -->
    <!--   Caption        13   field captions, table column headers,      -->
    <!--                      IO chips, units, sub-labels                 -->
    <!--   Body           15   EVERYTHING else that is read as text:      -->
    <!--                      cells, rows, labels, buttons, inputs,       -->
    <!--                      status text, tabs. Also the app default.    -->
    <!--   Heading        17   EVERY heading: card, panel and section     -->
    <!--                      titles, dialog titles, empty-state text     -->
    <!--   Readout        22   prominent numeric values (KPI tiles, jog   -->
    <!--                      and weight readouts) — numerals, not prose  -->
    <!--   ReadoutLarge   28   the one hero readout per screen (axis      -->
    <!--                      position / speed)                           -->
    <!-- ================================================================ -->

    <!-- Aligned onto the HIG ramp in Styles/AudioTypography.xaml so a legacy
         screen and an Audio screen set the same text at the same size:
           Caption      -> Audio.FontSize.Footnote     13
           Body         -> Audio.FontSize.Subheadline  15
           Heading      -> Audio.FontSize.Headline     17
           Readout      -> Audio.FontSize.Title2       22
           ReadoutLarge -> Audio.FontSize.Title1       28
         Heading is Headline, not Title3: the legacy screens are always hosted
         INSIDE an Audio card (the Vendor pane, the Config sections), whose own
         title is already Title3 20. A card title inside that card is one step
         down, or the hosted screen out-shouts the page it sits in. -->
    <sys:Double x:Key="Nova.FontSize.Caption">13</sys:Double>
    <sys:Double x:Key="Nova.FontSize.Body">15</sys:Double>
    <sys:Double x:Key="Nova.FontSize.Heading">17</sys:Double>
    <sys:Double x:Key="Nova.FontSize.Readout">22</sys:Double>
    <sys:Double x:Key="Nova.FontSize.ReadoutLarge">28</sys:Double>

    <!-- App-wide inherited default, set on the shell window. Control.FontSize is
         TextElement.FontSize, so it flows down the whole tree to any element that
         does not set its own size. Kept equal to Body on purpose. -->
    <sys:Double x:Key="Nova.FontSize.Base">15</sys:Double>

    <!-- ================================================================ -->
    <!-- TEXT ROLE STYLES                                                 -->
    <!--                                                                  -->
    <!-- Prefer these over setting FontSize directly: a view that says    -->
    <!-- Style="{StaticResource Nova.SectionTitle}" cannot drift, whereas -->
    <!-- one that says FontSize="..." eventually will.                    -->
    <!-- ================================================================ -->

    <!-- The single heading style. Card titles, panel titles, page titles and
         section titles are all THE SAME SIZE — hierarchy comes from position
         and weight, not from a different number on every page. -->
    <Style x:Key="Nova.PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Nova.FontSize.Heading}"/>
        <!-- SemiBold, as Audio.Headline / Audio.Title3: Bold made every legacy
             card title heavier than the page title around it. -->
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Alias of Nova.PageTitle: a titled region inside a page reads at the
         same size, so both keys resolve to one appearance. -->
    <Style x:Key="Nova.PanelTitle" TargetType="TextBlock" BasedOn="{StaticResource Nova.PageTitle}"/>

    <!-- Muted one-line explanation directly under a heading. -->
    <Style x:Key="Nova.PageSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Nova.FontSize.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Body copy. -->
    <Style x:Key="Nova.BodyText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Nova.FontSize.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Centered empty-state / "not yet implemented" message. -->
    <Style x:Key="Nova.EmptyState" TargetType="TextBlock" BasedOn="{StaticResource Nova.PageTitle}">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="None"/>
    </Style>

    <!-- Prominent numeric readout (KPI tiles, jog/weight values). -->
    <Style x:Key="Nova.DisplayValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Nova.FontSize.Readout}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

</ResourceDictionary>
