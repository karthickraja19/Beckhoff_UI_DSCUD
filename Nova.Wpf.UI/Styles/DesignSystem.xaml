<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">

    <!-- ================================================================ -->
    <!-- NOVA DESIGN SYSTEM                                               -->
    <!-- Single source of truth for typography, table, card and button    -->
    <!-- metrics shared by every page. Views must base their local        -->
    <!-- styles on these (BasedOn) instead of redefining values, so the   -->
    <!-- whole app stays visually consistent.                             -->
    <!--                                                                  -->
    <!-- Font sizes come from Styles/Typography.xaml — never a literal.   -->
    <!--                                                                  -->
    <!--                                                                  -->
    <!-- BUTTON vs LABEL                                                  -->
    <!-- The two must never be confusable on the machine floor, so they   -->
    <!-- use opposite visual treatments. The single strongest cue is the  -->
    <!-- BLACK BORDER: it belongs to buttons and to nothing else.         -->
    <!--                                                                  -->
    <!--   BUTTON (actionable)   raised: subtle fill that steps away from -->
    <!--                         the page, 1px BLACK border, 6px radius,  -->
    <!--                         SemiBold label, drop shadow, Hand        -->
    <!--                         cursor, lift on hover, sink on press,    -->
    <!--                         accent ring on keyboard focus, faded     -->
    <!--                         and flat when disabled.                  -->
    <!--                                                                  -->
    <!--   LABEL / CHIP (data)   flat: NO border of any colour, no        -->
    <!--                         shadow, no lift, Arrow cursor, regular   -->
    <!--                         weight, muted foreground. Never a filled -->
    <!--                         accent, never an outline.                -->
    <!--                                                                  -->
    <!-- Container borders (cards, table headers, input fields) use the   -->
    <!-- palette's grey BorderBrush — deliberately NOT black, so black    -->
    <!-- keeps meaning exactly one thing: you can press this.             -->
    <!--                                                                  -->
    <!-- Anything showing a value uses Nova.Chip / Nova.FieldLabel /      -->
    <!-- Nova.CellText. Anything you can press uses a Nova.Button* style. -->
    <!-- ================================================================ -->

    <!-- ========================= -->
    <!-- METRICS                   -->
    <!-- ========================= -->

    <!-- HIG metrics, matching Styles/AudioTokens.xaml. 44 is the guideline's
         minimum hit target and the size the Audio controls already use, so a
         button on a legacy screen is now the same size as one on an Audio page. -->
    <sys:Double x:Key="Nova.Button.Height">44</sys:Double>
    <sys:Double x:Key="Nova.Button.HeightCompact">32</sys:Double>
    <sys:Double x:Key="Nova.Button.MinWidth">96</sys:Double>
    <!-- Audio.Radius.Control. -->
    <CornerRadius x:Key="Nova.Button.CornerRadius">10</CornerRadius>
    <!-- Inner radius of the focus ring: outer radius minus its 2px inset. -->
    <CornerRadius x:Key="Nova.Button.FocusCornerRadius">8</CornerRadius>
    <!-- HIG buttons are a filled surface with no outline. The key stays because
         templates bind to it; zero thickness is what removes the hard black box
         these buttons used to draw. -->
    <Thickness x:Key="Nova.Button.BorderThickness">0</Thickness>
    <Thickness x:Key="Nova.Button.Padding">16,0</Thickness>
    <sys:Double x:Key="Nova.Row.Height">44</sys:Double>

    <!-- ========================= -->
    <!-- TABLES                    -->
    <!-- ========================= -->

    <!-- Column header text: clearly heavier and darker than data rows. -->
    <Style x:Key="Nova.TableHeaderText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Nova.FontSize.Caption}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="12,0"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- Column header bar container. Tinted rather than grey: the page behind a
         card is now grouped grey too, so a grey header bar on a white card had
         nothing to separate it from either. -->
    <Style x:Key="Nova.TableHeaderBar" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Nova.TableHeaderBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Nova.TableHeaderBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="CornerRadius" Value="8,8,0,0"/>
    </Style>

    <!-- Data cell text. -->
    <Style x:Key="Nova.CellText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Nova.FontSize.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="12,0"/>
    </Style>

    <!-- Data cell text, monospaced (ids, timestamps, numeric readouts). -->
    <Style x:Key="Nova.CellMono" TargetType="TextBlock" BasedOn="{StaticResource Nova.CellText}">
        <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, monospace"/>
    </Style>

    <!-- Flat in-row editor: plain text until Edit mode makes it a field. -->
    <Style x:Key="Nova.CellBox" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Margin" Value="8,0"/>
        <Setter Property="Padding" Value="4,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="{DynamicResource Nova.FontSize.Body}"/>
        <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, monospace"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Style.Triggers>
            <Trigger Property="IsReadOnly" Value="False">
                <Setter Property="Background" Value="{DynamicResource RegionBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Universal dynamic table value cell: centered monospace, read-only by default until Edit mode. -->
    <Style x:Key="ValueCell" TargetType="TextBox" BasedOn="{StaticResource Nova.CellBox}">
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style x:Key="CellBox" TargetType="TextBox" BasedOn="{StaticResource ValueCell}"/>

    <!-- Column header gripper style for DataGrid resize handles -->
    <Style x:Key="Nova.DataGridColumnHeaderGripper" TargetType="Thumb">
        <Setter Property="Width" Value="8"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="SizeWE"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- DataGrid column header (assign via ColumnHeaderStyle). -->
    <Style x:Key="Nova.DataGridColumnHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource SecondaryRegionBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource Nova.FontSize.Caption}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Grid>
                        <Border x:Name="HeaderBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Margin="0,0,1,1"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                        <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left" Style="{StaticResource Nova.DataGridColumnHeaderGripper}"/>
                        <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Style="{StaticResource Nova.DataGridColumnHeaderGripper}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Compact DataGrid Row Style -->
    <Style x:Key="Nova.DataGridRow" TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SecondaryRegionBrush}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource SecondaryRegionBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Compact DataGrid Cell Style -->
    <Style x:Key="Nova.DataGridCell" TargetType="DataGridCell">
        <Setter Property="Padding" Value="4,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Compact DataGrid Master Style -->
    <Style x:Key="Nova.DataGrid" TargetType="DataGrid">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="RowHeight" Value="28"/>
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource Nova.DataGridColumnHeader}"/>
        <Setter Property="RowStyle" Value="{StaticResource Nova.DataGridRow}"/>
        <Setter Property="CellStyle" Value="{StaticResource Nova.DataGridCell}"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="FontSize" Value="{DynamicResource Nova.FontSize.Body}"/>
    </Style>

    <!-- ========================= -->
    <!-- TYPOGRAPHY                -->
    <!-- ========================= -->

    <!-- Card / section title. -->
    <Style x:Key="Nova.SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Nova.FontSize.Heading}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Small caption above a form field. Deliberately flat, transparent, -->
    <!-- borderless and REGULAR weight (bold belongs to headings and button -->
    <!-- labels) so it can never be mistaken for a pressable control. -->
    <Style x:Key="Nova.FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Nova.FontSize.Caption}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
        <Setter Property="Margin" Value="0,0,0,5"/>
    </Style>

    <!-- The value that belongs to a Nova.FieldLabel. Carries the weight of the
         pair, because the value is the thing the operator is reading. -->
    <Style x:Key="Nova.FieldValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Nova.FontSize.Body}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ========================= -->
    <!-- CONTAINERS                -->
    <!-- ========================= -->

    <!-- Standard content card. -->
    <!-- Matches Audio.Card: 12px radius, no outline, no drop shadow. HIG
         separates a card from its background by fill alone - the white card sits
         on the grouped grey. The border and shadow are what made these panels
         read as boxed-in next to an Audio card. -->
    <Style x:Key="Nova.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource RegionBrush}"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SecondaryBorderBrush}"/>
        <!-- Hairline, not the old 1px mid-grey box. Enough to hold the card's edge
             where two cards sit side by side on the grouped grey. -->
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <!-- ================================================================ -->
    <!-- ICONS                                                            -->
    <!--                                                                  -->
    <!-- Lucide ships one weight, and the icon pack bakes that weight      -->
    <!-- into a pre-stroked filled outline — there is no stroke-width      -->
    <!-- property to turn up. To get a heavier glyph we retemplate the     -->
    <!-- icon so its Path is stroked in the foreground brush as well as    -->
    <!-- filled; the stroke widens every limb by half the thickness on     -->
    <!-- each side.                                                        -->
    <!--                                                                  -->
    <!-- The Path is stretched, so StrokeThickness is in rendered pixels   -->
    <!-- (not the icon's 1000-unit design grid) and therefore reads the    -->
    <!-- same on a 15px table icon and a 24px toolbar icon. Round caps and -->
    <!-- joins keep Lucide's rounded terminals.                            -->
    <!--                                                                  -->
    <!-- Keyed, not implicit: the stock template also carries Flip /       -->
    <!-- RotationAngle / Spin, which this one drops. Opt in per icon.      -->
    <!-- ================================================================ -->

    <sys:Double x:Key="Nova.Icon.StrokeThickness">1</sys:Double>

    <Style x:Key="Nova.IconBold" TargetType="iconPacks:PackIconLucide">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="iconPacks:PackIconLucide">
                    <!-- PART_InnerGrid is mandatory: PackIconControlBase.OnApplyTemplate
                         resolves it and only then pushes the Kind's geometry into Data.
                         Without it the icon renders empty. -->
                    <Grid x:Name="PART_InnerGrid" SnapsToDevicePixels="False" UseLayoutRounding="False">
                        <Path Data="{Binding Data, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                              Fill="{TemplateBinding Foreground}"
                              Stroke="{TemplateBinding Foreground}"
                              StrokeThickness="{DynamicResource Nova.Icon.StrokeThickness}"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Stretch="Uniform"
                              SnapsToDevicePixels="False"
                              UseLayoutRounding="False">
                            <!-- Lucide geometry is authored Y-up; the stock template
                                 flips it the same way. Without this the glyphs render
                                 upside down. -->
                            <Path.LayoutTransform>
                                <ScaleTransform ScaleY="-1"/>
                            </Path.LayoutTransform>
                        </Path>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================= -->
    <!-- READ-ONLY CHIPS (LABELS)  -->
    <!-- ========================= -->

    <!-- Recessed patch holding a read-only value (IO address, mode, unit).
         BORDERLESS on purpose: an outline is the button signal, so a chip groups
         its value with a flat recessed fill instead. No shadow, no hover, no
         lift, Arrow cursor — this is data, not an action. -->
    <Style x:Key="Nova.Chip" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SecondaryRegionBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="Padding" Value="7,2"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- Text inside a Nova.Chip. Regular weight: a chip is read, not pressed. -->
    <Style x:Key="Nova.ChipText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Nova.FontSize.Caption}"/>
        <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, monospace"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Free-standing label with NO surface at all: the strictest label form.
         Use where a value sits directly on a card next to buttons. -->
    <Style x:Key="Nova.LabelText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Nova.FontSize.Body}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ================================================================ -->
    <!-- BUTTONS                                                          -->
    <!--                                                                  -->
    <!-- One shared template drives every variant; a variant only sets     -->
    <!-- Background / Foreground. The template owns the affordance         -->
    <!-- (black border, radius, padding, shadow, hover lift, press sink,   -->
    <!-- focus ring, disabled fade) so no two buttons in the app can drift -->
    <!-- apart, and so no static label can accidentally acquire the look.  -->
    <!--                                                                  -->
    <!-- Hover and press wash a translucent shade OVER the fill instead of -->
    <!-- fading the whole control: the black outline and the label keep    -->
    <!-- full contrast in every state, which is what makes the button      -->
    <!-- readable at arm's length on the machine.                          -->
    <!-- ================================================================ -->

    <ControlTemplate x:Key="Nova.ButtonTemplate" TargetType="ButtonBase">
        <Border x:Name="Bd"
                CornerRadius="{DynamicResource Nova.Button.CornerRadius}"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                Effect="{DynamicResource EffectShadow1}"
                SnapsToDevicePixels="True">
            <!-- Shade and focus ring are siblings of the content, not wrappers,
                 so turning them on never reflows what the button contains. -->
            <Grid>
                <Border x:Name="Shade"
                        CornerRadius="{DynamicResource Nova.Button.CornerRadius}"
                        Background="{DynamicResource Nova.Button.ShadeBrush}"
                        Opacity="0"/>
                <Border x:Name="FocusRing"
                        CornerRadius="{DynamicResource Nova.Button.FocusCornerRadius}"
                        Margin="2"
                        BorderBrush="{DynamicResource PrimaryBrush}"
                        BorderThickness="0"/>
                <ContentPresenter x:Name="Content"
                                  Margin="{TemplateBinding Padding}"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  RecognizesAccessKey="True"
                                  SnapsToDevicePixels="True"/>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <!-- HOVER: shade the fill and lift 1px off the surface. -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Shade" Property="Opacity" Value="0.10"/>
                <Setter TargetName="Bd" Property="Effect" Value="{DynamicResource EffectShadow2}"/>
                <Setter TargetName="Bd" Property="RenderTransform">
                    <Setter.Value>
                        <TranslateTransform Y="-1"/>
                    </Setter.Value>
                </Setter>
            </Trigger>
            <!-- PRESS: shade harder, sink into the surface, drop the shadow. -->
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Shade" Property="Opacity" Value="0.22"/>
                <Setter TargetName="Bd" Property="Effect" Value="{x:Null}"/>
                <Setter TargetName="Bd" Property="RenderTransform">
                    <Setter.Value>
                        <TranslateTransform Y="1"/>
                    </Setter.Value>
                </Setter>
            </Trigger>
            <!-- KEYBOARD FOCUS: accent ring drawn INSIDE the black border, so the
                 outline stays put and the content does not shift by a pixel. -->
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="FocusRing" Property="BorderThickness" Value="2"/>
            </Trigger>
            <!-- DISABLED: flat and faded — reads as "not an action right now". -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.40"/>
                <Setter TargetName="Bd" Property="Effect" Value="{x:Null}"/>
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Shared metrics for every Nova button. Not used directly — derive.
         The black border lives HERE, not on the variants, so a variant can only
         change colour, never drop the affordance. -->
    <Style x:Key="Nova.ButtonBase" TargetType="Button">
        <Setter Property="Height" Value="{DynamicResource Nova.Button.Height}"/>
        <Setter Property="MinWidth" Value="{DynamicResource Nova.Button.MinWidth}"/>
        <Setter Property="Padding" Value="{DynamicResource Nova.Button.Padding}"/>
        <Setter Property="FontSize" Value="{DynamicResource Nova.FontSize.Body}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="{DynamicResource Nova.Button.BorderThickness}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Nova.Button.BorderBrush}"/>
        <Setter Property="Background" Value="{DynamicResource Nova.Button.SurfaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template" Value="{StaticResource Nova.ButtonTemplate}"/>
    </Style>

    <!-- Not a Button? The template targets ButtonBase, so a ToggleButton /
         RepeatButton / command RadioButton gets the identical affordance by
         setting Template to Nova.ButtonTemplate and taking the three tokens
         (Nova.Button.BorderBrush / .BorderThickness / .SurfaceBrush). A control
         that keeps its own template — the nav pill and the mode chip do, because
         they draw extra parts — must at least take those three tokens so its
         outline matches. -->

    <!-- PRIMARY: the one recommended action in a view. Filled accent. -->
    <Style x:Key="Nova.ButtonPrimary" TargetType="Button" BasedOn="{StaticResource Nova.ButtonBase}">
        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ReverseTextBrush}"/>
    </Style>

    <!-- SECONDARY: the default clickable. Neutral button surface — a step away -->
    <!-- from the card it sits on — plus the black outline, so it reads as -->
    <!-- raised next to a flat label. -->
    <Style x:Key="Nova.ButtonSecondary" TargetType="Button" BasedOn="{StaticResource Nova.ButtonBase}">
        <Setter Property="Background" Value="{DynamicResource Nova.Button.SurfaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
    </Style>

    <Style x:Key="Nova.ButtonInfo" TargetType="Button" BasedOn="{StaticResource Nova.ButtonBase}">
        <Setter Property="Background" Value="{DynamicResource InfoBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ReverseTextBrush}"/>
    </Style>

    <Style x:Key="Nova.ButtonSuccess" TargetType="Button" BasedOn="{StaticResource Nova.ButtonBase}">
        <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ReverseTextBrush}"/>
    </Style>

    <Style x:Key="Nova.ButtonWarning" TargetType="Button" BasedOn="{StaticResource Nova.ButtonBase}">
        <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ReverseTextBrush}"/>
    </Style>

    <Style x:Key="Nova.ButtonDanger" TargetType="Button" BasedOn="{StaticResource Nova.ButtonBase}">
        <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ReverseTextBrush}"/>
    </Style>

    <!-- OUTLINE: secondary action. Same black outline and neutral fill as -->
    <!-- Secondary, only tighter. Kept as its own key because views ask for it -->
    <!-- by name; there is deliberately no borderless variant to fall back to. -->
    <Style x:Key="Nova.ButtonOutline" TargetType="Button" BasedOn="{StaticResource Nova.ButtonBase}">
        <Setter Property="Background" Value="{DynamicResource Nova.Button.SurfaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="Padding" Value="14,0"/>
    </Style>

    <!-- Outline button whose LABEL is tinted with the theme accent. The border -->
    <!-- stays black: colour signals which action, the outline signals that it -->
    <!-- is an action at all. -->
    <Style x:Key="Nova.ButtonAccentOutline" TargetType="Button" BasedOn="{StaticResource Nova.ButtonOutline}">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
    </Style>

    <!-- GHOST: lowest-emphasis action (toolbar icons, inline links). Was flat -->
    <!-- and borderless, which is exactly the look a label has — it now carries -->
    <!-- the standard outline and only drops the fill to the card colour, so a -->
    <!-- toolbar icon still reads as pressable without shouting. -->
    <Style x:Key="Nova.ButtonGhost" TargetType="Button" BasedOn="{StaticResource Nova.ButtonBase}">
        <Setter Property="Background" Value="{DynamicResource RegionBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
    </Style>

    <!-- Danger action of the lowest emphasis (e.g. manual reset): danger label -->
    <!-- on the neutral button surface, black outline like everything else. -->
    <Style x:Key="Nova.ButtonDangerLink" TargetType="Button" BasedOn="{StaticResource Nova.ButtonGhost}">
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
    </Style>

    <!-- Compact variant for in-row actions in dense tables. Only the box shrinks —
         the label stays at Body like every other button, so text does not change
         size from one page to the next. -->
    <Style x:Key="Nova.ButtonCompact" TargetType="Button" BasedOn="{StaticResource Nova.ButtonPrimary}">
        <Setter Property="Height" Value="{DynamicResource Nova.Button.HeightCompact}"/>
        <Setter Property="MinWidth" Value="80"/>
        <Setter Property="Padding" Value="10,0"/>
    </Style>

    <!-- Small square outline button (pager arrows, compact icon actions). -->
    <Style x:Key="Nova.ButtonIconSmall" TargetType="Button" BasedOn="{StaticResource Nova.ButtonOutline}">
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="MinWidth" Value="34"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <!-- Toolbar icon button, no label (36px hit target). Sits on the toolbar
         surface, so it takes the neutral button fill rather than the card one. -->
    <Style x:Key="Nova.ButtonIconToolbar" TargetType="Button" BasedOn="{StaticResource Nova.ButtonSecondary}">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="MinWidth" Value="36"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <!-- Icon action that lives INSIDE another control or a card header strip
         (clear-search X, inline refresh, inline filter). Smallest outlined form
         in the system — small enough to sit in a 34px field, still outlined so
         it does not read as a decorative glyph like the ellipsis next to it. -->
    <Style x:Key="Nova.ButtonIconInline" TargetType="Button" BasedOn="{StaticResource Nova.ButtonSecondary}">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="MinWidth" Value="24"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <!-- Large square machine-control button (Reset / Start / Pause / Stop).
         Colour comes from the caller (SuccessBrush, DangerBrush, …); the size
         and the outline come from here. -->
    <Style x:Key="Nova.ButtonIconLarge" TargetType="Button" BasedOn="{StaticResource Nova.ButtonBase}">
        <Setter Property="Width" Value="56"/>
        <Setter Property="Height" Value="56"/>
        <Setter Property="MinWidth" Value="56"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource ReverseTextBrush}"/>
    </Style>

</ResourceDictionary>
